          <ip family='ipv4' address='192.168.{subnet}.1' prefix='24'>
            <dhcp>
              <range start='192.168.{subnet}.128' end='192.168.{subnet}.254'/>{dhcp_hosts}
            </dhcp>
          </ip>
          <dnsmasq:options>
            <dnsmasq:option value="address=/api.{domain}/{api}"/>
            <dnsmasq:option value="address=/api-int.{domain}/{api}"/>
            <dnsmasq:option value="address=/.apps.{domain}/{ingress}"/>
