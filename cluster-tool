def _remote_shell_path(path):
    """Build a remote redirect target that still expands a leading tilde."""
    if path == "~" or path.startswith("~/"):
        return '"$HOME"' + shlex.quote(path[1:])
    return shlex.quote(path)


class ExecutionEnv:
    def __init__(self, *, host, host_ip):
        self.host = host
        self.host_ip = host_ip
        self.is_local = (host == "local")

    def run(self, cmd, *, check=True):
        if self.is_local:
            r = subprocess.run(cmd, shell=True, capture_output=True, text=True)
        else:
            r = subprocess.run(
                ["ssh"] + SSH_OPTS + [self.host, cmd],
                capture_output=True, text=True,
            )
        if check and r.returncode != 0:
            sys.exit(f"Command failed (exit {r.returncode}): {cmd}\n{r.stderr.strip()}")
        return r

    def run_vm(self, vm_ip, cmd, *, check=True, identity=None):
        """SSH to a guest, quoting the identity path and the remote command."""
        argv = ["ssh", *SSH_OPTS]
        if identity:
            argv.extend(["-i", identity])
        argv.extend([f"core@{vm_ip}", cmd])
        if self.is_local:
            r = subprocess.run(argv, capture_output=True, text=True)
            if check and r.returncode != 0:
                sys.exit(f"SSH command failed (exit {r.returncode}): {cmd}\n{r.stderr.strip()}")
            return r
        return self.run(shlex.join(argv), check=check)

    def copy_from(self, remote_path, local_path):
        if self.is_local:
            subprocess.run(["cp", str(remote_path), str(local_path)], check=True)
        else:
            subprocess.run(
                ["scp"] + SSH_OPTS + [f"{self.host}:{remote_path}", str(local_path)],
                capture_output=True, text=True, check=True,
            )

    def write_file(self, path, content):
        if self.is_local:
            resolved = Path(os.path.expanduser(path))
            resolved.parent.mkdir(parents=True, exist_ok=True)
            _restore_ownership(resolved.parent)
            resolved.write_text(content)
            _restore_ownership(resolved)
        else:
            encoded = base64.b64encode(content.encode()).decode()
            target = _remote_shell_path(path)
            if path == "~" or path.startswith("~/"):
                parent = '"$HOME"' + shlex.quote(os.path.dirname(path[1:]) or "/")
            else:
                parent = shlex.quote(os.path.dirname(path) or ".")
            remote = f"mkdir -p {parent} && base64 -d > {target}"
            r = subprocess.run(
                ["ssh"] + SSH_OPTS + [self.host, remote],
                input=encoded, capture_output=True, text=True,
            )
            if r.returncode != 0:
                sys.exit(f"Failed to write {path}: {r.stderr.strip()}")


