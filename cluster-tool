def compact_node_ips_ready(rows, nodes):
    """Return whether every clone node object shows its clone address."""
    expected = {node["role"]: node["ip"] for node in nodes}
    found = {row["name"]: row.get("ip") for row in rows}
    return all(found.get(role) == ip for role, ip in expected.items())


def compact_mcd_pod_address_rows(raw):
    """Read host-network machine-config-daemon pod addresses and readiness."""
    doc = json.loads(raw)
    rows = {}
    for pod in doc.get("items") or []:
        metadata = pod.get("metadata") or {}
        name = metadata.get("name") or ""
        if not name.startswith("machine-config-daemon-"):
            continue
        role = (pod.get("spec") or {}).get("nodeName") or ""
        if not role:
            continue
        statuses = (pod.get("status") or {}).get("containerStatuses") or []
        rows[role] = {
            "name": name,
            "uid": metadata.get("uid") or "",
            "ip": (pod.get("status") or {}).get("podIP") or "",
            "ready": bool(statuses) and all(item.get("ready") is True for item in statuses),
        }
    return rows


def parse_etcd_pods(text):
    """Count etcd static pods whose containers are all running."""
    ready = 0
    for line in text.splitlines():
        parts = line.split()
        if len(parts) < 3 or not parts[0].startswith("etcd-master-"):
            continue
        have, _, want = parts[1].partition("/")
        if parts[2] == "Running" and have == want and have not in ("", "0"):
            ready += 1
    return ready


def compact_identity_configmaps(oc):
    """List identity ConfigMaps that still need compact address rewrites."""
    found = [list(item) for item in HEAL_IDENTITY_CONFIGMAPS]

    def names(item):
        namespace, prefix = item
        raw = env.run(f"{oc} get cm -n {shlex.quote(namespace)} -o name", check=False)
        matched = []
        for line in (raw.stdout or "").splitlines():
            name = line.strip().split("/")[-1]
            if name.startswith(prefix):
                matched.append([namespace, name])
        return matched

    for group in _in_parallel_results(list(HEAL_CONFIGMAP_PREFIXES), names):
        found.extend(group)
    return found


def compact_release_keepalived_script():
