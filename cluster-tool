        set +e
        sudo rm -f /run/nodeip-configuration/remote-worker
        sudo systemctl stop chrony-wait.service || true
        sudo systemctl mask chrony-wait.service || true
        sudo systemctl daemon-reload
        sudo timeout 90 systemctl restart nodeip-configuration.service
        exit 0
        """)


def compact_reload_apiserver_script():
    """Build the script that reloads the API server after a certificate change."""
    return textwrap.dedent("""\
        set +e
        sudo crictl pods --name kube-apiserver -q | xargs -r sudo crictl stopp
        exit 0
        """)


def compact_apiserver_host_ip_script(expected_ip):
    """Refresh a static kube-apiserver manifest that retains a source-node IP."""
    expected = str(ipaddress.ip_address(expected_ip))
    if not isinstance(ipaddress.ip_address(expected), ipaddress.IPv4Address):
        raise ValueError("compact kube-apiserver host IP must be IPv4")
    script = textwrap.dedent("""\
        set -euo pipefail
        expected=@@EXPECTED@@
        manifest=/etc/kubernetes/manifests/kube-apiserver-pod.yaml
        deadline=$((SECONDS + 240))
        manifest_updated=0
        while (( SECONDS < deadline )); do
          for id in $(sudo crictl ps -q --name kube-apiserver 2>/dev/null || true); do
            host_ip=$(sudo crictl inspect "$id" 2>/dev/null | python3 -c 'import json,sys; d=json.load(sys.stdin); p=((d.get("info") or {}).get("runtimeSpec") or {}).get("process") or {}; print(next((v.split("=", 1)[1] for v in p.get("env") or [] if v.startswith("HOST_IP=")), ""))' || true)
            [ -n "$host_ip" ] || continue
            if [ "$host_ip" = "$expected" ]; then
              if curl --silent --show-error --fail --insecure --connect-timeout 2 --max-time 4 \\
                  --output /dev/null https://127.0.0.1:6443/readyz; then
                echo "kube-apiserver HOST_IP=$host_ip is ready"
                exit 0
              fi
              continue
            fi
            if [ "$manifest_updated" -eq 0 ]; then
              echo "updating kube-apiserver static pod HOST_IP from $host_ip to $expected"
              sudo python3 -c 'import json,os,pathlib,stat,sys; p=pathlib.Path(sys.argv[1]); s=p.stat(); d=json.loads(p.read_text()); c=next(x for x in d["spec"]["containers"] if x.get("name")=="kube-apiserver"); e=next(x for x in c["env"] if x.get("name")=="HOST_IP"); e.pop("valueFrom",None); e["value"]=sys.argv[2]; t=p.with_name(p.name+".cluster-tool-tmp"); t.write_text(json.dumps(d,separators=(",",":"))+"\\n"); os.chown(t,s.st_uid,s.st_gid); os.chmod(t,stat.S_IMODE(s.st_mode)); os.replace(t,p)' "$manifest" "$expected"
              sudo restorecon -F "$manifest"
              manifest_updated=1
            fi
          done
          sleep 2
        done
        echo "kube-apiserver did not become ready with HOST_IP=$expected"
        exit 1
        """)
    return script.replace("@@EXPECTED@@", shlex.quote(expected))


def compact_start_recert_node_script():
    """Start kubelet on the Recert node after Recert stopped it."""
    return textwrap.dedent("""\
        set +e
        sudo systemctl start crio
        sudo systemctl start kubelet
        exit 0
        """)


def compact_cert_controller_lease():
    """Return the leader lease that blocks a restarted API cert controller."""
    return "openshift-kube-apiserver", "cert-regeneration-controller-lock"


def compact_restart_cert_controller_command():
    # The cert controller reads the internal API name once, when its process
    # starts. A later crio restart does not replace that process, so it keeps
    # reissuing the source certificate and kubelet can never trust the clone API.
    """Build the command that restarts the API certificate controller."""
    return (
        "sudo crictl ps --name kube-apiserver-cert-regeneration-controller -q "
        "| xargs -r sudo crictl stop"
    )


def presented_san_matches(san_text, hostname):
    """Return whether a presented certificate SAN contains the expected hostname."""
    return bool(hostname) and hostname in (san_text or "")


def _secret_hostnames(oc, name):
    """Read hostnames recorded on a serving-certificate secret."""
    raw = env.run(
        f"{oc} get secret {shlex.quote(name)} -n openshift-kube-apiserver "
        "-o jsonpath='{.metadata.annotations.auth\\.openshift\\.io/certificate-hostnames}'",
        check=False)
    return (raw.stdout or "").strip()


def _presented_san(ip, servername):
    """Read the subject alternative names presented by the API server."""
    raw = env.run(
        "echo | openssl s_client -connect "
        f"{shlex.quote(ip + ':6443')} -servername {shlex.quote(servername)} 2>/dev/null "
        "| openssl x509 -noout -ext subjectAltName",
        check=False)
    return raw.stdout or ""


def _certificate_file_has_san(path, hostname):
    """Check one certificate file for a hostname without printing its key."""
    result = env.run(
        f"openssl x509 -in {shlex.quote(path)} -noout -ext subjectAltName",
        check=False)
    return result.returncode == 0 and hostname in (result.stdout or "")


def _push_lb_cert(identity, nodes, work, secret):
    """Copy a load-balancer certificate onto each compact node."""
    src = f"{work}/lb-{secret}"
    for node in nodes:
        env.run(
            "scp " + " ".join(SSH_OPTS) + f" -i {shlex.quote(identity)} "
            f"{shlex.quote(src + '/tls.crt')} core@{node['ip']}:/var/tmp/{secret}.crt")
        env.run(
            "scp " + " ".join(SSH_OPTS) + f" -i {shlex.quote(identity)} "
            f"{shlex.quote(src + '/tls.key')} core@{node['ip']}:/var/tmp/{secret}.key")
        dest = f"/etc/kubernetes/static-pod-resources/kube-apiserver-certs/secrets/{secret}"
        _vm(node["ip"], textwrap.dedent(f"""\
            set -euo pipefail
            sudo install -o root -g root -m 600 /var/tmp/{secret}.crt {dest}/tls.crt
            sudo install -o root -g root -m 600 /var/tmp/{secret}.key {dest}/tls.key
            rm -f /var/tmp/{secret}.crt /var/tmp/{secret}.key
            """), identity)


def _install_lb_serving_cert(oc, work, secret, hostname, api_ip, signer):
    """Install a signed load-balancer serving certificate into the cluster."""
    out = f"{work}/lb-{secret}"
    env.write_file(f"{work}/sign-{secret}.sh", compact_lb_cert_script(hostname, api_ip, signer, out))
    env.run(f"bash {shlex.quote(work + '/sign-' + secret + '.sh')}")
    script = textwrap.dedent(f"""\
        set -euo pipefail
        cd {out}
        python3 - << 'PY'
        import base64, json, os, pathlib
        patch = {{
            "data": {{
                "tls.crt": base64.b64encode(pathlib.Path("tls.crt").read_bytes()).decode(),
                "tls.key": base64.b64encode(pathlib.Path("tls.key").read_bytes()).decode(),
            }},
            "metadata": {{"annotations": {{"auth.openshift.io/certificate-hostnames": {hostname!r}}}}},
        }}
        pathlib.Path("patch.json").write_text(json.dumps(patch))
        os.chmod("patch.json", 0o600)
        PY
        {oc} patch secret {shlex.quote(secret)} -n openshift-kube-apiserver --type=merge --patch-file {shlex.quote(out + '/patch.json')}
        rm -f patch.json
        """)
    env.write_file(f"{work}/install-{secret}.sh", script)
    env.run(f"bash {shlex.quote(work + '/install-' + secret + '.sh')}")


def _ensure_api_certificates(oc, work, domain, api_ip, nodes, identity):
    """Sign and install the clone API serving certificates."""
    wanted = {
        "internal-loadbalancer-serving-certkey": f"api-int.{domain}",
        "external-loadbalancer-serving-certkey": f"api.{domain}",
    }
    # Secret annotations can already name the clone while an interrupted copy
    # left one or more nodes with the source certificate. Validate the actual
    # certificate, then always distribute the authoritative secret to every node.
    secret_certs_ok = {}
    for secret, hostname in wanted.items():
        cert_dir = f"{work}/lb-{secret}"
        env.run(f"mkdir -p {shlex.quote(cert_dir)} && chmod 700 {shlex.quote(cert_dir)}")
        check_cert = f"{cert_dir}/secret-check.crt"
        _extract_secret(oc, "openshift-kube-apiserver", secret, "tls.crt", check_cert)
        secret_certs_ok[secret] = (
            hostname in _secret_hostnames(oc, secret)
            and _certificate_file_has_san(check_cert, hostname))

    if not all(secret_certs_ok.values()):
        _clone_log(work, "signing API serving certificates with the load balancer signer")
        signer = f"{work}/lb-signer"
        env.run(f"mkdir -p {shlex.quote(signer)} && chmod 700 {shlex.quote(signer)}")
        _extract_secret(oc, "openshift-kube-apiserver-operator", "loadbalancer-serving-signer", "tls.crt", f"{signer}/tls.crt")
        _extract_secret(oc, "openshift-kube-apiserver-operator", "loadbalancer-serving-signer", "tls.key", f"{signer}/tls.key")
        for secret, hostname in wanted.items():
            _install_lb_serving_cert(oc, work, secret, hostname, api_ip, signer)

    for secret, hostname in wanted.items():
        cert_dir = f"{work}/lb-{secret}"
        cert_path = f"{cert_dir}/tls.crt"
        key_path = f"{cert_dir}/tls.key"
        if secret_certs_ok[secret]:
            _extract_secret(oc, "openshift-kube-apiserver", secret, "tls.crt", cert_path)
            _extract_secret(oc, "openshift-kube-apiserver", secret, "tls.key", key_path)
        # When signing was needed, _install_lb_serving_cert staged the fresh pair.
        if not _certificate_file_has_san(cert_path, hostname):
            sys.exit(f"The staged API certificate is missing {hostname}; log: {work}/clone.log")
        _push_lb_cert(identity, nodes, work, secret)

    def node_has_clone_certs(node):
        return all(
            presented_san_matches(_presented_san(node["ip"], hostname), hostname)
            for hostname in wanted.values())

    needs_reload = [node for node in nodes if not node_has_clone_certs(node)]
    if needs_reload:
        roles = ",".join(node["role"] for node in needs_reload)
        _clone_log(work, f"reload API static pods once to load clone certificates on {roles}")
        _in_parallel(
            needs_reload,
            lambda node: _vm(node["ip"], compact_reload_apiserver_script(), identity, check=False),
        )
        deadline = time.monotonic() + 90
        while time.monotonic() < deadline:
            ready = _in_parallel_results(needs_reload, node_has_clone_certs)
            if all(ready):
                break
            time.sleep(5)
        else:
            missing = [node["role"] for node, ready in zip(needs_reload, ready) if not ready]
            sys.exit(
                "API servers did not load clone serving certificates on "
                f"{','.join(missing)}. Kubelets cannot trust the API. Log: {work}/clone.log")
    _clone_log(work, "API certificates present for clone names on all nodes")


def _refresh_internal_api_certificate(oc, work, domain, api_ip, nodes, identity):
    """Refresh the internal API certificate before kubelets need the clone API."""
    hostname = f"api-int.{domain}"
    secret = "internal-loadbalancer-serving-certkey"
    cert_check = f"{work}/internal-api-serving-cert-check.crt"

    def secret_has_clone_cert():
        extracted = env.run(
            f"rm -f {shlex.quote(cert_check)} && "
            f"{oc} extract secret/{secret} -n openshift-kube-apiserver "
            f"--keys=tls.crt --to=- > {shlex.quote(cert_check)}",
            check=False)
        if extracted.returncode != 0:
            return False
        env.run(f"chmod 600 {shlex.quote(cert_check)}", check=False)
        return (
            hostname in _secret_hostnames(oc, secret)
            and _certificate_file_has_san(cert_check, hostname))

    def api_vip_has_clone_cert():
        return presented_san_matches(_presented_san(api_ip, hostname), hostname)

    if secret_has_clone_cert() and api_vip_has_clone_cert():
        _clone_log(work, "API internal serving certificate already presents the clone name")
        return

    _clone_log(work, "restart the API cert controller so it re-reads the clone API name")
    _in_parallel(nodes, lambda node: _vm(
        node["ip"], compact_restart_cert_controller_command(), identity, check=False))
    namespace, lease = compact_cert_controller_lease()
    released = env.run(
        f"{oc} delete lease {shlex.quote(lease)} -n {shlex.quote(namespace)} --ignore-not-found",
        check=False)
    if released.returncode == 0:
        _clone_log(work, "released the cert controller lease")
    else:
        _clone_log(work, "cert controller lease was not deleted; leader election waits for the old lease")
    secret_deadline = time.monotonic() + 90
    matched = False
    while time.monotonic() < secret_deadline:
        if secret_has_clone_cert():
            matched = True
            break
        time.sleep(min(5, max(0, secret_deadline - time.monotonic())))
    if not matched:
        sys.exit(
            f"The API cert controller did not issue a certificate for {hostname}. "
            f"Kubelet cannot trust the API, so the network rollout cannot finish. "
            f"Log: {work}/clone.log")
    _clone_log(work, "API certificate secret has the clone name")
    _clone_log(work, "reload API servers so the API VIP serves the clone certificate")
    _in_parallel(nodes, lambda node: _vm(
        node["ip"], compact_reload_apiserver_script(), identity, check=False))
    api_deadline = time.monotonic() + 90
    while time.monotonic() < api_deadline:
        if api_vip_has_clone_cert():
            _clone_log(work, "API certificate presents the clone name")
            return
        time.sleep(min(5, max(0, api_deadline - time.monotonic())))
    sys.exit(
        f"The API certificate for {hostname} was issued but the apiserver is not presenting it. "
        f"Log: {work}/clone.log")


def _recover_compact_api_certificates(oc, work, domain, api_ip, nodes, identity):
    """Install the clone certs, then refresh the cert controller and API VIP."""
    _ensure_api_certificates(oc, work, domain, api_ip, nodes, identity)
    _refresh_internal_api_certificate(oc, work, domain, api_ip, nodes, identity)


def _ensure_compact_mcd_pod_addresses(clone_oc, nodes, work):
    """Refresh host-network MCD pods that retained source-node addresses."""
    _clone_log(work, "verify machine-config-daemon host addresses match clone nodes")

    def observe(role):
        result = env.run(
            f"{clone_oc} get pods -n openshift-machine-config-operator -o json", check=False)
        if result.returncode != 0 or not (result.stdout or "").strip():
            return None
        try:
            return compact_mcd_pod_address_rows(result.stdout).get(role)
        except (json.JSONDecodeError, TypeError):
            return None

    for node in nodes:
        state = observe(node["role"])
        deadline = time.monotonic() + 120
        deleted_pod_uids = set()
        while time.monotonic() < deadline:
            if state and state["ip"] == node["ip"]:
                if state["ready"]:
                    _clone_log(work, f"machine-config-daemon on {node['role']} uses clone IP {node['ip']}")
                    break
                # Correctly addressed pods may need time for their containers
                # and readiness probes to start. Never delete them just for that.
            elif state and state.get("ip") and state["ip"] != node["ip"]:
                pod_name = (state or {}).get("name")
                pod_uid = (state or {}).get("uid")
                if pod_name and pod_uid and pod_uid not in deleted_pod_uids:
                    if len(deleted_pod_uids) >= 3:
                        break
                    _clone_log(
                        work,
                        f"replace stale machine-config-daemon pod {pod_name} on {node['role']} "
                        f"(pod IP={(state or {}).get('ip') or 'pending'})")
                    resource_path = (
                        "/api/v1/namespaces/openshift-machine-config-operator/pods/"
                        f"{urllib.parse.quote(pod_name, safe='')}"
                    )
                    preconditions = {"uid": pod_uid}
                    deleted = env.run(
                        compact_kubernetes_delete_proxy_script(
                            clone_oc, resource_path, preconditions),
                        check=False)
                    if deleted.returncode == 0:
                        deleted_pod_uids.add(pod_uid)
                    else:
                        # A replacement between observation and delete is a
                        # normal optimistic-concurrency conflict; observe again.
                        latest = observe(node["role"])
                        if (latest and latest.get("uid") == pod_uid
                                and latest.get("ip") != node["ip"]):
                            detail = (deleted.stderr or deleted.stdout or "pod deletion failed").strip()
                            sys.exit(
                                f"Could not replace stale machine-config-daemon pod on {node['role']}: "
                                f"{detail}. Log: {work}/clone.log")
                        state = latest
                        time.sleep(2)
                        continue
            time.sleep(2)
            state = observe(node["role"])
        else:
            sys.exit(
                f"machine-config-daemon on {node['role']} did not become Ready with clone IP "
                f"{node['ip']} after replacing stale pod UIDs {sorted(deleted_pod_uids)}. "
                f"Log: {work}/clone.log")
        if not (state and state["ip"] == node["ip"] and state["ready"]):
            sys.exit(
                f"machine-config-daemon on {node['role']} kept a stale host-network address "
                f"after replacing pod UIDs {sorted(deleted_pod_uids)}. Log: {work}/clone.log")


def _ensure_compact_apiserver_host_ips(nodes, identity, work):
    """Ensure each static kube-apiserver advertises its current clone node IP."""
    _clone_log(work, "verify kube-apiserver runtime addresses match clone nodes")
    for node in nodes:
        result = _vm(
            node["ip"], compact_apiserver_host_ip_script(node["ip"]), identity,
            check=False)
        if result.returncode != 0:
            detail = (result.stderr or result.stdout or "HOST_IP verification failed").strip()
            sys.exit(
                f"kube-apiserver on {node['role']} did not become ready with clone IP "
                f"{node['ip']}: {detail}. Log: {work}/clone.log")
        _clone_log(work, f"kube-apiserver on {node['role']} advertises clone IP {node['ip']}")


def _recover_compact_api_certificates_and_endpoints(
    clone_oc, work, domain, api_ip, nodes, identity, etcd_image,
):
    """Refresh API certs and lease-backed endpoints before MCO waits on the API service."""
    _recover_compact_api_certificates(clone_oc, work, domain, api_ip, nodes, identity)
    _ensure_compact_apiserver_host_ips(nodes, identity, work)
    _clear_compact_stale_master_leases(nodes, identity, etcd_image, work)
    if _refresh_compact_kubernetes_endpoints(clone_oc, nodes, work) is not True:
        sys.exit(
            "Kubernetes API endpoints did not converge after kube-apiserver identity refresh. "
            f"Log: {work}/clone.log")


def compact_lb_cert_script(hostname, ip, signer_dir, out_dir):
    """Build the script that signs one load-balancer serving certificate."""
    return textwrap.dedent(f"""\
        set -euo pipefail
        mkdir -p {out_dir}
        chmod 700 {out_dir}
        cat > {out_dir}/ext.cnf << 'EOF'
        basicConstraints=critical,CA:FALSE
        keyUsage=critical,digitalSignature,keyEncipherment
        extendedKeyUsage=serverAuth
        subjectAltName=DNS:{hostname},IP:{ip}
        authorityKeyIdentifier=keyid
        EOF
        openssl req -new -newkey rsa:2048 -nodes -keyout {out_dir}/tls.key \\
          -subj "/CN={hostname}" -out {out_dir}/tls.csr
        openssl x509 -req -in {out_dir}/tls.csr -CA {signer_dir}/tls.crt -CAkey {signer_dir}/tls.key \\
          -CAcreateserial -out {out_dir}/tls.crt -days 720 -extfile {out_dir}/ext.cnf
        chmod 600 {out_dir}/tls.key {out_dir}/tls.crt
        """)


def compact_stop_workloads_script():
