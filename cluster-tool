    return textwrap.dedent("""\
        set +e
        sudo systemctl stop kubelet
        sudo systemctl stop keepalived
        sudo crictl pods -q | xargs -r sudo crictl stopp
        sudo systemctl stop crio
        sleep 2
        sudo pkill -x etcd
        sleep 1
        exit 0
        """)


def compact_identity_script():
    """Build the guest script that rewrites on-disk compact identity."""
    return textwrap.dedent(r"""
        import json, pathlib, re, sys
        pairs = json.loads(pathlib.Path("/var/tmp/identity-pairs.json").read_text())
        pairs.sort(key=lambda pair: len(pair[0]), reverse=True)
        roots = [
            "/etc/kubernetes",
            "/etc/keepalived",
            "/etc/systemd/system",
            "/usr/local/bin",
            "/etc/NetworkManager/system-connections",
        ]
        extra = ["/var/lib/kubelet/kubeconfig"]
        skip_suffix = (".crt", ".key", ".pem", ".db", ".gz", ".so", ".ko")

        def rewrite(text):
            for old, new in pairs:
                if not old or old == new:
                    continue
                if re.fullmatch(r"[0-9.]+", old):
                    text = re.sub(re.escape(old) + r"(?!\d)", new, text)
                else:
                    text = text.replace(old, new)
            return text

        paths = list(extra)
        for root in roots:
            base = pathlib.Path(root)
            if not base.exists():
                continue
            if base.is_file():
                paths.append(str(base))
                continue
            for path in base.rglob("*"):
                if path.is_file():
                    paths.append(str(path))
        changed = 0
        for name in paths:
            path = pathlib.Path(name)
            if not path.is_file() or path.suffix in skip_suffix or path.stat().st_size > 2000000:
                continue
            try:
                original = path.read_text()
            except (UnicodeDecodeError, OSError):
                continue
            updated = rewrite(original)
            if updated != original:
                path.write_text(updated)
                changed += 1
                print(name)
        print(f"rewrote {changed} files")
        """)


def _clone_log(work, message):
    """Append one timestamped progress line to the compact clone log."""
    stamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    line = f"===== {stamp} {message} ====="
    print(line, flush=True)
    env.run(f"printf '%s\\n' {shlex.quote(line)} >> {shlex.quote(work + '/clone.log')}")


def _vm(ip, script, identity, check=True):
    """Run one command on a compact guest."""
    return env.run_vm(ip, script, check=check, identity=identity)


def _wait_ssh(ip, identity, attempts=60):
    """Wait until SSH to a compact guest accepts connections."""
    for _ in range(attempts):
        probe = _vm(ip, "echo ready", identity, check=False)
        if probe.returncode == 0 and "ready" in probe.stdout:
            return
        time.sleep(5)
    sys.exit(f"SSH to {ip} did not come up")


def _parallel_label(item):
    """Return the node role for a parallel work item."""
    if isinstance(item, dict) and item.get("role"):
        return item["role"]
    if isinstance(item, tuple) and item and isinstance(item[0], dict) and item[0].get("role"):
        return item[0]["role"]
    return str(item)


def _in_parallel_results(items, fn):
    """Run fn on each item at the same time and return results in input order."""
    if not items:
        return []
    results = [None] * len(items)
    errors = {}
    lock = threading.Lock()

    def invoke(indexed):
        index, item = indexed
        try:
            results[index] = fn(item)
        except SystemExit as exc:
            with lock:
                errors[index] = f"{_parallel_label(item)}: {exc or 'parallel step failed'}"

    with ThreadPoolExecutor(max_workers=len(items)) as pool:
        list(pool.map(invoke, enumerate(items)))
    if errors:
        sys.exit("parallel step failed: " + "; ".join(errors[index] for index in sorted(errors)))
    return results


def _in_parallel(items, fn):
    """Run one independent action per item at the same time."""
    _in_parallel_results(items, fn)


def _call_together(named):
    """Run named independent calls at the same time."""
    items = list(named.items())
    values = _in_parallel_results(items, lambda item: item[1]())
    return {item[0]: value for item, value in zip(items, values)}


def _oc(kubeconfig, server):
    """Build an oc command that uses the clone kubeconfig."""
    return (
        f"KUBECONFIG={shlex.quote(kubeconfig)} oc --insecure-skip-tls-verify "
        f"--request-timeout=40s --server={shlex.quote(server)}"
    )


def compact_configure_runner_kubeconfig(kubeconfig, api_vip, api_server_name):
    """Point the saved kubeconfig at the clone API VIP and its certificate name."""
    quoted_path = shlex.quote(kubeconfig)
    cluster = env.run(
        f"oc config view --kubeconfig={quoted_path} --minify "
        "-o jsonpath='{.clusters[0].name}'",
        check=False,
    )
    cluster_name = (cluster.stdout or "").strip()
    if cluster.returncode != 0 or not cluster_name:
        detail = (cluster.stderr or "").strip()
        sys.exit(f"Could not find the active cluster in {kubeconfig}: {detail}")
    server = f"https://{api_vip}:6443"
    updated = env.run(
        f"oc config set-cluster {shlex.quote(cluster_name)} --kubeconfig={quoted_path} "
        f"--server={shlex.quote(server)} --tls-server-name={shlex.quote(api_server_name)}",
        check=False,
    )
    if updated.returncode != 0:
        detail = (updated.stderr or "").strip()
        sys.exit(f"Could not configure the clone API in {kubeconfig}: {detail}")
    env.run(f"chmod 600 {quoted_path}")


def _inject_compact_pull_secret(clone_oc, work, pull_secret):
    """Apply a runner-provided pull secret without putting its contents in argv or logs."""
    if pull_secret is None:
        return
    path = f"{work}/pull-secret.json"
    env.write_file(path, pull_secret)
    try:
        env.run(f"chmod 600 {shlex.quote(path)}")
        result = env.run(
            f"{clone_oc} set data secret/pull-secret -n openshift-config "
            f"--from-file=.dockerconfigjson={shlex.quote(path)}",
            check=False,
        )
        if result.returncode != 0:
            detail = (result.stderr or "").strip()
            sys.exit(f"Could not update the clone pull secret: {detail}")
    finally:
        env.run(f"rm -f {shlex.quote(path)}", check=False)
    _clone_log(work, "injected the runner-provided pull secret")


def _admin_auth_command(kubeconfig, ip):
    """Build an oc whoami command aimed at one API server."""
    return (
        f"KUBECONFIG={shlex.quote(kubeconfig)} oc --insecure-skip-tls-verify "
        f"--request-timeout=20s --server={shlex.quote('https://' + ip + ':6443')} whoami"
    )


def compact_admin_auth_results(kubeconfig, nodes):
    """Ask every master to accept the admin client certificate."""
    probes = _in_parallel_results(nodes, lambda node: env.run(
        _admin_auth_command(kubeconfig, node["ip"]), check=False))
    return [
        {
            "role": node["role"],
            "ok": probe.returncode == 0 and "system:" in (probe.stdout or ""),
        }
        for node, probe in zip(nodes, probes)
    ]


def compact_serviceaccount_auth_results(oc, nodes, work):
    """Ask every master to accept one short-lived service-account token."""
    failed = [{"role": node["role"], "ok": False} for node in nodes]
    minted = env.run(f"{oc} create token default --namespace default --duration=10m", check=False)
    token = (minted.stdout or "").strip()
    if minted.returncode != 0 or token.count(".") != 2 or any(char.isspace() for char in token):
        return failed
    path = f"{work}/.sa-probe-token"
    env.write_file(path, token + "\n")
    env.run(f"chmod 600 {shlex.quote(path)}")
    results = []
    try:
        probes = _in_parallel_results(nodes, lambda node: env.run(
            "code=$(curl -sk -o /dev/null -w '%{http_code}' "
            f"-H \"Authorization: Bearer $(cat {shlex.quote(path)})\" "
            f"{shlex.quote('https://' + node['ip'] + ':6443/readyz')}); "
            "printf '%s' \"$code\"",
            check=False))
        results = [
            {"role": node["role"], "ok": (probe.stdout or "").strip() == "200"}
            for node, probe in zip(nodes, probes)
        ]
    finally:
        env.run(f"rm -f {shlex.quote(path)}", check=False)
    return results


def _wait_admin_auth(kubeconfig, node, attempts=36):
    """Wait until one API server accepts the admin client certificate."""
    last = ""
    for _ in range(attempts):
        probe = env.run(_admin_auth_command(kubeconfig, node["ip"]), check=False)
        if probe.returncode == 0 and "system:" in (probe.stdout or ""):
            return
        last = ((probe.stderr or "") + "\n" + (probe.stdout or "")).strip()
        time.sleep(5)
    sys.exit(
        f"{node['role']} still rejects the cluster client certificate. "
        "The API address would keep returning credentials errors. "
        f"Last whoami: {last[:400]}")


def compact_stash_historical_certs_script():
