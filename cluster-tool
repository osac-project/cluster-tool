def compact_machine_config_observation(raw_mcp, node_rows):
    """Require the pool and all masters to report the desired render as applied."""
    try:
        mcp = json.loads(raw_mcp)
    except (json.JSONDecodeError, TypeError):
        return False, "pool status unavailable", ""
    if not isinstance(mcp, dict):
        return False, "pool status unavailable", ""
    spec_render = ((mcp.get("spec") or {}).get("configuration") or {}).get("name", "")
    status_render = ((mcp.get("status") or {}).get("configuration") or {}).get("name", "")
    conditions = {
        condition.get("type"): condition.get("status")
        for condition in ((mcp.get("status") or {}).get("conditions") or [])
    }
    pool_ready = (
        bool(spec_render)
        and spec_render.startswith("rendered-master-")
        and status_render == spec_render
        and conditions.get("Updated") == "True"
        and conditions.get("Updating") == "False"
        and conditions.get("Degraded") == "False"
    )
    by_name = {row.get("name"): row for row in node_rows}
    node_blockers = []
    for role in COMPACT_ROLES:
        node = by_name.get(role)
        if not node:
            node_blockers.append(f"{role}:missing")
            continue
        if (node.get("current_config") != spec_render
                or node.get("desired_config") != spec_render
                or node.get("mcd_state") != "Done"):
            state = node.get("mcd_state") or "unknown"
            reason = node.get("mcd_reason") or "none"
            node_blockers.append(f"{role}:{state}:{reason}")
    ready = pool_ready and not node_blockers
    detail = (
        f"pool spec={spec_render or 'missing'} status={status_render or 'missing'} "
        f"updated={conditions.get('Updated', 'missing')} "
        f"updating={conditions.get('Updating', 'missing')} "
        f"degraded={conditions.get('Degraded', 'missing')} "
        f"nodes={','.join(node_blockers) or 'ready'}"
    )
    return ready, detail, spec_render


def compact_api_url_file_blockers(results, nodes, expected):
    """Return masters whose on-disk API URL file differs from the clone render."""
    blockers = [
        node["role"] for node, result in zip(nodes, results)
        if result is None or result.returncode != 0 or (result.stdout or "") != expected
    ]
    if len(results) < len(nodes):
        blockers.extend(node["role"] for node in nodes[len(results):])
    return blockers


def rendered_machineconfig_files(raw):
    """Decode the ignition files stored in a rendered MachineConfig."""
    doc = json.loads(raw) if isinstance(raw, str) else raw
    files = {}
    for item in doc.get("spec", {}).get("config", {}).get("storage", {}).get("files") or []:
        path = item.get("path")
        source = (item.get("contents") or {}).get("source") or ""
        if not path or "," not in source:
            continue
        header, payload = source.split(",", 1)
        if "base64" in header:
            payload += "=" * ((4 - len(payload) % 4) % 4)
            try:
                body = base64.b64decode(payload).decode()
            except (UnicodeDecodeError, ValueError):
                continue
        else:
            body = urllib.parse.unquote(payload)
        files[path] = body
    return files


def _compact_machineconfig_identity(raw, clone_domain, require_render_name=True):
    """Return MachineConfig identity details without terminating on an invalid candidate."""
    errors = []
    try:
        doc = json.loads(raw) if isinstance(raw, str) else raw
    except (json.JSONDecodeError, TypeError):
        return "", "", ["not valid JSON"]
    if not isinstance(doc, dict):
        return "", "", ["not a JSON object"]
    name = (doc.get("metadata") or {}).get("name", "")
    files = rendered_machineconfig_files(doc)
    api_url = files.get("/etc/kubernetes/apiserver-url.env", "")
    coredns = files.get("/etc/kubernetes/static-pod-resources/coredns/Corefile.tmpl", "")
    expected_api_host = f"KUBERNETES_SERVICE_HOST='api-int.{clone_domain}'"
    expected_apps_domain = f"apps.{clone_domain}"
    if require_render_name and not name.startswith("rendered-master-"):
        errors.append("missing rendered-master name")
    if expected_api_host not in api_url.splitlines():
        errors.append("missing clone-specific /etc/kubernetes/apiserver-url.env")
    if not coredns:
        errors.append("missing CoreDNS Corefile.tmpl")
    elif expected_apps_domain not in coredns:
        errors.append(f"missing clone apps domain {expected_apps_domain} in CoreDNS Corefile.tmpl")
    else:
        # A Corefile can contain multiple generated API/DNS aliases. Reject a
        # mixed render that has the clone apps domain alongside source-cluster
        # aliases; MCD will report a content mismatch and the node rollout can
        # never converge on this render.
        aliases = re.findall(
            r"\b(?:api-int|api|apps)\.([A-Za-z0-9.-]+\.redhat\.com)\b",
            coredns,
            flags=re.IGNORECASE,
        )
        stale_aliases = sorted({alias for alias in aliases if alias.lower() != clone_domain.lower()})
        if stale_aliases:
            errors.append("contains non-clone CoreDNS aliases: " + ", ".join(stale_aliases))
    return name, api_url, errors


def compact_machineconfig_identity(raw, clone_domain):
    """Return a rendered name and API URL only when API and CoreDNS identity match."""
    name, api_url, errors = _compact_machineconfig_identity(raw, clone_domain)
    if errors:
        sys.exit("The desired master render has invalid clone identity: " + "; ".join(errors))
    return name, api_url


def compact_machineconfig_has_clone_identity(raw, clone_domain):
    """Whether a rendered MachineConfig has both clone API and CoreDNS identity."""
    name, _api_url, errors = _compact_machineconfig_identity(raw, clone_domain)
    return name.startswith("rendered-master-") and not errors


