def parse_oc_nodes(text):
    """Parse node readiness from oc get nodes output."""
    rows = []
    for line in text.splitlines():
        parts = line.split()
        if len(parts) < 2 or parts[0] == "NAME":
            continue
        rows.append({
            "name": parts[0],
            "ready": parts[1] == "Ready",
            "ip": parts[5] if len(parts) > 5 else "",
        })
    return rows


def compact_operators_from_docs(docs):
    """Return ClusterOperator availability from JSON documents."""
    operators = []
    for name in sorted(docs):
        by_type = {
            condition.get("type"): condition.get("status")
            for condition in ((docs.get(name) or {}).get("status") or {}).get("conditions") or []
        }
        operators.append({
            "name": name,
            "available": by_type.get("Available", ""),
            "progressing": by_type.get("Progressing", ""),
            "degraded": by_type.get("Degraded", ""),
        })
    return operators


def compact_install_observation_ready(
    ready, addresses_ok, core_unhealthy, install_blockers, revisions_ready,
    machine_config_ready=True, endpoints_ready=True,
):
    """True when a cheap watch is quiet enough to spend a full validation sample."""
    return (
        ready >= len(COMPACT_ROLES)
        and addresses_ok
        and not core_unhealthy
        and not install_blockers
        and bool(revisions_ready)
        and bool(machine_config_ready)
        and bool(endpoints_ready)
    )


def parse_oc_co(text):
    """Parse ClusterOperator status from oc get co output."""
    operators = []
    for line in text.splitlines():
        parts = line.split()
        if len(parts) < 5 or parts[0] == "NAME":
            continue
        operators.append({
            "name": parts[0],
            "available": parts[2],
            "progressing": parts[3],
            "degraded": parts[4],
        })
    return operators


CORE_OPERATORS = frozenset({
    "authentication",
    "etcd",
    "kube-apiserver",
    "kube-controller-manager",
    "kube-scheduler",
    "network",
    "openshift-apiserver",
})


