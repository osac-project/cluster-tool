def _sync_requestheader_aggregator_ca(kubeconfig, api_ip, work, identity, quorum_ip):
    """Trust only the quorum aggregator CA for aggregated API calls.

    Recert leaves a second aggregator CA with the same subject in
    extension-apiserver-authentication. openshift-apiserver then rejects the
    quorum aggregator client certificate.
    """
    remote = (
        "/etc/kubernetes/static-pod-resources/kube-apiserver-certs/"
        "configmaps/aggregator-client-ca/ca-bundle.crt"
    )
    fetched = _vm(quorum_ip, f"sudo cat {remote}", identity, check=False)
    pem = fetched.stdout or ""
    if fetched.returncode != 0 or pem.count("BEGIN CERTIFICATE") != 1:
        _clone_log(work, "quorum aggregator CA was not a single certificate")
        return
    if not pem.endswith("\n"):
        pem += "\n"
    ca_path = f"{work}/aggregator-client-ca.crt"
    patch_path = f"{work}/requestheader-ca.patch.json"
    env.write_file(ca_path, pem)
    env.run(f"chmod 600 {shlex.quote(ca_path)}")
    oc = _oc(kubeconfig, f"https://{api_ip}:6443")
    _clone_log(work, "set aggregated API trust to the quorum aggregator CA")
    for _ in range(6):
        current = env.run(
            f"{oc} get cm extension-apiserver-authentication -n kube-system -o json",
            check=False)
        if current.returncode != 0 or not (current.stdout or "").strip():
            time.sleep(5)
            continue
        raw_path = f"{work}/extension-apiserver-authentication.json"
        env.write_file(raw_path, current.stdout)
        env.run(f"chmod 600 {shlex.quote(raw_path)}")
        decision = env.run(
            "python3 - " + shlex.quote(raw_path) + " " + shlex.quote(ca_path) + " " + shlex.quote(patch_path) + """ << 'PY'
import json, os, pathlib, sys
raw_path, ca_path, patch_path = sys.argv[1:]
pem = pathlib.Path(ca_path).read_text()
doc = json.loads(pathlib.Path(raw_path).read_text())
have = ((doc.get("data") or {}).get("requestheader-client-ca-file") or "")
if have.strip() == pem.strip() and have.count("BEGIN CERTIFICATE") == 1:
    print("unchanged")
    raise SystemExit(0)
pathlib.Path(patch_path).write_text(json.dumps({"data": {"requestheader-client-ca-file": pem}}))
os.chmod(patch_path, 0o600)
print("update")
PY""",
            check=False)
        env.run(f"rm -f {shlex.quote(raw_path)}", check=False)
        status = (decision.stdout or "").strip().splitlines()
        if decision.returncode == 0 and status and status[-1] == "unchanged":
            env.run(f"rm -f {shlex.quote(ca_path)} {shlex.quote(patch_path)}", check=False)
            return
        if decision.returncode == 0 and status and status[-1] == "update":
            patched = env.run(
                f"{oc} patch cm extension-apiserver-authentication -n kube-system "
                f"--type=merge --patch-file {shlex.quote(patch_path)}",
                check=False)
            env.run(f"rm -f {shlex.quote(patch_path)}", check=False)
            if patched.returncode == 0:
                env.run(f"rm -f {shlex.quote(ca_path)}", check=False)
                return
        time.sleep(5)
    env.run(f"rm -f {shlex.quote(ca_path)} {shlex.quote(patch_path)}", check=False)
    _clone_log(work, "aggregated API trust still has a second aggregator CA")


def _load_reissued_etcd_pems(work, nodes):
    """Read the reissued etcd PEMs for the bundle secret keys."""
    pems = {}
    root = Path(work) / "etcd-new"
    for name in compact_etcd_cert_names(nodes):
        for ext in ("crt", "key"):
            path = root / f"{name}.{ext}"
            if path.is_file():
                pems[f"{name}.{ext}"] = path.read_text()
    return pems


def _etcd_member_secret_status(clone_oc, secret, pems):
    """Classify one per-member secret. A missing secret is best-effort; a failed update is not."""
    raw = env.run(
        f"{clone_oc} get secret {shlex.quote(secret)} -n openshift-etcd -o json",
        check=False)
    text = f"{raw.stdout or ''} {raw.stderr or ''}"
    if raw.returncode != 0 or not (raw.stdout or "").strip():
        if raw.returncode != 0 and "not found" in text.lower():
            return "missing"
        return "failed"
    member = {
        "tls.crt": pems.get(f"{secret}.crt", ""),
        "tls.key": pems.get(f"{secret}.key", ""),
    }
    try:
        delta = compact_etcd_secret_delta(raw.stdout, member)
    except json.JSONDecodeError:
        return "failed"
    if delta["absent"]:
        return "failed"
    if not delta["changed"]:
        return "current"
    patch = compact_etcd_secret_patch(raw.stdout, member)
    patched = env.run(
        f"{clone_oc} patch secret {shlex.quote(secret)} -n openshift-etcd --type=merge "
        f"-p {shlex.quote(patch)}",
        check=False)
    if patched.returncode != 0:
        return "failed"
    checked = env.run(
        f"{clone_oc} get secret {shlex.quote(secret)} -n openshift-etcd -o json",
        check=False)
    if checked.returncode != 0 or not (checked.stdout or "").strip():
        return "failed"
    try:
        confirmed = compact_etcd_secret_delta(checked.stdout, member)
    except json.JSONDecodeError:
        return "failed"
    if confirmed["absent"] or confirmed["changed"]:
        return "failed"
    return "patched"


def _sync_reissued_etcd_certs(clone_oc, nodes, identity, work, copy_to_nodes):
    """Install reissued etcd certificates into the live bundle and classify per-member secrets.

    The live etcd-all-certs result is patched, already-current, or failed. Missing per-member
    secrets stay best-effort. A present member secret that cannot be verified is failed.
    """
    result = {
        "bundle": "failed",
        "detail": "",
        "members_missing": [],
        "members_patched": [],
        "members_current": [],
        "members_failed": [],
    }
    pems = _load_reissued_etcd_pems(work, nodes)
    if not pems:
        result["detail"] = "no reissued etcd certificates were found"
        return result
    raw = env.run(
        f"{clone_oc} get secret etcd-all-certs -n openshift-etcd -o json",
        check=False)
    if raw.returncode != 0 or not (raw.stdout or "").strip():
        result["detail"] = "reading etcd-all-certs failed"
        return result
    try:
        delta = compact_etcd_secret_delta(raw.stdout, pems)
    except json.JSONDecodeError:
        result["detail"] = "etcd-all-certs is not valid JSON"
        return result
    if delta["absent"]:
        result["detail"] = "etcd-all-certs is missing " + ",".join(delta["absent"])
        return result
    if delta["changed"]:
        patch = compact_etcd_secret_patch(raw.stdout, pems)
        _clone_log(work, "etcd-all-certs patch requested")
        patched = env.run(
            f"{clone_oc} patch secret etcd-all-certs -n openshift-etcd --type=merge "
            f"-p {shlex.quote(patch)}",
            check=False)
        if patched.returncode != 0:
            result["detail"] = "patching etcd-all-certs failed"
            return result
        checked = env.run(
            f"{clone_oc} get secret etcd-all-certs -n openshift-etcd -o json",
            check=False)
        if checked.returncode != 0 or not (checked.stdout or "").strip():
            result["detail"] = "re-reading etcd-all-certs failed"
            return result
        try:
            confirmed = compact_etcd_secret_delta(checked.stdout, pems)
        except json.JSONDecodeError:
            result["detail"] = "etcd-all-certs is not valid JSON after the patch"
            return result
        if confirmed["absent"] or confirmed["changed"]:
            result["detail"] = "etcd-all-certs did not match the generated certificates after the patch"
            return result
        _clone_log(work, "etcd-all-certs patch verified")
        result["bundle"] = "patched"
    else:
        _clone_log(work, "etcd-all-certs already-current")
        result["bundle"] = "already-current"
    for node in nodes:
        for kind in ("peer", "serving", "serving-metrics"):
            secret = f"etcd-{kind}-{node['role']}"
            status = _etcd_member_secret_status(clone_oc, secret, pems)
            bucket = {
                "missing": "members_missing",
                "failed": "members_failed",
                "current": "members_current",
                "patched": "members_patched",
            }[status]
            result[bucket].append(secret)
    if not copy_to_nodes:
        return result
    for node in nodes:
        for other in nodes:
            env.run(
                "scp " + " ".join(SSH_OPTS) + f" -i {shlex.quote(identity)} "
                f"{shlex.quote(work + '/etcd-new')}/etcd-*-{other['role']}.crt "
                f"{shlex.quote(work + '/etcd-new')}/etcd-*-{other['role']}.key "
                f"core@{node['ip']}:/var/tmp/")
        _vm(node["ip"], compact_install_etcd_certs_script(), identity, check=False)
    return result


def _require_reissued_etcd_certs(clone_oc, nodes, identity, work):
    """Update the live etcd bundle and abort unless the result is patched or already-current."""
    result = _sync_reissued_etcd_certs(clone_oc, nodes, identity, work, copy_to_nodes=False)
    status = "failed" if result["members_failed"] else result["bundle"]
    missing = ",".join(result["members_missing"]) or "none"
    failed_members = ",".join(result["members_failed"]) or "none"
    detail = f" ({result['detail']})" if result["detail"] else ""
    _clone_log(
        work,
        f"etcd certificate inputs {status}{detail}; "
        f"members missing={missing} failed={failed_members}")
    if status not in ("patched", "already-current"):
        sys.exit(
            f"etcd certificate inputs {status}{detail}. "
            f"Log: {work}/clone.log")
    if status == "patched":
        result["etcd_revision_baseline"] = _trigger_etcd_member_rollout(clone_oc, work)
    return result


def _revision_int(value):
    """Return whether a revision number is a real integer."""
    return isinstance(value, int) and not isinstance(value, bool)


def compact_valid_revision_baselines(payload):
    """Return saved etcd and kube-apiserver baselines, or None when either is missing."""
    if not isinstance(payload, dict):
        return None
    etcd = payload.get("etcd")
    apiserver = payload.get("kube-apiserver")
    if not _revision_int(etcd) or not _revision_int(apiserver):
        return None
    return (etcd, apiserver)


def _revision_baselines_path(work):
    """Return the path of the persisted pre-rollout revision baselines."""
    return work + "/revision-baselines.json"


def _load_revision_baselines(work):
    """Load both pre-rollout revision baselines. Missing or partial data is unusable."""
    raw = env.run(
        f"cat {shlex.quote(_revision_baselines_path(work))} 2>/dev/null || true",
        check=False)
    try:
        payload = json.loads(raw.stdout or "")
    except json.JSONDecodeError:
        payload = None
    return compact_valid_revision_baselines(payload)


def _load_revision_baseline(work, name):
    """Load one saved pre-rollout revision when a compact run resumes mid-flow."""
    raw = env.run(
        f"cat {shlex.quote(_revision_baselines_path(work))} 2>/dev/null || true",
        check=False)
    try:
        value = json.loads(raw.stdout or "").get(name)
    except (json.JSONDecodeError, AttributeError):
        return None
    return value if _revision_int(value) else None


def _store_revision_baseline(work, name, value):
    """Persist one pre-rollout revision without dropping the other."""
    if not _revision_int(value):
        return
    path = _revision_baselines_path(work)
    raw = env.run(f"cat {shlex.quote(path)} 2>/dev/null || true", check=False)
    try:
        loaded = json.loads(raw.stdout or "")
    except json.JSONDecodeError:
        loaded = None
    payload = dict(loaded) if isinstance(loaded, dict) else {}
    payload[name] = value
    env.write_file(path, json.dumps(payload) + "\n")
    env.run(f"chmod 600 {shlex.quote(path)}")


def _operator_latest_revision(clone_oc, name):
    """Read the revision currently installed for one static-pod operator."""
    raw = env.run(f"{clone_oc} get co {shlex.quote(name)} -o json", check=False)
    if raw.returncode != 0 or not (raw.stdout or "").strip():
        return None
    try:
        doc = json.loads(raw.stdout)
    except json.JSONDecodeError:
        return None
    return compact_static_pod_revision(doc).get("current")


def _trigger_etcd_member_rollout(clone_oc, work):
    """Start the operator-controlled etcd rollout after the live bundle is verified."""
    baseline = _operator_latest_revision(clone_oc, "etcd")
    if not _revision_int(baseline):
        sys.exit(
            "etcd revision baseline is unavailable; refusing to start the member rollout. "
            f"Log: {work}/clone.log")
    reason = "reissued-etcd-certs-" + datetime.now().strftime("%Y%m%dT%H%M%S")
    patch = json.dumps(compact_etcd_force_redeploy_patch(reason))
    patched = env.run(
        f"{clone_oc} patch etcd cluster --type=merge -p {shlex.quote(patch)}",
        check=False)
    if patched.returncode != 0:
        sys.exit(f"etcd rollout trigger failed. Log: {work}/clone.log")
    _clone_log(work, f"etcd rollout triggered from revision {baseline}")
    return baseline


