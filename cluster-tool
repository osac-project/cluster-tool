    clone_p.add_argument("--network", help="Libvirt network name (default: SOURCE, then test-infra-net-SOURCE)")
    clone_p.add_argument("--clone-id", required=True, help="Clone id used in the new cluster name")
    clone_p.add_argument("--subnet", required=True, type=int, help="Third octet of the clone network")
    clone_p.add_argument("--identity", default="/root/.ssh/id_rsa", help="SSH key on the hypervisor for the core user")
    clone_p.add_argument("--memory-kib", type=int, help="Override memory for each clone VM, in KiB")
    clone_p.add_argument("--vcpus", type=int, help="Override vCPU count for each clone VM")
    clone_p.add_argument("--resume", choices=["recert", "heal", "health"], help="Continue an existing clone at Recert, the record rewrite, or the health check")

    flavor_boot_p = sub.add_parser("compact-boot", help="Deploy a pulled 3-master flavor and heal it once")
    flavor_boot_p.add_argument("--flavor", required=True, help="Pulled compact flavor name")
    flavor_boot_p.add_argument("--name", required=True, help="Clone id used in the new cluster name")
    flavor_boot_p.add_argument("--subnet", type=int, help="Third octet of the new network (allocated automatically if omitted)")
    flavor_boot_p.add_argument("--host", required=True, help="SSH target (e.g., root@hostname) or 'local'")
    flavor_boot_p.add_argument("--identity", default="", help="SSH key for the core user. Defaults to the flavor cluster-tool key")
    flavor_boot_p.add_argument("--pull-secret", help="Path to a runner pull-secret.json to inject after API recovery")
    flavor_boot_p.add_argument("--memory-kib", type=int, help="Override memory for each VM, in KiB")
    flavor_boot_p.add_argument("--vcpus", type=int, help="Override vCPU count for each VM")
    flavor_boot_p.add_argument(
        "--resume", choices=["recert", "rewrite", "health"],
        help="Continue an existing clone at Recert, identity rewrite, or health check")

    sub.add_parser("servers", help="List connected servers")

    use_p = sub.add_parser("use", help="Set default server")
    use_p.add_argument("name", help="Server alias to set as default")

    for p in [snap_p, boot_p, list_p, flavors_p, verify_p, destroy_p, push_p, pull_p]:
        p.add_argument("--server", help="Server alias (default: from config)")

    args = parser.parse_args()
    cmds = {"snapshot": cmd_snapshot, "boot": cmd_boot, "list": cmd_list, "flavors": cmd_flavors, "verify": cmd_verify, "destroy": cmd_destroy, "push": cmd_push, "pull": cmd_pull}

    if args.command == "setup":
        cmd_setup(args)
        return
    if args.command == "servers":
        cmd_servers(args)
        return
    if args.command == "use":
        cmd_use(args)
        return
    if args.command == "connect":
        cmd_connect(args)
        return
    if args.command == "inspect":
        host = args.host
        hostname = socket.gethostname() if host == "local" else host.split("@")[-1]
        host_ip = resolve_host_ip(hostname)
        env = ExecutionEnv(host=host, host_ip=host_ip)
        cmd_inspect(args)
        return
    if args.command == "compact-heal":
        host = args.host
        hostname = socket.gethostname() if host == "local" else host.split("@")[-1]
        host_ip = resolve_host_ip(hostname)
        env = ExecutionEnv(host=host, host_ip=host_ip)
        cmd_compact_heal(args)
        return
    if args.command == "compact-clone":
        host = args.host
        hostname = socket.gethostname() if host == "local" else host.split("@")[-1]
        host_ip = resolve_host_ip(hostname)
        env = ExecutionEnv(host=host, host_ip=host_ip)
        cmd_compact_clone(args)
        return
    if args.command == "compact-boot":
        host = args.host
        hostname = socket.gethostname() if host == "local" else host.split("@")[-1]
        host_ip = resolve_host_ip(hostname)
        env = ExecutionEnv(host=host, host_ip=host_ip)
        r = env.run("cat ~/.config/cluster-tool/config", check=False)
        if r.returncode != 0:
            sys.exit("Server not set up. Run './cluster-tool connect' on this host first.")
        data_dir = ""
        for line in r.stdout.strip().split("\n"):
            if line.startswith("CLUSTER_TOOL_DATA="):
                data_dir = line.split("=", 1)[1]
        if not data_dir:
            sys.exit("CLUSTER_TOOL_DATA is not set on this host")
        _init_paths(data_dir)
        cmd_compact_boot(args)
        return
    if args.command not in cmds:
        parser.print_help()
        sys.exit(1)

    server_name = getattr(args, "server", None) or os.environ.get("CLUSTER_TOOL_HOST")
    if not server_name:
        config = load_servers()
        server_name = config.get("default")
    if not server_name:
        sys.exit("No server specified. Use --server NAME, or set a default with './cluster-tool use NAME'.")

    if "@" in server_name or server_name == "local":
        host = server_name
    else:
        host = resolve_server(server_name)

    hostname = socket.gethostname() if host == "local" else host.split("@")[-1]
    host_ip = resolve_host_ip(hostname)
    env = ExecutionEnv(host=host, host_ip=host_ip)

    r = env.run("cat ~/.config/cluster-tool/config", check=False)
    if r.returncode != 0:
        sys.exit(f"Server not set up. Run './cluster-tool connect {server_name} --host ...' first.")
    for line in r.stdout.strip().split("\n"):
        if line.startswith("CLUSTER_TOOL_DATA="):
            _init_paths(line.split("=", 1)[1])
            break

    cmds[args.command](args)


if __name__ == "__main__":
    main()
