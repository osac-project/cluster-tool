def parse_dominfo(dominfo_output):
    result = {}
    for line in dominfo_output.strip().split("\n"):
        if "CPU(s):" in line:
            result["vcpus"] = int(line.split(":")[1].strip())
        elif "Max memory:" in line:
            result["memory_kib"] = int(line.split(":")[1].strip().split()[0])
    return result


def parse_disk_paths(dumpxml_output, pool_name):
    root = ET.fromstring(dumpxml_output)
    disks = []
    for disk in root.findall(".//disk"):
        if disk.get("device") == "cdrom":
            continue
        target = disk.find("target")
        source = disk.find("source")
        if target is None or source is None:
            continue
        path = None
        if source.get("file"):
            path = source.get("file")
        elif source.get("pool") and source.get("volume"):
            r = env.run(f"virsh vol-path --pool {source.get('pool')} {source.get('volume')}")
            path = r.stdout.strip()
        if path:
            disks.append({"target": target.get("dev"), "path": path})
    disks.sort(key=lambda d: d["target"])
    return disks


def parse_subnet(net_xml):
    root = ET.fromstring(net_xml)
    ip_elem = root.find(".//ip[@family='ipv4']")
    if ip_elem is None:
        ip_elem = root.find(".//ip")
    addr = ip_elem.get("address")
    return int(addr.split(".")[2])


COMPACT_ROLES = ("master-0-0", "master-0-1", "master-0-2")
COMPACT_NODE_SUFFIXES = (69, 81, 89)
COMPACT_API_SUFFIX = 5
COMPACT_INGRESS_SUFFIX = 10
DNSMASQ_NS = {"dnsmasq": "http://libvirt.org/schemas/network/dnsmasq/1.0"}


def parse_dhcp_hosts(net_xml):
    """Read DHCP host entries from a libvirt network XML document."""
    root = ET.fromstring(net_xml)
    hosts = []
    for host in root.findall(".//dhcp/host"):
        raw_ip = host.get("ip")
        try:
            parsed_ip = ipaddress.ip_address(raw_ip or "")
        except ValueError as exc:
            raise ValueError("Libvirt DHCP host has an invalid IP address") from exc
        if not isinstance(parsed_ip, ipaddress.IPv4Address):
            raise ValueError("Libvirt DHCP host address must be IPv4")
        hosts.append({
            "mac": host.get("mac"),
            "name": host.get("name"),
            "ip": str(parsed_ip),
        })
    return hosts


def parse_dnsmasq_addresses(net_xml):
    """Read dnsmasq address records from a libvirt network XML document."""
    root = ET.fromstring(net_xml)
    found = []
    for opt in root.findall(".//dnsmasq:option", DNSMASQ_NS):
        value = opt.get("value") or ""
        if not value.startswith("address="):
            continue
        parts = value[len("address="):].split("/")
        if len(parts) < 3 or not parts[-1]:
            continue
        name = parts[-2]
        found.append({
            "name": name.lstrip("."),
            "ip": parts[-1],
            "wildcard": name.startswith("."),
        })
    return found


def parse_addnhosts(text):
    """Read extra host records from dnsmasq addn-hosts text."""
    found = []
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        parts = line.split()
        if len(parts) < 2:
            continue
        ip = parts[0]
        for name in parts[1:]:
            found.append({"name": name, "ip": ip, "wildcard": False})
    return found


def parse_primary_mac(dumpxml):
    """Read the primary interface MAC from a domain XML document."""
    root = ET.fromstring(dumpxml)
    iface = root.find("./devices/interface")
    if iface is None:
        iface = root.find(".//interface")
    mac = iface.find("mac") if iface is not None else None
    if mac is None or not mac.get("address"):
        sys.exit("Domain XML has no interface MAC")
    return mac.get("address")


def parse_network_gateway(net_xml):
    """Read the gateway address and machine network from network XML."""
    root = ET.fromstring(net_xml)
    ip_elem = root.find(".//ip[@family='ipv4']")
    if ip_elem is None:
        ip_elem = root.find(".//ip")
    if ip_elem is None or not ip_elem.get("address"):
        sys.exit("Network XML has no IPv4 address")
    prefix = ip_elem.get("prefix")
    netmask = ip_elem.get("netmask")
    if prefix:
        network = ipaddress.ip_network(f"{ip_elem.get('address')}/{prefix}", strict=False)
    elif netmask:
        network = ipaddress.ip_network(f"{ip_elem.get('address')}/{netmask}", strict=False)
    else:
        sys.exit("Network XML has no prefix or netmask")
    return ip_elem.get("address"), str(network)


def classify_vips(addresses):
    """Separate the API and ingress addresses from dnsmasq records."""
    api_vip = None
    ingress_vip = None
    for item in addresses:
        name = item["name"]
        if api_vip is None and (name.startswith("api.") or name.startswith("api-int.")):
            api_vip = item["ip"]
        elif ingress_vip is None and (name.startswith("apps.") or name == "apps"):
            ingress_vip = item["ip"]
    return api_vip, ingress_vip


def match_dhcp_host(role, mac, dhcp_hosts):
    """Find the DHCP host entry for a compact role and MAC."""
    mac_l = (mac or "").lower()
    for host in dhcp_hosts:
        if host.get("mac") and host["mac"].lower() == mac_l:
            return host
    for host in dhcp_hosts:
        host_name = host.get("name") or ""
        if host_name == role or host_name.endswith("-" + role):
            return host
    return None


def _domain_defined(name):
    """Return whether a libvirt domain name is already defined."""
    r = env.run(f"virsh domstate {shlex.quote(name)}", check=False)
    return r.returncode == 0 and r.stdout.strip() != ""


def resolve_compact_domains(source):
    """Resolve the three compact master domains for a source cluster."""
    candidates = [
        [f"{source}-{role}" for role in COMPACT_ROLES],
        [f"test-infra-cluster-{source}-{role}" for role in COMPACT_ROLES],
    ]
    for group in candidates:
        if all(_domain_defined(name) for name in group):
            return group
    tried = ", ".join(candidates[0] + candidates[1])
    sys.exit(f"No 3-master compact source found for '{source}'. Tried: {tried}")


def resolve_compact_network(source, network):
    """Resolve the libvirt network used by a compact source."""
    names = [network] if network else [source, f"test-infra-net-{source}"]
    for name in names:
        if not name:
            continue
        r = env.run(f"virsh net-dumpxml {shlex.quote(name)}", check=False)
        if r.returncode == 0 and r.stdout.strip():
            return name, r.stdout
    sys.exit(f"Libvirt network for '{source}' not found. Tried: {', '.join(names)}")


def discover_compact_source(source, network=None):
    """Collect the compact source layout needed to plan a clone."""
    domains = resolve_compact_domains(source)
    net_name, net_xml = resolve_compact_network(source, network)
    gateway, machine_network = parse_network_gateway(net_xml)
    try:
        dhcp_hosts = parse_dhcp_hosts(net_xml)
    except ValueError as exc:
        sys.exit(f"Libvirt network '{net_name}' has invalid DHCP host data: {exc}")
    dns = parse_dnsmasq_addresses(net_xml)
    hosts_file = env.run(
        f"cat /var/lib/libvirt/dnsmasq/{shlex.quote(net_name)}.addnhosts",
        check=False)
    if hosts_file.returncode == 0:
        dns.extend(parse_addnhosts(hosts_file.stdout))
    api_vip, ingress_vip = classify_vips(dns)
    if not api_vip or not ingress_vip:
        sys.exit(
            f"Network '{net_name}' is missing an api or apps address "
            f"(api={api_vip}, ingress={ingress_vip})")

    nodes = []
    for role, domain in zip(COMPACT_ROLES, domains):
        info = env.run(f"virsh dominfo {shlex.quote(domain)}")
        dominfo = parse_dominfo(info.stdout)
        state = env.run(f"virsh domstate {shlex.quote(domain)}")
        if state.stdout.strip() != "running":
            sys.exit(f"Source VM '{domain}' is '{state.stdout.strip()}', expected 'running'")
        dump = env.run(f"virsh dumpxml {shlex.quote(domain)}")
        mac = parse_primary_mac(dump.stdout)
        host = match_dhcp_host(role, mac, dhcp_hosts)
        if host is None or not host.get("ip"):
            sys.exit(f"No DHCP address for {domain} ({mac}) on network '{net_name}'")
        nodes.append({
            "role": role,
            "domain": domain,
            "mac": mac,
            "ip": host["ip"],
            "dhcp_name": host.get("name"),
            "memory_kib": dominfo["memory_kib"],
            "vcpus": dominfo["vcpus"],
            "disks": parse_disk_paths(dump.stdout, source),
        })

    return {
        "topology": "compact",
        "source": source,
        "network": net_name,
        "gateway": gateway,
        "machine_network": machine_network,
        "api_vip": api_vip,
        "ingress_vip": ingress_vip,
        "memory_kib": nodes[0]["memory_kib"],
        "vcpus": nodes[0]["vcpus"],
        "nodes": nodes,
        "dns": dns,
    }


def format_compact_inspect(record):
    """Summarize a compact source by role count, without addresses or disk paths."""
    roles = [node.get("role", "node") for node in record.get("nodes", [])]
    return f"Compact source has {len(roles)} nodes: {', '.join(roles)}."


def cmd_inspect(args):
    """Print a compact-source summary that omits addresses, names, and paths."""
    record = discover_compact_source(args.source, network=args.network)
    print(format_compact_inspect(record))


