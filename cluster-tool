    if not snapshot:
        sys.exit("etcd restore needs a snapshot path")
    if not cluster_token:
        sys.exit("etcd restore needs a cluster token")
    initial_cluster = compact_initial_cluster(nodes)
    by_name = {_compact_node_name(node): node for node in nodes}
    commands = []
    for role in COMPACT_ROLES:
        node = by_name[role]
        peer = f"https://{node['ip']}:2380"
        argv = [
            "etcdutl", "snapshot", "restore", snapshot,
            "--data-dir", f"{data_root}/{role}",
            "--name", role,
            "--initial-cluster", initial_cluster,
            "--initial-advertise-peer-urls", peer,
            "--initial-cluster-token", cluster_token,
        ]
        if skip_hash_check:
            argv.append("--skip-hash-check")
        commands.append({"name": role, "ip": node["ip"], "argv": argv})
    return commands


