def _restore_ownership(path):
    """When invoked via sudo (the normal CI path for boot/destroy/etc.,
    which need root for libvirt/network operations), any file or
    directory this process creates or writes is owned by root -- even
    though _REAL_HOME above correctly points at the invoking user's
    home. That leaves state.json/state.lock/haproxy.lock/kubeconfigs
    root-owned after every run, silently breaking the next unprivileged
    (non-sudo) read/write of the same paths. Chown back to the
    SUDO_UID/SUDO_GID sudo records for the real invoking user whenever
    we're running as root under sudo; a no-op otherwise (e.g. local,
    non-CI use without sudo).

    Fails loudly (sys.exit), matching this codebase's convention, rather
    than warning and continuing -- a silently-swallowed chown failure
    would let the exact bug this exists to fix (root-owned state files
    silently breaking the next run) reappear with no CI signal at all.
    """
    if os.geteuid() != 0:
        return
    sudo_uid = os.environ.get("SUDO_UID")
    sudo_gid = os.environ.get("SUDO_GID")
    if sudo_uid is None or sudo_gid is None:
        return
    try:
        os.chown(str(path), int(sudo_uid), int(sudo_gid))
    except OSError as e:
        sys.exit(f"Failed to chown {path} to {sudo_uid}:{sudo_gid}: {e}")


