    name = (doc.get("metadata") or {}).get("name", "")
    api_url = rendered_machineconfig_files(doc).get(
        "/etc/kubernetes/apiserver-url.env", "")
    wanted = f"KUBERNETES_SERVICE_HOST='api-int.{clone_domain}'"
    return name.startswith("rendered-master-") and wanted in api_url.splitlines()


def compact_machineconfig_input_has_clone_api_url(raw, clone_domain):
