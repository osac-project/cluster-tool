def detect_vm_emulator():
    candidates = " ".join(shlex.quote(c) for c in VM_EMULATOR_CANDIDATES)
    script = f"for p in {candidates}; do test -x $p && echo $p && exit 0; done; command -v qemu-system-x86_64 || command -v qemu-kvm"
    r = env.run(f"bash -c '{script}'", check=False)
    path = r.stdout.strip().splitlines()[0] if r.returncode == 0 and r.stdout.strip() else ""
    if not path:
        sys.exit("No QEMU emulator found on the target host. Install qemu-kvm or qemu-system-x86_64.")
    return path


def _parse_machine_types(machine_help):
    machine_types = []
    for line in machine_help.splitlines():
        token = line.strip().split(None, 1)
        if not token:
            continue
        machine_types.append(token[0])
    return machine_types


def detect_vm_machine_type(emulator):
    r = env.run(f"{shlex.quote(emulator)} -machine help", check=False)
    if r.returncode != 0:
        sys.exit(f"Failed to query machine types from {emulator}. Is QEMU installed correctly?")

    machine_types = _parse_machine_types(r.stdout)
    machine_set = set(machine_types)

    for preferred in VM_MACHINE_PREFERENCES:
        if preferred in machine_set:
            return preferred

    for prefix in VM_MACHINE_PREFIX_PREFERENCES:
        for machine in machine_types:
            if machine.startswith(prefix):
                return machine

    if machine_types:
