def compact_operator_docs(raw):
    """Index ClusterOperator JSON objects by name."""
    try:
        doc = json.loads(raw)
    except json.JSONDecodeError:
        return {}
    items = doc.get("items") if isinstance(doc, dict) and "items" in doc else [doc]
    found = {}
    for item in items:
        if not isinstance(item, dict):
            continue
        name = (item.get("metadata") or {}).get("name")
        if name:
            found[name] = item
    return found


def compact_revision_from_text(text):
    """Read a static-pod revision from a ClusterOperator condition message.

    OpenShift 4.22 reports the revision only in that message. Identical sentences
    repeated by Progressing and Available count once. Settled means exactly one
    revision has exactly three nodes and no higher revision is still pending.
    """
    totals = {}
    pending = []
    seen = set()
    for match in re.finditer(
        r"(\d+) nodes? (are at revision|is at revision|have achieved new revision) (\d+)",
        text or "",
        re.I,
    ):
        count, kind, revision = int(match.group(1)), match.group(2).lower(), int(match.group(3))
        token = (count, kind, revision)
        if token in seen:
            continue
        seen.add(token)
        if "achieved" in kind and count == 0:
            pending.append(revision)
            continue
        totals[revision] = totals.get(revision, 0) + count
    positive = {revision: count for revision, count in totals.items() if count > 0}
    only = next(iter(positive)) if len(positive) == 1 else None
    current = only if only is not None and positive[only] == len(COMPACT_ROLES) else None
    settled = current is not None and not pending
    mentioned = list(positive) + pending
    latest = current if settled else (max(mentioned) if mentioned else None)
    return {"latest": latest, "current": current, "converged": settled}


def compact_static_pod_revision(operator_doc):
    """Return the latest static-pod revision and whether every node is on it."""
    status = (operator_doc or {}).get("status") or {}
    latest = status.get("latestAvailableRevision")
    nodes = status.get("nodeStatuses") or []
    if isinstance(latest, int) and len(nodes) >= len(COMPACT_ROLES):
        converged = all(
            node.get("currentRevision") == latest and node.get("targetRevision", latest) == latest
            for node in nodes
        )
        return {"latest": latest, "current": latest if converged else None, "converged": converged}
    messages = [
        condition.get("message") or ""
        for condition in status.get("conditions") or []
        if condition.get("type") in ("Progressing", "Available")
    ]
    return compact_revision_from_text(" ".join(messages))


def compact_static_pod_nodes_newer_than(operator_doc, baseline):
    """Return whether every compact master serves a revision newer than baseline."""
    if not _revision_int(baseline):
        return False
    status = (operator_doc or {}).get("status") or {}
    nodes = status.get("nodeStatuses") or []
    current_revisions = []
    if nodes:
        by_name = {
            node.get("nodeName"): node.get("currentRevision")
            for node in nodes if isinstance(node, dict)
        }
        named_nodes = any(node.get("nodeName") for node in nodes if isinstance(node, dict))
        if named_nodes and all(role in by_name for role in COMPACT_ROLES):
            current_revisions = [by_name[role] for role in COMPACT_ROLES]
        elif not named_nodes and len(nodes) == len(COMPACT_ROLES):
            current_revisions = [
                node.get("currentRevision") if isinstance(node, dict) else None
                for node in nodes
            ]
    else:
        conditions = {
            condition.get("type"): condition.get("message") or ""
            for condition in status.get("conditions") or []
            if isinstance(condition, dict)
        }
        # ClusterOperator status is the available source on OpenShift 4.22.
        # Prefer Progressing because it names current and pending revisions;
        # Available is a fallback for versions with less detailed messages.
        for condition_type in ("Progressing", "Available"):
            totals = {}
            seen = set()
            for match in re.finditer(
                r"(\d+) nodes? (are at revision|is at revision|have achieved new revision) (\d+)",
                conditions.get(condition_type, ""),
                re.I,
            ):
                count, kind, revision = int(match.group(1)), match.group(2).lower(), int(match.group(3))
                if "achieved" in kind:
                    continue
                token = (count, revision)
                if token in seen:
                    continue
                seen.add(token)
                totals[revision] = totals.get(revision, 0) + count
            if sum(totals.values()) == len(COMPACT_ROLES):
                current_revisions = [
                    revision for revision, count in sorted(totals.items())
                    for _ in range(count)
                ]
                break
    return (
        len(current_revisions) == len(COMPACT_ROLES)
        and all(_revision_int(revision) and revision > baseline for revision in current_revisions)
    )


def compact_kube_apiserver_nodes_ready_for_install(operator_doc, baseline):
    """Allow a remaining API revision rollout only with all serving masters advanced."""
    if not compact_static_pod_nodes_newer_than(operator_doc, baseline):
        return False
    conditions = {
        condition.get("type"): condition.get("status")
        for condition in ((operator_doc or {}).get("status") or {}).get("conditions") or []
        if isinstance(condition, dict)
    }
    return conditions.get("Available") == "True" and conditions.get("Degraded") == "False"


def compact_static_pod_rollout_ready(revision, baseline):
    """Require every node on a revision newer than the saved pre-rollout baseline."""
    if not revision or not revision.get("converged") or not _revision_int(revision.get("latest")):
        return False
    if not _revision_int(baseline) or revision["latest"] <= baseline:
        return False
    return True


def compact_install_blockers(unhealthy):
    """Return operators that still block a vmaas install. insights is allowed."""
    return [name for name in unhealthy if name in INSTALL_OPERATORS]


def compact_core_blocker_text(raw):
    """Return the progressing and degraded reasons for ClusterOperator JSON."""
    try:
        doc = json.loads(raw)
    except json.JSONDecodeError:
        return ""
    items = doc.get("items") if isinstance(doc, dict) and "items" in doc else [doc]
    lines = []
    for item in items:
        if not isinstance(item, dict):
            continue
        name = ((item.get("metadata") or {}).get("name")) or "unknown"
        for condition in (item.get("status") or {}).get("conditions") or []:
            if condition.get("type") not in ("Progressing", "Degraded") or condition.get("status") != "True":
                continue
            message = " ".join((condition.get("message") or "").split())
            lines.append(f"{name} {condition['type']} {condition.get('reason') or ''} {message}".strip())
    return " | ".join(lines)


def compact_split_operators(unhealthy):
    """Split unhealthy operators into the core gate and the post-boot gate."""
    core = [name for name in unhealthy if name in CORE_OPERATORS]
    post = [name for name in unhealthy if name not in CORE_OPERATORS and name != "insights"]
    return core, post


def compact_readiness_stage(ready, addresses_ok, etcd_started, etcd_pods, leader, core_unhealthy):
    """Name the earliest core condition that is still blocking."""
    if ready < len(COMPACT_ROLES) or not addresses_ok:
        return "nodes"
    if etcd_started < len(COMPACT_ROLES) or etcd_pods < len(COMPACT_ROLES) or not leader or "etcd" in core_unhealthy:
        return "etcd-rollout"
    if core_unhealthy:
        return "core"
    return "core-ready"


def compact_next_stable_samples(stable_samples, stage, auth_ready, domains_ready, install_ready=True):
    """Advance the stability count, or reset it when an install requirement regresses."""
    if stage != "core-ready" or not auth_ready or not domains_ready or not install_ready:
        return 0
    return stable_samples + 1


def compact_health(nodes, etcd_members, operators):
    """Decide whether three ready nodes, etcd, and operators meet the pass bar."""
    ready = sum(1 for node in nodes if node.get("ready"))
    started = sum(1 for member in etcd_members if member.get("started"))
    leader = any(member.get("leader") for member in etcd_members)
    unhealthy = [
        op["name"] for op in operators
        if op.get("available") != "True" or op.get("progressing") != "False" or op.get("degraded") != "False"
    ]
    return {
        "ok": ready == len(COMPACT_ROLES) and started == len(COMPACT_ROLES) and leader and not unhealthy,
        "ready": ready,
        "etcd_started": started,
        "leader": leader,
        "unhealthy_operators": unhealthy,
    }


def build_compact_boot_plan(source, clone_id, subnet, macs, snapshot, crypto_dir, ingress_cn, plan_path):
    """Build the libvirt plan for a compact clone."""
    nodes = compact_node_plan(clone_id, subnet, macs)
    vm_xml = {
        node["role"]: gen_compact_vm_xml(clone_id, node, [f"/var/lib/libvirt/images/{clone_id}-{node['role']}.qcow2"])
        for node in nodes
    }
    return {
        "clone_id": clone_id,
        "subnet": subnet,
        "domain": f"test-infra-cluster-{clone_id}.redhat.com",
        "nodes": nodes,
        "network_xml": gen_compact_network_xml(clone_id, subnet, nodes),
        "vm_xml": vm_xml,
        "restore": compact_etcd_restore_commands(nodes, snapshot, clone_id),
        "recert": recert_compact_commands(source, clone_id, nodes, crypto_dir, ingress_cn, plan_path),
        "heal": compact_heal_plan(
            source, clone_id, nodes, crypto_dir, ingress_cn, plan_path,
            signer_dir=f"{crypto_dir}/csr-signer"),
        "replacements": compact_identity_pairs(source, clone_id, nodes),
        "chrony_wait_stop": list(CHRONY_WAIT_STOP),
    }


def define_compact_libvirt(plan, emulator, machine_type, memory_kib, vcpus):
    """Define the compact libvirt network and three guest domains."""
    clone_id = plan["clone_id"]
    net_path = f"/tmp/net-{clone_id}.xml"
    env.write_file(net_path, plan["network_xml"])
    env.run(f"virsh net-define {shlex.quote(net_path)}")
    for node in plan["nodes"]:
        disks = node.get("disks")
        if isinstance(disks, str):
            disks = [disks]
        if not disks:
            disks = [node.get("disk") or f"/var/lib/libvirt/images/{clone_id}-{node['role']}.qcow2"]
        xml = gen_compact_vm_xml(
            clone_id, node, disks,
            memory_kib=memory_kib, vcpus=vcpus,
            machine_type=machine_type, emulator=emulator)
        path = f"/tmp/vm-{node['domain']}.xml"
        env.write_file(path, xml)
        env.run(f"virsh define {shlex.quote(path)}")


def compact_domain_owned_by_clone(xml, clone_id, role):
    """Check that a named compact guest only uses this clone's disk paths."""
    root = ET.fromstring(xml)
    if root.findtext("name") != f"test-infra-cluster-{clone_id}-{role}":
        return False
    paths = []
    for disk in root.findall("./devices/disk"):
        if disk.get("device") != "disk":
            continue
        source = disk.find("source")
        if source is None:
            return False
        path = source.get("file") or source.get("dev")
        if not path:
            return False
        paths.append(os.path.normpath(path))
    allowed = {
        os.path.normpath(compact_role_disk_dest(clone_id, role, 0)),
        os.path.normpath(compact_role_disk_dest(clone_id, role, 1)),
        os.path.normpath(f"/var/lib/libvirt/images/{clone_id}-{role}.qcow2"),
    }
    return bool(paths) and set(paths).issubset(allowed)


def compact_network_owned_by_clone(xml, clone_id):
    """Check the bridge and fixed node leases before removing a compact network."""
    root = ET.fromstring(xml)
    if root.findtext("name") != f"test-infra-net-{clone_id}":
        return False
    bridge = root.find("bridge")
    if bridge is None or bridge.get("name") != compact_bridge_name(clone_id):
        return False
    try:
        hosts = parse_dhcp_hosts(xml)
    except ValueError:
        return False
    gateway = root.find(".//ip[@family='ipv4']")
    if gateway is None:
        gateway = root.find(".//ip")
    if gateway is None or not gateway.get("address"):
        return False
    try:
        gateway_ip = ipaddress.ip_address(gateway.get("address"))
    except ValueError:
        return False
    if not isinstance(gateway_ip, ipaddress.IPv4Address):
        return False
    subnet = str(gateway_ip).split(".")[2]
    expected = {
        (f"test-infra-cluster-{clone_id}-{role}", f"192.168.{subnet}.{suffix}")
        for role, suffix in zip(COMPACT_ROLES, COMPACT_NODE_SUFFIXES)
    }
    present = {(host.get("name"), host.get("ip")) for host in hosts}
    return len(expected) == len(COMPACT_ROLES) and expected.issubset(present)


def require_compact_libvirt_ownership(clone_id):
    """Refuse cleanup if a clone's recorded libvirt names point elsewhere."""
    names = env.run("virsh list --all --name", check=False)
    if names.returncode != 0:
        sys.exit("Could not inspect compact clone domains before destroy")
    domains = set(names.stdout.split())
    for role in COMPACT_ROLES:
        name = f"test-infra-cluster-{clone_id}-{role}"
        if name not in domains:
            continue
        xml = env.run(f"virsh dumpxml {shlex.quote(name)}", check=False)
        if xml.returncode != 0 or not compact_domain_owned_by_clone(xml.stdout, clone_id, role):
            sys.exit(f"Refusing to destroy {name}: its disk ownership does not match clone '{clone_id}'")

    networks = env.run("virsh net-list --all --name", check=False)
    if networks.returncode != 0:
        sys.exit("Could not inspect compact clone networks before destroy")
    network = f"test-infra-net-{clone_id}"
    if network in networks.stdout.split():
        xml = env.run(f"virsh net-dumpxml {shlex.quote(network)}", check=False)
        if xml.returncode != 0 or not compact_network_owned_by_clone(xml.stdout, clone_id):
            sys.exit(f"Refusing to destroy network {network}: it does not match clone '{clone_id}'")


def undefine_compact_libvirt(clone_id):
    """Destroy only compact guests and network proven to belong to this clone."""
    require_compact_libvirt_ownership(clone_id)
    for role in COMPACT_ROLES:
        domain = f"test-infra-cluster-{clone_id}-{role}"
        env.run(f"virsh destroy {shlex.quote(domain)}", check=False)
        env.run(f"virsh undefine {shlex.quote(domain)}", check=False)
        env.run(f"rm -f {shlex.quote(compact_role_disk_dest(clone_id, role, 0))}", check=False)
        env.run(f"rm -f {shlex.quote(compact_role_disk_dest(clone_id, role, 1))}", check=False)
    net = f"test-infra-net-{clone_id}"
    env.run(f"virsh net-destroy {shlex.quote(net)}", check=False)
    env.run(f"virsh net-undefine {shlex.quote(net)}", check=False)


def gen_compact_network_xml(clone_id, subnet, nodes):
    """Build libvirt network XML for a compact clone."""
    domain = f"test-infra-cluster-{clone_id}.redhat.com"
    api = f"192.168.{subnet}.{COMPACT_API_SUFFIX}"
    ingress = f"192.168.{subnet}.{COMPACT_INGRESS_SUFFIX}"
    dhcp_hosts = ""
    for node in nodes:
        dhcp_hosts += (
            f"\n              <host mac='{node['mac']}' "
            f"name='{node['domain']}' ip='{node['ip']}'/>"
        )
    bridge = compact_bridge_name(clone_id)
    return textwrap.dedent(f"""\
        <network xmlns:dnsmasq="http://libvirt.org/schemas/network/dnsmasq/1.0">
          <name>test-infra-net-{clone_id}</name>
          <forward mode='nat'><nat><port start='1024' end='65535'/></nat></forward>
          <bridge name='{bridge}' stp='on' delay='0'/>
          <mtu size='1500'/>
          <domain name='{domain}' localOnly='yes'/>
          <dns enable='yes'>
            <host ip='{api}'>
              <hostname>api-int.{domain}</hostname>
              <hostname>api.{domain}</hostname>
