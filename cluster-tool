def _publish_clone_addresses(clone_oc, nodes, pairs):
    """Publish clone addresses on the node, machine, and baremetal host."""
    for node in nodes:
        env.run(
            f"{clone_oc} patch node {shlex.quote(node['role'])} --subresource=status --type=merge "
            f"-p {shlex.quote(json.dumps(compact_node_address_patch(node['ip'])))}",
            check=False)
        env.run(
            f"{clone_oc} annotate node {shlex.quote(node['role'])} "
            f"k8s.ovn.org/node-encap-ips={shlex.quote(json.dumps([node['ip']]))} --overwrite",
            check=False)
    listed = env.run(f"{clone_oc} get nodes -o json", check=False)
    if listed.returncode == 0 and listed.stdout.strip():
        for item in json.loads(listed.stdout).get("items") or []:
            machine = ((item.get("metadata") or {}).get("annotations") or {}).get("machine.openshift.io/machine")
            if not machine or "/" not in machine:
                continue
            namespace, name = machine.split("/", 1)
            body = env.run(
                f"{clone_oc} get machine {shlex.quote(name)} -n {shlex.quote(namespace)} -o json",
                check=False)
            if body.returncode != 0 or not body.stdout.strip():
                continue
            env.run(
                f"{clone_oc} patch machine {shlex.quote(name)} -n {shlex.quote(namespace)} "
                "--subresource=status --type=merge "
                f"-p {shlex.quote(compact_status_address_patch(body.stdout, pairs))}",
                check=False)
    hosts = env.run(f"{clone_oc} get baremetalhosts -n openshift-machine-api -o json", check=False)
    if hosts.returncode == 0 and hosts.stdout.strip():
        for item in json.loads(hosts.stdout).get("items") or []:
            name = item["metadata"]["name"]
            env.run(
                f"{clone_oc} patch baremetalhost {shlex.quote(name)} -n openshift-machine-api "
                "--subresource=status --type=json "
                f"-p {shlex.quote(compact_bmh_hardware_patch(json.dumps(item), pairs))}",
                check=False)


def compact_kubernetes_endpoint_managers(endpoints_raw, slice_raw):
    """Summarize field managers that last wrote the Kubernetes API endpoints."""
    managers = set()
    for raw in (endpoints_raw, slice_raw):
        try:
            doc = json.loads(raw) if isinstance(raw, str) else raw
        except (json.JSONDecodeError, TypeError):
            continue
        if not isinstance(doc, dict):
            continue
        for entry in (doc.get("metadata") or {}).get("managedFields") or []:
            manager = entry.get("manager")
            if manager:
                managers.add(str(manager))
    return ",".join(sorted(managers)) or "unknown"


def compact_kubernetes_endpoint_observation(endpoints_result, slice_result):
    """Distinguish failed/malformed endpoint reads from valid stale resources."""
    errors = []
    for label, result in (
        ("Endpoints", endpoints_result), ("EndpointSlice", slice_result),
    ):
        if result is None or getattr(result, "returncode", 1) != 0:
            detail = str(getattr(result, "stderr", "") or "").strip()
            errors.append(f"{label} read failed" + (f": {detail}" if detail else ""))
            continue
        raw = getattr(result, "stdout", "") or ""
        try:
            doc = json.loads(raw)
        except (json.JSONDecodeError, TypeError):
            errors.append(f"{label} response was not valid JSON")
            continue
        if not isinstance(doc, dict):
            errors.append(f"{label} response was not a JSON object")
            continue
        expected_kind = "Endpoints" if label == "Endpoints" else "EndpointSlice"
        if doc.get("kind") is not None and doc.get("kind") != expected_kind:
            errors.append(f"{label} response kind was not {expected_kind}")
        metadata = doc.get("metadata")
        if metadata is not None and not isinstance(metadata, dict):
            errors.append(f"{label} metadata was not an object")
        list_fields = ("subsets",) if label == "Endpoints" else ("endpoints", "ports")
        object_lists = {}
        for field in list_fields:
            items = doc.get(field)
            if items is None:
                items = []
            if not isinstance(items, list) or any(not isinstance(item, dict) for item in items):
                errors.append(f"{label} {field} was not a list of objects")
                continue
            object_lists[field] = items
        if label == "Endpoints":
            for subset in object_lists.get("subsets", []):
                for field in ("addresses", "notReadyAddresses", "ports"):
                    items = subset.get(field)
                    if items is None:
                        items = []
                    if not isinstance(items, list) or any(
                        not isinstance(item, dict) for item in items
                    ):
                        errors.append(f"Endpoints subset {field} was not a list of objects")
                        continue
                    if field in ("addresses", "notReadyAddresses"):
                        for item in items:
                            if item.get("ip") is not None and not isinstance(item["ip"], str):
                                errors.append(f"Endpoints subset {field} contained a non-string IP")
                    else:
                        for item in items:
                            port_number = item.get("port")
                            protocol = item.get("protocol")
                            if port_number is not None and type(port_number) is not int:
                                errors.append("Endpoints port number was not an integer")
                            if protocol is not None and not isinstance(protocol, str):
                                errors.append("Endpoints protocol was not a string")
        else:
            for endpoint in object_lists.get("endpoints", []):
                addresses = endpoint.get("addresses")
                if addresses is None:
                    addresses = []
                conditions = endpoint.get("conditions")
                if not isinstance(addresses, list) or any(
                    not isinstance(address, str) for address in addresses
                ):
                    errors.append("EndpointSlice endpoint addresses were not a list of strings")
                if conditions is not None and not isinstance(conditions, dict):
                    errors.append("EndpointSlice endpoint conditions were not an object")
            for port in object_lists.get("ports", []):
                port_number = port.get("port")
                protocol = port.get("protocol")
                if port_number is not None and type(port_number) is not int:
                    errors.append("EndpointSlice port number was not an integer")
                if protocol is not None and not isinstance(protocol, str):
                    errors.append("EndpointSlice protocol was not a string")
    return not errors, "; ".join(errors)


def compact_kubernetes_endpoint_missing_resources(endpoints_result, slice_result):
    """Identify controller-managed endpoint resources that returned NotFound."""
    missing = []
    for label, result in (
        ("Endpoints", endpoints_result), ("EndpointSlice", slice_result),
    ):
        if result is None or getattr(result, "returncode", 1) == 0:
            continue
        detail = str(getattr(result, "stderr", "") or "").lower()
        if "not found" in detail or "notfound" in detail:
            missing.append(label)
    return missing


def compact_next_endpoint_repair_failures(previous, observation_valid, identity_ready):
    """Count only consecutive failed repairs, ignoring read failures and recovery."""
    if not observation_valid:
        return previous
    if identity_ready:
        return 0
    return previous + 1


def _compact_https_api_port(port):
    """Whether an endpoint port resolves to the Kubernetes HTTPS port."""
    return (
        isinstance(port, dict)
        and port.get("name") == "https"
        and type(port.get("port")) is int
        and port.get("port") == 6443
        and port.get("protocol") in (None, "TCP")
    )


def compact_kubernetes_endpoints_ready(
    endpoints_raw, slice_raw, node_ips, require_ready=True,
):
    """Check both Kubernetes API endpoint resources against the clone addresses."""
    try:
        endpoints = json.loads(endpoints_raw) if isinstance(endpoints_raw, str) else endpoints_raw
        endpoint_slice = json.loads(slice_raw) if isinstance(slice_raw, str) else slice_raw
    except (json.JSONDecodeError, TypeError):
        return False, "endpoint resources unavailable"
    if not isinstance(endpoints, dict) or not isinstance(endpoint_slice, dict):
        return False, "endpoint resources unavailable"

    expected = {str(ip) for ip in node_ips}
    endpoint_addresses = set()
    endpoint_ready = set()
    endpoint_port_addresses = set()
    endpoint_ready_without_api_port = set()
    for subset in (endpoints.get("subsets") or []):
        ready_addresses = set()
        for address in subset.get("addresses") or []:
            ip = address.get("ip")
            if ip:
                endpoint_addresses.add(str(ip))
                ready_addresses.add(str(ip))
        for address in subset.get("notReadyAddresses") or []:
            ip = address.get("ip")
            if ip:
                endpoint_addresses.add(str(ip))
        subset_addresses = ready_addresses | {
            str(address["ip"])
            for address in subset.get("notReadyAddresses") or []
            if address.get("ip")
        }
        if any(_compact_https_api_port(port) for port in subset.get("ports") or []):
            endpoint_port_addresses.update(subset_addresses)
            endpoint_ready.update(ready_addresses)
        else:
            endpoint_ready_without_api_port.update(ready_addresses)

    slice_addresses = set()
    slice_ready = set()
    for endpoint in (endpoint_slice.get("endpoints") or []):
        addresses = {str(ip) for ip in endpoint.get("addresses") or [] if ip}
        slice_addresses.update(addresses)
        if (endpoint.get("conditions") or {}).get("ready") is True:
            slice_ready.update(addresses)
    slice_port_ready = any(
        _compact_https_api_port(port)
        for port in (endpoint_slice.get("ports") or [])
    )

    stale = sorted((endpoint_addresses | slice_addresses) - expected)
    if stale:
        return False, "stale addresses=" + ",".join(stale)
    if not endpoint_addresses or not slice_addresses:
        return False, "one or both endpoint resources have no addresses"
    if endpoint_addresses != slice_addresses:
        return False, "Endpoints and EndpointSlice address sets differ"
    if endpoint_ready_without_api_port:
        return False, "ready Endpoints subset lacks HTTPS/TCP/6443 for addresses=" + ",".join(
            sorted(endpoint_ready_without_api_port))
    if not endpoint_port_addresses:
        return False, "no Endpoints subset maps addresses to HTTPS/TCP/6443"
    if not slice_port_ready:
        return False, "EndpointSlice has no effective HTTPS/TCP/6443 port"
    if require_ready and endpoint_ready != slice_ready:
        return False, "Endpoints and EndpointSlice ready address sets differ"
    if require_ready and (not endpoint_ready or not slice_ready):
        return False, "no ready clone API backend"
    return True, "clone addresses and HTTPS/TCP port 6443 verified"


def _read_compact_kubernetes_endpoints(clone_oc):
    """Read both API service endpoint representations."""
    endpoints = env.run(
        f"{clone_oc} get endpoints kubernetes -n default -o json", check=False)
    endpoint_slice = env.run(
        f"{clone_oc} get endpointslice kubernetes -n default -o json", check=False)
    return endpoints, endpoint_slice


def _refresh_compact_kubernetes_endpoints(
    clone_oc, nodes, work, timeout_seconds=180,
):
    """Converge both Kubernetes API endpoint resources on healthy clone masters."""
    node_ips = [node["ip"] for node in nodes]
    deadline = time.monotonic() + timeout_seconds
    last_detail = "endpoint resources were not readable"
    endpoints = endpoint_slice = None
    endpoint_raw = slice_raw = ""
    unsupported_endpoint_missing = False
    while time.monotonic() < deadline:
        endpoints, endpoint_slice = _read_compact_kubernetes_endpoints(clone_oc)
        readable, read_detail = compact_kubernetes_endpoint_observation(
            endpoints, endpoint_slice)
        if readable:
            endpoint_raw = endpoints.stdout or ""
            slice_raw = endpoint_slice.stdout or ""
            break
        last_detail = read_detail
        missing_resources = compact_kubernetes_endpoint_missing_resources(
            endpoints, endpoint_slice)
        unsupported_endpoint_missing = bool(missing_resources)
        if missing_resources:
            last_detail = (
                f"{' and '.join(missing_resources)} default/kubernetes is missing; "
                "automatic creation is unsupported because it is controller-managed"
            )
        time.sleep(min(5, max(0, deadline - time.monotonic())))
    else:
        managers = compact_kubernetes_endpoint_managers(endpoint_raw, slice_raw)
        _clone_log(
            work,
            f"Kubernetes endpoint convergence failed ({last_detail}); "
            f"field managers={managers}")
        if unsupported_endpoint_missing:
            sys.exit(f"{last_detail}. Log: {work}/clone.log")
        return None

    identity_ok, detail = compact_kubernetes_endpoints_ready(
        endpoint_raw, slice_raw, node_ips, require_ready=False)
    if identity_ok:
        time.sleep(min(5, max(0, deadline - time.monotonic())))
        verified_endpoints, verified_slice = _read_compact_kubernetes_endpoints(clone_oc)
        readable, read_detail = compact_kubernetes_endpoint_observation(
            verified_endpoints, verified_slice)
        if readable:
            identity_ok, detail = compact_kubernetes_endpoints_ready(
                verified_endpoints.stdout or "", verified_slice.stdout or "", node_ips,
                require_ready=False)
            if identity_ok:
                _clone_log(work, "Kubernetes service endpoints already match clone addresses")
                return True
            endpoint_raw = verified_endpoints.stdout or ""
            slice_raw = verified_slice.stdout or ""
        else:
            detail = read_detail
        _clone_log(
            work,
            f"Kubernetes service endpoint identity changed during stability check ({detail}); repairing")

    last_detail = detail
    last_managers = compact_kubernetes_endpoint_managers(endpoint_raw, slice_raw)
    patch_attempts = 0
    verified_invalid = False
    while time.monotonic() < deadline:
        probes = _in_parallel_results(
            nodes,
            lambda node: env.run(
                f"curl --silent --show-error --fail --insecure --connect-timeout 2 --max-time 6 "
                f"--output /dev/null {shlex.quote('https://' + node['ip'] + ':6443/readyz')}",
                check=False),
        )
        healthy = [
            node["ip"] for node, probe in zip(nodes, probes)
            if probe.returncode == 0
        ]
        if not healthy:
            last_detail = "no clone API node passed /readyz yet"
            time.sleep(min(5, max(0, deadline - time.monotonic())))
            continue

        endpoints_patch = {
            "subsets": [{
                "addresses": [{"ip": ip} for ip in healthy],
                "ports": [{"name": "https", "port": 6443, "protocol": "TCP"}],
            }],
        }
        endpoint_patch = env.run(
            f"{clone_oc} patch endpoints kubernetes -n default --type=merge "
            f"-p {shlex.quote(json.dumps(endpoints_patch))}",
            check=False,
        )
        slice_patch = {
            "ports": [{"name": "https", "protocol": "TCP", "port": 6443}],
            "endpoints": [
                {"addresses": [ip], "conditions": {"ready": True}}
                for ip in healthy
            ],
        }
        slice_result = env.run(
            f"{clone_oc} patch endpointslice kubernetes -n default --type=merge "
            f"-p {shlex.quote(json.dumps(slice_patch))}",
            check=False,
        )
        patch_attempts += 1
        verified_endpoints, verified_slice = _read_compact_kubernetes_endpoints(clone_oc)
        readable, read_detail = compact_kubernetes_endpoint_observation(
            verified_endpoints, verified_slice)
        if endpoint_patch.returncode != 0 or slice_result.returncode != 0:
            details = "; ".join(
                text for text in (
                    (endpoint_patch.stderr or "").strip(),
                    (slice_result.stderr or "").strip(),
                ) if text)
            last_detail = "patch failed" + (f": {details}" if details else "")
        if readable:
            ready, last_detail = compact_kubernetes_endpoints_ready(
                verified_endpoints.stdout or "", verified_slice.stdout or "", node_ips)
            if ready:
                time.sleep(min(5, max(0, deadline - time.monotonic())))
                stable_endpoints, stable_slice = _read_compact_kubernetes_endpoints(clone_oc)
                stable_readable, stable_detail = compact_kubernetes_endpoint_observation(
                    stable_endpoints, stable_slice)
                stable = stable_readable and compact_kubernetes_endpoints_ready(
                    stable_endpoints.stdout or "", stable_slice.stdout or "", node_ips)[0]
                if stable:
                    _clone_log(
                        work,
                        "replaced and verified Kubernetes service endpoints with "
                        f"{len(healthy)} healthy clone API address(es)")
                    return True
                last_detail = (
                    compact_kubernetes_endpoints_ready(
                        stable_endpoints.stdout or "", stable_slice.stdout or "", node_ips)[1]
                    if stable_readable else stable_detail)
                verified_invalid = stable_readable
                _clone_log(
                    work,
                    f"Kubernetes endpoint repair did not persist ({last_detail}); "
                    "checking the authoritative node addresses before retrying")
            verified_invalid = True
            last_managers = compact_kubernetes_endpoint_managers(
                verified_endpoints.stdout or "", verified_slice.stdout or "")
            _clone_log(
                work,
                f"Kubernetes endpoint repair was not retained ({last_detail}); "
                f"field managers={last_managers}")
        else:
            last_detail = "endpoint read-back failed: " + read_detail

        if patch_attempts >= 3:
            break
        time.sleep(min(2, max(0, deadline - time.monotonic())))

    _clone_log(
        work,
        f"Kubernetes endpoint convergence failed ({last_detail}); "
        f"field managers={last_managers}")
    return False if verified_invalid else None


def _sync_compact_controllerconfig_identity(clone_oc, clone_id, subnet, work):
    """Align the MCO's embedded Infrastructure and DNS snapshots with the clone."""
    domain = f"test-infra-cluster-{clone_id}.redhat.com"
    api_vip = f"192.168.{subnet}.{COMPACT_API_SUFFIX}"
    live = env.run(f"{clone_oc} get infrastructure cluster -o json", check=False)
    if live.returncode != 0 or not (live.stdout or "").strip():
        sys.exit(
            "Could not read Infrastructure/cluster before MCO render. "
            f"Log: {work}/clone.log")
    try:
        infra = json.loads(live.stdout)
    except json.JSONDecodeError:
        sys.exit(f"Infrastructure/cluster was not valid JSON. Log: {work}/clone.log")
    if not compact_controllerconfig_infra_matches(
        {"spec": {"infra": infra}}, domain, api_vip, subnet):
        sys.exit(
            "Infrastructure/cluster does not contain the clone API identity; "
            f"refusing to change the MCO ControllerConfig. Log: {work}/clone.log")

    live_dns = env.run(f"{clone_oc} get dns.config.openshift.io cluster -o json", check=False)
    if live_dns.returncode != 0 or not (live_dns.stdout or "").strip():
        sys.exit(
            "Could not read DNS/cluster before MCO render. "
            f"Log: {work}/clone.log")
    try:
        dns = json.loads(live_dns.stdout)
    except json.JSONDecodeError:
        sys.exit(f"DNS/cluster was not valid JSON. Log: {work}/clone.log")
    if ((dns.get("spec") or {}).get("baseDomain") != domain):
        sys.exit(
            "DNS/cluster does not contain the clone base domain; "
            f"refusing to change the MCO ControllerConfig. Log: {work}/clone.log")

    current = env.run(
        f"{clone_oc} get controllerconfig machine-config-controller -o json", check=False)
    if current.returncode != 0 or not (current.stdout or "").strip():
        sys.exit(
            "Could not read the MCO ControllerConfig before render. "
            f"Log: {work}/clone.log")
    infra_matches = compact_controllerconfig_infra_matches(
        current.stdout, domain, api_vip, subnet)
    dns_matches = compact_controllerconfig_dns_matches(current.stdout, dns, domain)
    if infra_matches and dns_matches:
        _clone_log(work, "MCO ControllerConfig already has clone Infrastructure and DNS identity")
        return

    patch_spec = {}
    embedded_infra = {
        key: infra[key] for key in ("apiVersion", "kind", "spec", "status")
        if key in infra
    }
    embedded_dns = {
        key: dns[key] for key in ("apiVersion", "kind", "spec", "status")
        if key in dns
    }
    if not infra_matches:
        patch_spec["infra"] = embedded_infra
    if not dns_matches:
        patch_spec["dns"] = embedded_dns
    patch_path = f"{work}/controllerconfig-identity.json"
    env.write_file(patch_path, json.dumps({"spec": patch_spec}))
    patched = env.run(
        f"{clone_oc} patch controllerconfig machine-config-controller --type=merge "
        f"--patch-file {shlex.quote(patch_path)}", check=False)
    if patched.returncode != 0:
        detail = (patched.stderr or "").strip()
        sys.exit(
            "Could not align MCO ControllerConfig with Infrastructure/cluster"
            + (f": {detail}" if detail else "")
            + f". Log: {work}/clone.log")
    verified = env.run(
        f"{clone_oc} get controllerconfig machine-config-controller -o json", check=False)
    if (verified.returncode != 0 or not (verified.stdout or "").strip()
            or not compact_controllerconfig_infra_matches(
                verified.stdout, domain, api_vip, subnet)
            or not compact_controllerconfig_dns_matches(
                verified.stdout, dns, domain)):
        sys.exit(
            "MCO ControllerConfig did not retain clone Infrastructure and DNS identity. "
            f"Log: {work}/clone.log")
    _clone_log(work, "updated MCO ControllerConfig from clone Infrastructure and DNS identity")


def _reschedule_compact_mco_controller_from_unready_node(clone_oc, work, attempted_uids):
    """Move the MCO controller off a NotReady node so it can render the clone config."""
    pods_result = env.run(
        f"{clone_oc} get pods -n openshift-machine-config-operator "
        "-l k8s-app=machine-config-controller -o json", check=False)
    nodes_result = env.run(f"{clone_oc} get nodes -o json", check=False)
    if (pods_result.returncode != 0 or nodes_result.returncode != 0
            or not (pods_result.stdout or "").strip()
            or not (nodes_result.stdout or "").strip()):
        return
    try:
        pods = json.loads(pods_result.stdout).get("items", [])
        nodes = json.loads(nodes_result.stdout).get("items", [])
    except (json.JSONDecodeError, AttributeError, TypeError):
        return

    node_ready = {}
    for node in nodes:
        name = (node.get("metadata") or {}).get("name")
        ready = next((condition for condition in (node.get("status") or {}).get("conditions", [])
                      if condition.get("type") == "Ready"), {})
        if name:
            node_ready[name] = ready.get("status") == "True"
    if not any(node_ready.values()):
        return

    active_pods = [pod for pod in pods
                   if not (pod.get("metadata") or {}).get("deletionTimestamp")]
    # A replacement already scheduled on a healthy node can make progress; do
    # not evict another replica while it starts.
    if any(node_ready.get((pod.get("spec") or {}).get("nodeName")) is True
           for pod in active_pods):
        return

    for pod in active_pods:
        metadata = pod.get("metadata") or {}
        node_name = (pod.get("spec") or {}).get("nodeName")
        uid = metadata.get("uid")
        name = metadata.get("name")
        if (not name or not uid or uid in attempted_uids or not node_name
                or node_ready.get(node_name) is not False):
            continue
        attempted_uids.add(uid)
        _clone_log(
            work,
            f"MCO controller pod {name} is stranded on NotReady node {node_name}; "
            "conditionally rescheduling it on a Ready node")
        resource_path = (
            "/api/v1/namespaces/openshift-machine-config-operator/pods/"
            f"{urllib.parse.quote(name, safe='')}"
        )
        deleted = env.run(
            compact_kubernetes_delete_proxy_script(
                clone_oc, resource_path, {"uid": str(uid)}),
            check=False)
        if deleted.returncode == 0:
            _clone_log(work, f"requested reschedule of MCO controller pod {name}")
        else:
            detail = (deleted.stderr or deleted.stdout or "conditional delete did not apply").strip()
            _clone_log(work, f"MCO controller pod reschedule was not applied ({detail})")
        return


def _wait_compact_machineconfig_source(clone_oc, clone_id, subnet, work, timeout_seconds=600):
    """Wait for the MCO-owned ControllerConfig to generate clone-specific 00-master."""
    domain = f"test-infra-cluster-{clone_id}.redhat.com"
    api_vip = f"192.168.{subnet}.{COMPACT_API_SUFFIX}"
    dns_result = env.run(
        f"{clone_oc} get dns.config.openshift.io cluster -o json", check=False)
    if dns_result.returncode != 0 or not (dns_result.stdout or "").strip():
        sys.exit(
            "Could not read DNS/cluster while waiting for clone-specific MCO inputs. "
            f"Log: {work}/clone.log")
    try:
        expected_dns = json.loads(dns_result.stdout)
    except json.JSONDecodeError:
        sys.exit(f"DNS/cluster was not valid JSON. Log: {work}/clone.log")
    if (expected_dns.get("spec") or {}).get("baseDomain") != domain:
        sys.exit(
            "DNS/cluster does not contain the clone base domain while waiting for MCO inputs. "
            f"Log: {work}/clone.log")
    started = time.monotonic()
    deadline = started + timeout_seconds
    next_status_log = started + 30
    next_controller_check = started
    attempted_controller_uids = set()
    last_detail = "MCO source objects were not readable"
    while time.monotonic() < deadline:
        controller = env.run(
            f"{clone_oc} get controllerconfig machine-config-controller -o json", check=False)
        machineconfig = env.run(
            f"{clone_oc} get machineconfig 00-master -o json", check=False)
        if (controller.returncode == 0 and machineconfig.returncode == 0
                and (controller.stdout or "").strip()
                and (machineconfig.stdout or "").strip()):
            controller_infra_ready = compact_controllerconfig_infra_matches(
                controller.stdout, domain, api_vip, subnet)
            controller_dns_ready = compact_controllerconfig_dns_matches(
                controller.stdout, expected_dns, domain)
            machineconfig_ready = compact_machineconfig_input_has_clone_identity(
                machineconfig.stdout, domain)
            if controller_infra_ready and controller_dns_ready and machineconfig_ready:
                _clone_log(work, "MCO ControllerConfig generated clone-specific 00-master")
                return
            now = time.monotonic()
            if (controller_infra_ready and controller_dns_ready and not machineconfig_ready
                    and now >= next_controller_check):
                _reschedule_compact_mco_controller_from_unready_node(
                    clone_oc, work, attempted_controller_uids)
                next_controller_check = now + 10
            last_detail = (
                f"ControllerConfig Infrastructure={'ready' if controller_infra_ready else 'pending'}, "
                f"DNS={'ready' if controller_dns_ready else 'pending'}, "
                f"00-master clone API/CoreDNS identity={'ready' if machineconfig_ready else 'pending'}")
        else:
            errors = "; ".join(
                detail for detail in (
                    (controller.stderr or "").strip(),
                    (machineconfig.stderr or "").strip(),
                ) if detail)
            last_detail = errors or "MCO source objects were not readable"
        now = time.monotonic()
        if now >= next_status_log:
            _clone_log(
                work,
                "waiting for clone-specific MCO inputs "
                f"(elapsed={int(now - started)}s; {last_detail})")
            next_status_log = now + 30
        time.sleep(min(2, max(0, deadline - now)))
    sys.exit(
        f"Timed out after {timeout_seconds} seconds waiting for clone-specific MCO inputs "
        f"({last_detail}). Log: {work}/clone.log")


def _wait_master_render(clone_oc, previous_render, clone_domain, work):
    """Wait for two observations of the same new render with complete clone identity."""
    if not previous_render:
        sys.exit("Cannot wait for a new master render without the previous MCP render name")
    render_oc = clone_oc.replace("--request-timeout=40s", "--request-timeout=5s")
    deadline = time.monotonic() + 180
    current_render = ""
    last_error = ""
    last_candidate = ""
    last_valid_render = ""
    valid_observations = 0
    last_logged_observation = None
    last_identity_detail = "no new render observed"
    next_status_log = time.monotonic() + 30
    # Certificate recovery runs in parallel. Keep failed API probes short while
    # the static pods restart, and ignore intermediate renders that combine
    # clone API identity with the source cluster's CoreDNS template.
    while time.monotonic() < deadline:
        result = env.run(
            f"{render_oc} get mcp master -o jsonpath='{{.spec.configuration.name}}'",
            check=False)
        current_render = (result.stdout or "").strip()
        last_error = (result.stderr or "").strip()
        rendered = compact_new_rendered_master(previous_render, current_render)
        if not rendered:
            last_candidate = ""
            last_valid_render = ""
            valid_observations = 0
            if result.returncode != 0:
                last_identity_detail = last_error or "MCP desired render unavailable"
        else:
            if rendered != last_candidate:
                last_candidate = rendered
                last_valid_render = ""
                valid_observations = 0
            candidate = env.run(
                f"{render_oc} get machineconfig {shlex.quote(rendered)} -o json",
                check=False)
            if candidate.returncode != 0 or not (candidate.stdout or "").strip():
                last_valid_render = ""
                valid_observations = 0
                last_identity_detail = (candidate.stderr or "").strip() or "render object unavailable"
            else:
                name, _api_url, identity_errors = _compact_machineconfig_identity(
                    candidate.stdout, clone_domain)
                if name != rendered:
                    identity_errors.append(f"object name does not match MCP render {rendered}")
                if identity_errors:
                    last_valid_render = ""
                    valid_observations = 0
                    last_identity_detail = "; ".join(identity_errors)
                else:
                    last_identity_detail = "clone API and CoreDNS identity verified"
                    if rendered == last_valid_render:
                        valid_observations += 1
                    else:
                        last_valid_render = rendered
                        valid_observations = 1
                    if valid_observations >= 2:
                        _clone_log(
                            work,
                            f"accepted stable clone-specific master render {rendered} "
                            "after two identity checks")
                        return rendered

        observation = (rendered, last_identity_detail)
        now = time.monotonic()
        if observation != last_logged_observation or now >= next_status_log:
            if rendered:
                _clone_log(
                    work,
                    f"waiting for a stable clone-specific MCO render {rendered}: "
                    f"{last_identity_detail}; valid-observations={valid_observations}/2")
            elif result.returncode != 0:
                _clone_log(work, f"waiting for MCO render: {last_identity_detail}")
            last_logged_observation = observation
            next_status_log = now + 30
        time.sleep(min(2, max(0, deadline - time.monotonic())))
    error_detail = f"; last error: {last_error}" if last_error else ""
    sys.exit(
        "Timed out after 180 seconds waiting for a stable new master MachineConfig "
        "render with complete clone API/CoreDNS identity "
        f"(previous={previous_render}, current={current_render or 'unavailable'}, "
        f"identity={last_identity_detail}"
        f"{error_detail}).")


def _finish_compact_clone(
    source, clone_id, nodes, identity, work, crypto, etcd_image, ingress_cn,
    plan_path, by_role, api_ip, src_kc, pairs, start_at=None, pull_secret=None,
):
    """Finish certificate heal, identity rewrite, and the compact health wait."""
    etcd_revision_baseline = None
    apiserver_revision_baseline = None
    domain = f"test-infra-cluster-{clone_id}.redhat.com"
    subnet = int(nodes[0]["ip"].split(".")[2])
    api_vip = f"192.168.{subnet}.{COMPACT_API_SUFFIX}"
    desired_master_render = ""
    expected_api_url = ""
    _clone_log(work, "remove stale source API-server leases from clone etcd")
    _clear_compact_stale_master_leases(nodes, identity, etcd_image, work)
    if start_at == "health":
        loaded = _load_revision_baselines(work)
        if loaded is None:
            sys.exit(
                "Refusing to resume the health check without saved etcd and "
                f"kube-apiserver revision baselines. Log: {work}/clone.log")
        etcd_revision_baseline, apiserver_revision_baseline = loaded
        saved_render = env.run(f"cat {shlex.quote(work + '/currentconfig.json')}", check=False)
        if saved_render.returncode != 0 or not (saved_render.stdout or "").strip():
            sys.exit(
                "Refusing to resume the health check without the desired master render. "
                f"Log: {work}/clone.log")
        desired_master_render, expected_api_url = compact_machineconfig_identity(
            saved_render.stdout, domain)
        _clone_log(
            work,
            "resume at the health check from etcd revision "
            f"{etcd_revision_baseline} and kube-apiserver revision {apiserver_revision_baseline}")
    elif start_at == "rewrite":
        _clone_log(work, "resume after the Recert commit; rewriting cluster records")
    else:
        _clone_log(work, "run Recert once on master-0-0")
        recert_node = by_role[RECERT_ROLE]
        _vm(recert_node["ip"], compact_stop_workloads_script(), identity)
        _vm(recert_node["ip"], compact_stash_historical_certs_script(), identity)
        peers = [by_role[role]["ip"] for role in COMPACT_ROLES if role != RECERT_ROLE]
        _vm(recert_node["ip"], "sudo podman rm -f etcd-proxy recert >/dev/null 2>&1 || true", identity, check=False)
        _vm(recert_node["ip"], "sudo mkdir -p /var/tmp/recert-crypto /var/tmp/recert-out && sudo chown core:core /var/tmp/recert-crypto /var/tmp/recert-out", identity)
        env.run(
            "scp " + " ".join(SSH_OPTS) + f" -i {shlex.quote(identity)} "
            f"{shlex.quote(crypto)}/lb-signer.key {shlex.quote(crypto)}/localhost-signer.key "
            f"{shlex.quote(crypto)}/service-network-signer.key {shlex.quote(crypto)}/ingress.key "
            f"core@{recert_node['ip']}:/var/tmp/recert-crypto/")
        _vm(recert_node["ip"], compact_proxy_command(etcd_image, peers), identity)
        heal = compact_heal_plan(source, clone_id, nodes, "/tmp/crypto", ingress_cn, plan_path, "/tmp/crypto/csr-signer")
        recert = _vm(recert_node["ip"], compact_recert_podman_command(heal["recert_once"]["argv"]), identity, check=False)
        combined = (recert.stdout or "") + (recert.stderr or "")
        summary_hit = _vm(
            recert_node["ip"],
            "sudo grep -a -q 'Expected exactly one node' /var/tmp/recert-out/summary.txt",
            identity, check=False)
        _vm(recert_node["ip"], "sudo chmod 600 /var/tmp/recert-out/summary.txt || true", identity, check=False)
        expected = heal["recert_once"]["expected_error"] in combined or summary_hit.returncode == 0
        _clone_log(work, f"recert exit {recert.returncode} expected_single_node_error={expected}")
        if recert.returncode != 0 and not expected:
            sys.exit(
                f"Recert failed (exit {recert.returncode}) without the expected single-node message. "
                f"It was not run again. Log: {work}/clone.log")
        _vm(recert_node["ip"], "sudo podman rm -f etcd-proxy >/dev/null 2>&1 || true", identity, check=False)
        _clone_log(work, "Recert finished once; copying quorum etcd certificates back to master-0-0")
        quorum = by_role[QUORUM_ETCD_ROLE]
        env.run(
            "umask 077 && ssh " + " ".join(SSH_OPTS) + f" -i {shlex.quote(identity)} core@{quorum['ip']} "
            "'sudo tar -C /etc/kubernetes/static-pod-resources -cf - etcd-certs' "
            f"> {shlex.quote(work + '/etcd-certs-quorum.tar')}")
        env.run(
            "umask 077 && ssh " + " ".join(SSH_OPTS) + f" -i {shlex.quote(identity)} core@{recert_node['ip']} "
            "'sudo tar -C /etc/kubernetes/static-pod-resources -cf - etcd-certs' "
            f"> {shlex.quote(work + '/etcd-certs-node0-recert.tar')}")
        env.run(
            f"chmod 600 {shlex.quote(work + '/etcd-certs-quorum.tar')} "
            f"{shlex.quote(work + '/etcd-certs-node0-recert.tar')}")
        env.run(
            "scp " + " ".join(SSH_OPTS) + f" -i {shlex.quote(identity)} "
            f"{shlex.quote(work + '/etcd-certs-quorum.tar')} core@{recert_node['ip']}:/var/tmp/etcd-certs-quorum.tar")
        _vm(recert_node["ip"],
            "sudo tar -C /etc/kubernetes/static-pod-resources -xf /var/tmp/etcd-certs-quorum.tar && "
            "sudo restorecon -R /etc/kubernetes/static-pod-resources/etcd-certs || true",
            identity)
        _clone_log(work, "restore the original etcd trust onto the Recert apiserver")
        env.run(
            "umask 077 && ssh " + " ".join(SSH_OPTS) + f" -i {shlex.quote(identity)} core@{quorum['ip']} "
            f"{shlex.quote(compact_apiserver_etcd_trust_tar_command())} "
            f"> {shlex.quote(work + '/apiserver-etcd-trust.tar')}")
        env.run(f"chmod 600 {shlex.quote(work + '/apiserver-etcd-trust.tar')}")
        env.run(
            "scp " + " ".join(SSH_OPTS) + f" -i {shlex.quote(identity)} "
            f"{shlex.quote(work + '/apiserver-etcd-trust.tar')} "
            f"core@{recert_node['ip']}:/var/tmp/apiserver-etcd-trust.tar")
        _vm(recert_node["ip"],
            "sudo tar -C / -xf /var/tmp/apiserver-etcd-trust.tar && "
            "sudo restorecon -R /etc/kubernetes/static-pod-resources || true",
            identity)
        _clone_log(work, "restore quorum client CA and service-account keys onto master-0-0")
        env.run(
            "umask 077 && ssh " + " ".join(SSH_OPTS) + f" -i {shlex.quote(identity)} core@{quorum['ip']} "
            f"{shlex.quote(compact_apiserver_client_trust_tar_command())} "
            f"> {shlex.quote(work + '/apiserver-client-trust.tar')}")
        env.run(f"chmod 600 {shlex.quote(work + '/apiserver-client-trust.tar')}")
        env.run(
            "scp " + " ".join(SSH_OPTS) + f" -i {shlex.quote(identity)} "
            f"{shlex.quote(work + '/apiserver-client-trust.tar')} "
            f"core@{recert_node['ip']}:/var/tmp/apiserver-client-trust.tar")
        _vm(recert_node["ip"],
            "sudo tar -C / -xf /var/tmp/apiserver-client-trust.tar && "
            "sudo restorecon -R /etc/kubernetes/static-pod-resources || true",
            identity)
        quorum_digest = _vm(quorum["ip"], compact_client_trust_digest_command(), identity, check=False)
        recert_digest = _vm(recert_node["ip"], compact_client_trust_digest_command(), identity, check=False)
        if (quorum_digest.returncode != 0 or recert_digest.returncode != 0
                or quorum_digest.stdout != recert_digest.stdout):
            sys.exit(
                "master-0-0 client CA, aggregator client, or service-account keys still differ from master-0-1. "
                f"Log: {work}/clone.log")
        _clone_log(work, "start kubelet on master-0-0 so it loads the quorum client CA")
        _vm(recert_node["ip"], compact_start_recert_node_script(), identity, check=False)
        _wait_admin_auth(src_kc, recert_node)
        early_oc = _oc(src_kc, f"https://{api_ip}:6443")
        certs = _require_reissued_etcd_certs(early_oc, nodes, identity, work)
        if _revision_int(certs.get("etcd_revision_baseline")):
            etcd_revision_baseline = certs["etcd_revision_baseline"]
            _store_revision_baseline(work, "etcd", etcd_revision_baseline)
        _sync_requestheader_aggregator_ca(src_kc, api_ip, work, identity, quorum["ip"])

        _clone_log(work, "sign kubelet certificates with the live CSR signer")
        clone_kc = f"{work}/clone.kubeconfig"
        env.run(f"cp {shlex.quote(src_kc)} {shlex.quote(clone_kc)}")
        clone_oc = _oc(clone_kc, f"https://{api_ip}:6443")
        signer = f"{work}/csr-signer"
        env.run(f"mkdir -p {shlex.quote(signer)} && chmod 700 {shlex.quote(signer)}")
        _extract_secret(clone_oc, "openshift-kube-controller-manager-operator", "csr-signer", "tls.crt", f"{signer}/tls.crt")
        _extract_secret(clone_oc, "openshift-kube-controller-manager-operator", "csr-signer", "tls.key", f"{signer}/tls.key")
        for node in nodes:
            script = kubelet_sign_script(node["role"], node["ip"], signer)
            env.write_file(f"{work}/sign-{node['role']}.sh", script)
            env.run(f"cd {shlex.quote(work)} && bash {shlex.quote('sign-' + node['role'] + '.sh')}")
            env.run(
                "scp " + " ".join(SSH_OPTS) + f" -i {shlex.quote(identity)} "
                f"{shlex.quote(work)}/{node['role']}-server.crt {shlex.quote(work)}/{node['role']}-server.key "
                f"{shlex.quote(work)}/{node['role']}-client.crt {shlex.quote(work)}/{node['role']}-client.key "
                f"core@{node['ip']}:/var/tmp/")
            _vm(node["ip"], textwrap.dedent(f"""\
                set -euo pipefail
                sudo bash -c 'cat /var/tmp/{node['role']}-server.crt /var/tmp/{node['role']}-server.key > /var/lib/kubelet/pki/kubelet-server-current.pem'
                sudo bash -c 'cat /var/tmp/{node['role']}-client.crt /var/tmp/{node['role']}-client.key > /var/lib/kubelet/pki/kubelet-client-current.pem'
                sudo chmod 600 /var/lib/kubelet/pki/kubelet-server-current.pem /var/lib/kubelet/pki/kubelet-client-current.pem
                sudo restorecon /var/lib/kubelet/pki/kubelet-server-current.pem /var/lib/kubelet/pki/kubelet-client-current.pem || true
                """), identity)
        _vm(quorum["ip"], "sudo cat /etc/kubernetes/kubelet-ca.crt", identity)
        ca_copy = env.run(
            "ssh " + " ".join(SSH_OPTS) + f" -i {shlex.quote(identity)} core@{quorum['ip']} "
            "'sudo cat /etc/kubernetes/kubelet-ca.crt'")
        env.write_file(f"{work}/kubelet-ca.crt", ca_copy.stdout)
        env.run(
            "scp " + " ".join(SSH_OPTS) + f" -i {shlex.quote(identity)} "
            f"{shlex.quote(work + '/kubelet-ca.crt')} core@{recert_node['ip']}:/var/tmp/kubelet-ca.crt")
        _vm(recert_node["ip"],
            "sudo cp /var/tmp/kubelet-ca.crt /etc/kubernetes/kubelet-ca.crt && sudo restorecon /etc/kubernetes/kubelet-ca.crt || true",
            identity)
        # master-0-0 was started before its freshly signed client certificate
        # was installed. Force kubelet to reload that file so it can register
        # and make the MCO daemonset available before the render handoff.
        _clone_log(work, "restart master-0-0 kubelet after installing its clone client certificate")
        _vm(recert_node["ip"], "sudo systemctl restart kubelet", identity)
        kubelet_ready = env.run(
            f"{clone_oc} wait --for=condition=Ready node/{shlex.quote(recert_node['role'])} "
            "--timeout=120s", check=False)
        if kubelet_ready.returncode != 0:
            detail = (kubelet_ready.stderr or kubelet_ready.stdout or "").strip()
            sys.exit(
                "master-0-0 did not return Ready after its kubelet certificate reload"
                + (f": {detail}" if detail else "")
                + f". Log: {work}/clone.log")
        _clone_log(work, "master-0-0 kubelet is Ready with the clone client certificate")

    clone_kc = f"{work}/clone.kubeconfig"
    if "yes" not in env.run(f"test -f {shlex.quote(clone_kc)} && echo yes || true").stdout:
        env.run(f"cp {shlex.quote(src_kc)} {shlex.quote(clone_kc)}")
    compact_configure_runner_kubeconfig(clone_kc, api_vip, f"api.{domain}")
    clone_oc = _oc(clone_kc, f"https://{api_ip}:6443")
    _clear_expired_mco_controller_lease(clone_oc, work)
    _clone_log(
        work,
        f"prepared runner kubeconfig {clone_kc} server=https://{api_vip}:6443 "
        f"tls-server-name=api.{domain}")
    if start_at != "health":
        apiserver_revision_baseline = _load_revision_baseline(work, "kube-apiserver")
        if start_at == "rewrite" and not _revision_int(apiserver_revision_baseline):
            sys.exit(
                "Cannot safely resume the rewrite without the saved pre-refresh "
                "kube-apiserver revision baseline. Restore it from the flavor snapshot "
                f"before retrying. Log: {work}/clone.log")
        if start_at is None and not _revision_int(apiserver_revision_baseline):
            apiserver_revision_baseline = _operator_latest_revision(
                clone_oc, "kube-apiserver")
            if not _revision_int(apiserver_revision_baseline):
                sys.exit(
                    "kube-apiserver revision baseline is unavailable before "
                    "certificate refresh; refusing to continue. "
                    f"Log: {work}/clone.log")
            _store_revision_baseline(work, "kube-apiserver", apiserver_revision_baseline)
            _clone_log(
                work,
                f"saved pre-refresh kube-apiserver revision baseline "
                f"{apiserver_revision_baseline}")
    if start_at == "rewrite":
        etcd_revision_baseline = _load_revision_baseline(work, "etcd")
        if _revision_int(etcd_revision_baseline):
            # A saved baseline means the first pass already verified the
            # reissued certificate inputs and triggered the etcd rollout.
            # Reapplying them on resume can create another revision while the
            # previous one is still converging.
            _clone_log(
                work,
                "reusing saved etcd revision baseline "
                f"{etcd_revision_baseline}; leaving the existing rollout untouched")
        else:
            certs = _require_reissued_etcd_certs(clone_oc, nodes, identity, work)
            if _revision_int(certs.get("etcd_revision_baseline")):
                etcd_revision_baseline = certs["etcd_revision_baseline"]
                _store_revision_baseline(work, "etcd", etcd_revision_baseline)
    if start_at != "health":
        _clone_log(work, "rewrite cluster records and 00-master")
        previous_mcp = env.run(f"{clone_oc} get mcp master -o json", check=False)
        if previous_mcp.returncode != 0 or not (previous_mcp.stdout or "").strip():
            sys.exit(f"Could not read the master MachineConfigPool before the clone rewrite. Log: {work}/clone.log")
        try:
            previous_mcp_doc = json.loads(previous_mcp.stdout)
        except json.JSONDecodeError:
            sys.exit(f"The master MachineConfigPool response was invalid JSON. Log: {work}/clone.log")
        previous_render = ((previous_mcp_doc.get("status") or {}).get("configuration") or {}).get("name", "")
        previous_desired_render = ((previous_mcp_doc.get("spec") or {}).get("configuration") or {}).get("name", "")
        if not previous_render or not previous_desired_render:
            sys.exit(f"Could not read the current master render before the clone rewrite. Log: {work}/clone.log")

        # Infrastructure is the source for the MCO ControllerConfig and its
        # generated 00-master. Updating 00-master first is not durable: the MCO
        # recreates it from ControllerConfig, which can still contain the flavor
        # identity. Seed and verify those inputs before waiting for a render.
        spec, status = compact_infrastructure_patches(clone_id, subnet)
        for subresource, body in (("", spec), (" --subresource=status", status)):
            patched = env.run(
                f"{clone_oc} patch infrastructure cluster{subresource} --type=merge "
                f"-p {shlex.quote(json.dumps(body))}", check=False)
            if patched.returncode != 0:
                detail = (patched.stderr or "").strip()
                sys.exit(
                    "Could not apply clone Infrastructure identity before MCO render"
                    + (f": {detail}" if detail else "")
                    + f". Log: {work}/clone.log")
        _clone_log(work, "publish clone node addresses before MCO render")
        _publish_clone_addresses(clone_oc, nodes, pairs)
        pre_render_endpoints = _refresh_compact_kubernetes_endpoints(clone_oc, nodes, work)
        if pre_render_endpoints is not True:
            _clone_log(
                work,
                "Kubernetes API endpoints did not stabilize before MCO render; "
                "continuing because the direct node APIs remain available")

        mc = env.run(f"{clone_oc} get machineconfig 00-master -o json", check=False)
        if mc.returncode != 0 or not (mc.stdout or "").strip():
            sys.exit(f"Could not read MachineConfig 00-master before the clone rewrite. Log: {work}/clone.log")
        try:
            mc_doc = json.loads(mc.stdout)
        except json.JSONDecodeError:
            sys.exit(f"MachineConfig 00-master was not valid JSON. Log: {work}/clone.log")
        owner_refs = (mc_doc.get("metadata") or {}).get("ownerReferences") or []
        controllerconfig_owned = any(
            owner.get("kind") == "ControllerConfig" and owner.get("controller") is True
            for owner in owner_refs)
        existing_render_raw = ""
        existing_render_matches = False
        existing_render = env.run(
            f"{clone_oc} get machineconfig {shlex.quote(previous_desired_render)} -o json",
            check=False)
        if existing_render.returncode == 0 and (existing_render.stdout or "").strip():
            existing_render_raw = existing_render.stdout
            existing_render_matches = compact_machineconfig_has_clone_identity(
                existing_render_raw, domain)
        if controllerconfig_owned:
            _clone_log(
                work,
                "00-master is ControllerConfig-managed; waiting for MCO-generated clone identity")
            reuse_existing_render = existing_render_matches
        else:
            rewritten_mc = rewrite_machineconfig(mc.stdout, pairs)
            rewritten_doc = json.loads(rewritten_mc)
            machineconfig_spec_changed = mc_doc.get("spec") != rewritten_doc.get("spec")
            rewritten_mc = compact_ensure_machineconfig_render_change(
                mc.stdout, rewritten_mc, domain,
                existing_render_raw=existing_render_raw if existing_render_matches else None)
            env.write_file(f"{work}/00-master.json", rewritten_mc)
            replaced = env.run(
                f"{clone_oc} replace -f {shlex.quote(work + '/00-master.json')}", check=False)
            if replaced.returncode != 0:
                detail = (replaced.stderr or "").strip()
                sys.exit(f"Could not update MachineConfig 00-master: {detail}. Log: {work}/clone.log")
            reuse_existing_render = not machineconfig_spec_changed and existing_render_matches

        def apply_identity_records():
            def rewrite_object(item):
                kind, namespace, name = item
                raw = env.run(f"{clone_oc} get {kind} {name} -n {namespace} -o json", check=False)
                if raw.returncode != 0:
                    _clone_log(work, f"skip missing {kind} {namespace}/{name}")
                    return
                updated = rewrite_configmap(raw.stdout, pairs) if kind == "configmap" else apply_identity(raw.stdout, pairs)
                dest = f"{work}/{kind}-{name}.json"
                env.write_file(dest, updated)
                env.run(f"{clone_oc} replace -f {shlex.quote(dest)}", check=False)

            _in_parallel(list(HEAL_API_OBJECTS), rewrite_object)
            spec, status = compact_infrastructure_patches(clone_id, subnet)
            env.run(
                f"{clone_oc} patch infrastructure cluster --type=merge -p {shlex.quote(json.dumps(spec))}",
                check=False)
            env.run(
                f"{clone_oc} patch infrastructure cluster --subresource=status --type=merge "
                f"-p {shlex.quote(json.dumps(status))}",
                check=False)

            def rewrite_cm(item):
                namespace, name = item
                raw = env.run(
                    f"{clone_oc} get cm {shlex.quote(name)} -n {shlex.quote(namespace)} -o json",
                    check=False)
                if raw.returncode != 0 or not raw.stdout.strip():
                    _clone_log(work, f"skip missing configmap {namespace}/{name}")
                    return
                dest = f"{work}/cm-{namespace}-{name}.json"
                env.write_file(dest, rewrite_configmap(raw.stdout, pairs))
                env.run(f"{clone_oc} replace -f {shlex.quote(dest)}", check=False)

            _in_parallel(compact_identity_configmaps(clone_oc), rewrite_cm)
            _clone_log(work, "point aggregated apiservers at the clone etcd")
            for namespace, name in HEAL_ETCD_DEPLOYMENTS:
                raw = env.run(
                    f"{clone_oc} get deploy {shlex.quote(name)} -n {shlex.quote(namespace)} -o json",
                    check=False)
                if raw.returncode != 0 or not raw.stdout.strip():
                    _clone_log(work, f"skip missing deployment {namespace}/{name}")
                    continue
                dest = f"{work}/deploy-{namespace}-{name}.json"
                env.write_file(dest, rewrite_deployment(raw.stdout, pairs))
                env.run(f"{clone_oc} replace -f {shlex.quote(dest)}", check=False)
            for namespace in ("openshift-apiserver", "openshift-oauth-apiserver"):
                env.run(
                    f"{clone_oc} delete pod -n {shlex.quote(namespace)} --all --force --grace-period=0",
                    check=False)
            identity_domains = compact_identity_domain_patches(clone_id)
            env.run(
                f"{clone_oc} patch dns.config.openshift.io cluster --type=merge "
                f"-p {shlex.quote(json.dumps(identity_domains['dns']))}",
                check=False)
            _clone_log(work, "set ingress spec.domain to the clone apps domain")
            compact_apply_clone_ingress_domain(clone_oc, clone_id, work)
            _sync_ingress_wildcard(clone_oc, clone_id, work)

        # Let the API identity settle before replacing serving certificates. The
        # pull secret is independent and can be staged alongside those changes.
        preparation_steps = [("identity", apply_identity_records)]
        if pull_secret is not None:
            preparation_steps.append((
                "pull-secret",
                lambda: _inject_compact_pull_secret(clone_oc, work, pull_secret),
            ))
        _call_together(dict(preparation_steps))
        # ControllerConfig embeds snapshots of both cluster-scoped identity
        # resources. Sync it only after apply_identity_records has updated
        # DNS/cluster; otherwise a fresh clone still has the source base domain
        # and the guard correctly refuses to render.
        _sync_compact_controllerconfig_identity(clone_oc, clone_id, subnet, work)

        # Kubelets need the clone internal API certificate to reconnect. The
        # cert-regeneration controller must also be restarted here, before MCO
        # can render, because its process cached the source API identity at start.
        _clone_log(work, "ensure clone API certificates while waiting for MCO render")

        def resolve_master_render():
            if controllerconfig_owned:
                _wait_compact_machineconfig_source(clone_oc, clone_id, subnet, work)
            if reuse_existing_render:
                _clone_log(
                    work,
                    f"reusing clone-specific master render {previous_desired_render} on retry")
                return previous_desired_render, existing_render_raw
            rendered_name = _wait_master_render(
                clone_oc, previous_desired_render, domain, work)
            raw = env.run(
                f"{clone_oc} get machineconfig {shlex.quote(rendered_name)} -o json", check=False)
            if raw.returncode != 0 or not (raw.stdout or "").strip():
                detail = (raw.stderr or "").strip()
                sys.exit(
                    f"Could not read the desired master render {rendered_name}: "
                    f"{detail}. Log: {work}/clone.log")
            return rendered_name, raw.stdout

        parallel_results = _call_together({
            "render": resolve_master_render,
            "api-certificates": lambda: _recover_compact_api_certificates_and_endpoints(
                clone_oc, work, domain, api_ip, nodes, identity, etcd_image),
        })
        rendered, raw_render_text = parallel_results["render"]
        desired_master_render, expected_api_url = compact_machineconfig_identity(
            raw_render_text, domain)
        if desired_master_render != rendered:
            sys.exit(
                f"MCP returned render {rendered}, but the MachineConfig is "
                f"{desired_master_render}. Log: {work}/clone.log")
        env.write_file(f"{work}/currentconfig.json", raw_render_text)
        heal_files = {
            path: body for path, body in rendered_machineconfig_files(raw_render_text).items()
            if path in HEAL_NODE_FILES
        }
        if heal_files.get("/etc/kubernetes/apiserver-url.env") != expected_api_url:
            sys.exit("The desired render is missing the clone API URL file")
        env.write_file(f"{work}/heal-files.json", json.dumps(heal_files))
        env.write_file(f"{work}/apply-heal-files.py", textwrap.dedent("""\
            import json
            import pathlib

            render = json.load(open("/var/tmp/currentconfig.json"))
            target = render.get("metadata", {}).get("name")
            current = json.load(open("/etc/machine-config-daemon/currentconfig"))
            if not target or current.get("metadata", {}).get("name") != target:
                raise SystemExit("currentconfig does not match the desired render")
            files = json.load(open("/var/tmp/heal-files.json"))
            for path, body in files.items():
                pathlib.Path(path).write_text(body)
            for path, body in files.items():
                candidate = pathlib.Path(path)
                if not candidate.is_file() or candidate.read_text() != body:
                    raise SystemExit("rendered file verification failed: " + path)
            """))
        _clone_log(work, "install and verify clone render files before MCD handoff")

        def install_render(node):
            env.run(
                "scp " + " ".join(SSH_OPTS) + f" -i {shlex.quote(identity)} "
                f"{shlex.quote(work + '/currentconfig.json')} {shlex.quote(work + '/heal-files.json')} "
                f"{shlex.quote(work + '/apply-heal-files.py')} "
                f"core@{node['ip']}:/var/tmp/")
            _vm(node["ip"], textwrap.dedent("""\
                set -euo pipefail
                sudo cp /var/tmp/currentconfig.json /etc/machine-config-daemon/currentconfig
                sudo restorecon /etc/machine-config-daemon/currentconfig || true
                sudo python3 /var/tmp/apply-heal-files.py
                """), identity)

        _in_parallel(nodes, install_render)
        node_names = " ".join(shlex.quote(node["role"]) for node in nodes)
        env.run(
            f"{clone_oc} annotate node {node_names} "
            f"machineconfiguration.openshift.io/desiredConfig={shlex.quote(rendered)} "
            f"machineconfiguration.openshift.io/currentConfig={shlex.quote(rendered)} "
            "machineconfiguration.openshift.io/state=Done --overwrite")
        env.run(f"{clone_oc} adm uncordon {node_names}")
    elif pull_secret is not None:
        _inject_compact_pull_secret(clone_oc, work, pull_secret)
        _ensure_api_certificates(clone_oc, work, domain, api_vip, nodes, identity)

    if start_at != "health" or pull_secret is not None:
        _clone_log(work, "rewrite etcd pod manifests laid down by the operator")
        env.write_file(f"{work}/identity-pairs.json", json.dumps(pairs))
        env.write_file(f"{work}/rewrite-identity.py", compact_identity_script())

        def rewrite_node(node):
            env.run(
                "scp " + " ".join(SSH_OPTS) + f" -i {shlex.quote(identity)} "
                f"{shlex.quote(work + '/identity-pairs.json')} {shlex.quote(work + '/rewrite-identity.py')} "
                f"core@{node['ip']}:/var/tmp/")
            _vm(node["ip"], "sudo python3 /var/tmp/rewrite-identity.py", identity, check=False)

        _in_parallel(nodes, rewrite_node)
        _clone_log(work, "publish clone node IPs without restarting kubelet")
        _publish_clone_addresses(clone_oc, nodes, pairs)

        def refresh_node_address(node):
            _vm(node["ip"], "sudo podman rm -f etcd-proxy >/dev/null 2>&1 || true; sudo systemctl stop chrony-wait.service || true", identity, check=False)
            _vm(node["ip"], compact_release_keepalived_script(), identity, check=False)

        _in_parallel(nodes, refresh_node_address)
        apiserver_revision_baseline = _load_revision_baseline(work, "kube-apiserver")
        if not _revision_int(apiserver_revision_baseline):
            sys.exit(
                "Saved kube-apiserver revision baseline is unavailable before "
                f"certificate refresh. Log: {work}/clone.log")
        _clone_log(
            work,
            f"using pre-refresh kube-apiserver revision baseline "
            f"{apiserver_revision_baseline}")
        _refresh_internal_api_certificate(clone_oc, work, domain, api_vip, nodes, identity)
        _clone_log(work, "replace node identity and ovnkube pods that still use the source API")
        _call_together({
            "nni": lambda: env.run(
                f"{clone_oc} delete pod -n openshift-network-node-identity --all --force --grace-period=0",
                check=False),
            "ovn": lambda: env.run(
                f"{clone_oc} delete pod -n openshift-ovn-kubernetes -l app=ovnkube-node --force --grace-period=0",
                check=False),
        })

    if not _refresh_compact_kubernetes_endpoints(clone_oc, nodes, work):
        sys.exit(
            "Could not converge Kubernetes service endpoints on clone API addresses. "
            f"Log: {work}/clone.log")

    if not _revision_int(etcd_revision_baseline) or not _revision_int(apiserver_revision_baseline):
        sys.exit(
            "Refusing to wait for install revisions without an etcd baseline "
            f"({etcd_revision_baseline}) and a kube-apiserver baseline "
            f"({apiserver_revision_baseline}). Log: {work}/clone.log")
    _clone_log(work, "wait until etcd and the API revisions are installed for vmaas")
    deadline = time.time() + 40 * 60
    last = None
    last_auth = "unchecked"
    last_domains = "unchecked"
    last_mco_detail = "unchecked"
    last_api_url_blockers = []
    webhook_confirmed = False
    stable_samples = 0
    last_etcd_sample = None
    last_core_blocker = ""
    last_revision_sample = None
    last_mco_sample = None
    last_mco_node_sample = None
    persistent_mcd_mismatch_signature = None
    persistent_mcd_mismatch_since = None
    last_observe_signature = None
    endpoint_repair_failures = 0
    endpoint_detail = "not observed"
    mcd_addresses_verified = False
    endpoints = ",".join(f"https://{node['ip']}:2379" for node in nodes)
    while time.time() < deadline:
        watched = _call_together({
            "nodes": lambda: env.run(f"{clone_oc} get nodes -o json", check=False),
            "mcp": lambda: env.run(f"{clone_oc} get mcp master -o json", check=False),
            "co": lambda: env.run(f"{clone_oc} get co -o json", check=False),
            "endpoints": lambda: env.run(
                f"{clone_oc} get endpoints kubernetes -n default -o json", check=False),
            "endpoint-slice": lambda: env.run(
                f"{clone_oc} get endpointslice kubernetes -n default -o json", check=False),
        })
        docs = compact_operator_docs(watched["co"].stdout or "")
        operators = compact_operators_from_docs(docs)
        parsed_nodes = compact_parse_node_docs(watched["nodes"].stdout or "")
        mco_node_sample = compact_machine_config_node_observations(parsed_nodes)
        mco_node_signature = tuple(
            tuple(sorted(observation.items())) for observation in mco_node_sample)
        if mco_node_signature != last_mco_node_sample:
            for observation in mco_node_sample:
                if observation.get("missing"):
                    _clone_log(work, f"machine-config node {observation['role']} missing")
                    continue
                _clone_log(
                    work,
                    f"machine-config node {observation['role']} "
                    f"ready={observation['ready']} "
                    f"ready-reason={observation['ready_reason'] or 'none'} "
                    f"ready-transition={observation['ready_transition'] or 'unknown'} "
                    f"unschedulable={observation['unschedulable']} "
                    f"state={observation['state'] or 'unknown'} "
                    f"current={observation['current'] or 'unknown'} "
                    f"desired={observation['desired'] or 'unknown'} "
                    f"mcd-reason={observation['reason'] or 'none'} "
                    f"ready-message={observation['ready_message'] or 'none'}")
            last_mco_node_sample = mco_node_signature
        addresses_ok = compact_node_ips_ready(parsed_nodes, nodes)
        ready = sum(1 for node in parsed_nodes if node.get("ready"))
        if ready == len(nodes) and addresses_ok and not mcd_addresses_verified:
            _clone_log(
                work,
                "refresh machine-config-daemon host addresses after all clone nodes are Ready")
            _ensure_compact_mcd_pod_addresses(clone_oc, nodes, work)
            mcd_addresses_verified = True
        etcd_revision = compact_static_pod_revision(docs.get("etcd"))
        apiserver_revision = compact_static_pod_revision(docs.get("kube-apiserver"))
        apiserver_nodes_newer = compact_static_pod_nodes_newer_than(
            docs.get("kube-apiserver"), apiserver_revision_baseline)
        apiserver_progress_allowed = compact_kube_apiserver_nodes_ready_for_install(
            docs.get("kube-apiserver"), apiserver_revision_baseline)
        unhealthy = [
            op["name"] for op in operators
            if op.get("available") != "True" or op.get("progressing") != "False" or op.get("degraded") != "False"
        ]
        if apiserver_progress_allowed:
            # A rolling latest revision is safe to finish in the background once
            # each master already serves a revision newer than the saved flavor
            # baseline. Availability, degradation, per-node revision, and API
            # endpoint checks remain part of the install-ready gate.
            unhealthy = [name for name in unhealthy if name != "kube-apiserver"]
        core_unhealthy, post_unhealthy = compact_split_operators(unhealthy)
        install_blockers = compact_install_blockers(unhealthy)
        revisions_ready = (
            compact_static_pod_rollout_ready(etcd_revision, etcd_revision_baseline)
            and apiserver_progress_allowed
        )
        machine_config_ready, machine_config_detail, observed_master_render = (
            compact_machine_config_observation(watched["mcp"].stdout or "", parsed_nodes))
        mismatched_mcd_nodes = [
            observation for observation in mco_node_sample
            if not observation.get("missing")
            and observation.get("state") == "Degraded"
            and "content mismatch for file" in observation.get("reason", "")
        ]
        if len(mismatched_mcd_nodes) == len(COMPACT_ROLES):
            mismatch_signature = tuple(
                (observation["role"], observation["reason"])
                for observation in mismatched_mcd_nodes)
            if mismatch_signature != persistent_mcd_mismatch_signature:
                persistent_mcd_mismatch_signature = mismatch_signature
                persistent_mcd_mismatch_since = time.monotonic()
                _clone_log(
                    work,
                    "all three MCDs report rendered-file content mismatch; "
                    "starting a five-minute persistence check")
            mismatch_elapsed = time.monotonic() - persistent_mcd_mismatch_since
            if mismatch_elapsed >= 300:
                details = "; ".join(
                    f"{observation['role']}: {observation['reason']}"
                    for observation in mismatched_mcd_nodes)
                sys.exit(
                    "All three Machine Config Daemons have continuously reported "
                    "rendered-file content mismatch for at least five minutes; "
                    f"refusing to wait out the full install-readiness timeout ({details}). "
                    f"Log: {work}/clone.log")
        else:
            persistent_mcd_mismatch_signature = None
            persistent_mcd_mismatch_since = None
        endpoint_reads_valid, endpoint_read_detail = compact_kubernetes_endpoint_observation(
            watched["endpoints"], watched["endpoint-slice"])
        endpoint_ready = False
        if not endpoint_reads_valid:
            endpoint_detail = "endpoint observation unavailable: " + endpoint_read_detail
        else:
            endpoint_ready, endpoint_detail = compact_kubernetes_endpoints_ready(
                watched["endpoints"].stdout or "",
                watched["endpoint-slice"].stdout or "",
                [node["ip"] for node in nodes],
            )
            endpoint_identity_ready, endpoint_identity_detail = compact_kubernetes_endpoints_ready(
                watched["endpoints"].stdout or "",
                watched["endpoint-slice"].stdout or "",
                [node["ip"] for node in nodes],
                require_ready=False,
            )
            if endpoint_identity_ready:
                # Only a valid, identity-correct observation resets the
                # consecutive repair-failure budget. Failed reads neither
                # count as drift nor erase evidence of a failed repair.
                endpoint_repair_failures = compact_next_endpoint_repair_failures(
                    endpoint_repair_failures, True, True)
            else:
                managers = compact_kubernetes_endpoint_managers(
                    watched["endpoints"].stdout or "",
                    watched["endpoint-slice"].stdout or "",
                )
                _clone_log(
                    work,
                    f"Kubernetes endpoint identity drift ({endpoint_identity_detail}); "
                    f"field managers={managers}; attempting repair")
                repaired = _refresh_compact_kubernetes_endpoints(
                    clone_oc, nodes, work, timeout_seconds=30)
                if repaired is True:
                    checked_endpoints, checked_slice = _read_compact_kubernetes_endpoints(clone_oc)
                    checked_valid, checked_detail = compact_kubernetes_endpoint_observation(
                        checked_endpoints, checked_slice)
                    if checked_valid:
                        endpoint_ready, endpoint_detail = compact_kubernetes_endpoints_ready(
                            checked_endpoints.stdout or "",
                            checked_slice.stdout or "",
                            [node["ip"] for node in nodes],
                        )
                        endpoint_identity_ready, endpoint_identity_detail = compact_kubernetes_endpoints_ready(
                            checked_endpoints.stdout or "",
                            checked_slice.stdout or "",
                            [node["ip"] for node in nodes],
                            require_ready=False,
                        )
                        endpoint_repair_failures = compact_next_endpoint_repair_failures(
                            endpoint_repair_failures, True, endpoint_identity_ready)
                        if not endpoint_identity_ready:
                            endpoint_detail = endpoint_identity_detail
                    else:
                        endpoint_detail = "endpoint read-back unavailable: " + checked_detail
                elif repaired is False:
                    endpoint_repair_failures = compact_next_endpoint_repair_failures(
                        endpoint_repair_failures, True, False)
                else:
                    endpoint_detail = "endpoint repair observation unavailable; retrying"
                if endpoint_repair_failures >= 3:
                    managers = compact_kubernetes_endpoint_managers(
                        watched["endpoints"].stdout or "",
                        watched["endpoint-slice"].stdout or "",
                    )
                    sys.exit(
                        "Kubernetes API endpoint repair failed three consecutive times; "
                        f"field managers={managers}; last state={endpoint_detail}. "
                        f"Log: {work}/clone.log")
        if observed_master_render and observed_master_render != desired_master_render:
            current_render = env.run(
                f"{clone_oc} get machineconfig {shlex.quote(observed_master_render)} -o json",
                check=False)
            if current_render.returncode != 0 or not (current_render.stdout or "").strip():
                machine_config_ready = False
                machine_config_detail += f" desired render {observed_master_render} unavailable"
            else:
                candidate_name, candidate_api_url, identity_errors = (
                    _compact_machineconfig_identity(current_render.stdout, domain))
                if candidate_name != observed_master_render:
                    identity_errors.append(
                        f"object name does not match MCP render {observed_master_render}")
                if identity_errors:
                    machine_config_ready = False
                    machine_config_detail += (
                        f" desired render {observed_master_render} has invalid clone identity: "
                        + "; ".join(identity_errors))
                else:
                    desired_master_render = candidate_name
                    expected_api_url = candidate_api_url
        last_mco_detail = machine_config_detail
        mco_sample = (machine_config_ready, machine_config_detail)
        if mco_sample != last_mco_sample:
            _clone_log(
                work,
                f"machine-config ready={machine_config_ready} {machine_config_detail}")
            last_mco_sample = mco_sample
        if not endpoint_ready:
            _clone_log(work, f"Kubernetes API endpoints not ready: {endpoint_detail}")
        revision_sample = (
            etcd_revision.get("latest"), etcd_revision.get("converged"),
            apiserver_revision.get("latest"), apiserver_revision.get("converged"),
            apiserver_nodes_newer,
        )
        if revision_sample != last_revision_sample:
            _clone_log(
                work,
                f"install revisions etcd={etcd_revision.get('latest')}/{etcd_revision_baseline} "
                f"converged={etcd_revision.get('converged')} "
                f"kube-apiserver={apiserver_revision.get('latest')}/{apiserver_revision_baseline} "
                f"converged={apiserver_revision.get('converged')} "
                f"all-nodes-newer={apiserver_nodes_newer} "
                f"install-available={apiserver_progress_allowed}")
            last_revision_sample = revision_sample
        if core_unhealthy or install_blockers:
            blocker = compact_core_blocker_text(json.dumps({
                "items": [docs[name] for name in dict.fromkeys(core_unhealthy + install_blockers) if name in docs],
            }))
            if blocker and blocker != last_core_blocker:
                _clone_log(work, f"core blocker {blocker}")
                last_core_blocker = blocker
        else:
            last_core_blocker = ""
        if not compact_install_observation_ready(
            ready, addresses_ok, core_unhealthy, install_blockers, revisions_ready,
            machine_config_ready, endpoint_ready,
        ) or not mcd_addresses_verified:
            stable_samples = 0
            if webhook_confirmed:
                _set_node_identity_webhook(clone_oc, "Ignore")
                webhook_confirmed = False
            signature = (
                ready, addresses_ok, tuple(core_unhealthy), tuple(install_blockers),
                revision_sample, machine_config_detail, endpoint_ready, endpoint_detail,
                mcd_addresses_verified,
            )
            if signature != last_observe_signature:
                _clone_log(
                    work,
                    f"observe ready={ready} ips={'ok' if addresses_ok else 'stale'} "
                    f"core={','.join(core_unhealthy) or 'none'} "
                    f"install={','.join(install_blockers) or 'none'} "
                    f"mco={'ready' if machine_config_ready else machine_config_detail} "
                    f"mcd-pods={'ready' if mcd_addresses_verified else 'pending'} "
                    f"api-endpoints={'ready' if endpoint_ready else endpoint_detail}")
                last_observe_signature = signature
            time.sleep(10)
            continue
        probes = _call_together({
            "kubelets": lambda: _in_parallel(nodes, lambda node: _vm(
                node["ip"],
                "systemctl is-active --quiet kubelet || sudo systemctl stop chrony-wait.service || true",
                identity, check=False)),
            "pods": lambda: env.run(
                f"{clone_oc} get pods -n openshift-etcd -l app=etcd --no-headers", check=False),
            "nni": lambda: env.run(
                f"{clone_oc} get ds network-node-identity -n openshift-network-node-identity "
                "-o jsonpath='{.status.desiredNumberScheduled} {.status.updatedNumberScheduled} {.status.numberReady}'",
                check=False),
            "etcd": lambda: _vm(api_ip,
                "sudo podman run --rm --network host --privileged --authfile /var/lib/kubelet/config.json "
                "-v /etc/kubernetes/static-pod-resources/etcd-certs:/certs:ro "
                f"--entrypoint etcdctl {shlex.quote(etcd_image)} endpoint status "
                f"--endpoints={endpoints} "
                "--cacert /certs/configmaps/etcd-all-bundles/server-ca-bundle.crt "
                "--cert /certs/secrets/etcd-all-certs/etcd-peer-master-0-1.crt "
                "--key /certs/secrets/etcd-all-certs/etcd-peer-master-0-1.key -w json",
                identity, check=False),
            "auth": lambda: compact_admin_auth_results(clone_kc, nodes),
            "domains": lambda: compact_identity_domains(clone_oc),
            "api_url_files": lambda: _in_parallel_results(nodes, lambda node: _vm(
                node["ip"], "sudo cat /etc/kubernetes/apiserver-url.env", identity, check=False)),
        })
        try:
            status = json.loads(probes["etcd"].stdout or "[]")
        except json.JSONDecodeError:
            status = []
        members = []
        for item in status:
            body = item.get("Status") or {}
            header = body.get("header") or {}
            members.append({
                "started": "error" not in item and bool(header.get("member_id")),
                "leader": header.get("member_id") is not None and header.get("member_id") == body.get("leader"),
            })
        health = compact_health(parsed_nodes, members, operators)
        etcd_pods = parse_etcd_pods(probes["pods"].stdout or "")
        nni_parts = (probes["nni"].stdout or "").split()
        nni_ready = (
            len(nni_parts) == 3 and nni_parts[0] == nni_parts[1] == nni_parts[2]
            and nni_parts[0] == str(len(COMPACT_ROLES))
        )
        api_url_blockers = compact_api_url_file_blockers(
            probes["api_url_files"], nodes, expected_api_url)
        last_api_url_blockers = api_url_blockers
        last = health
        stage = compact_readiness_stage(
            health["ready"], addresses_ok, health["etcd_started"], etcd_pods, health["leader"], core_unhealthy)
        admin_auth = probes["auth"]
        admin_failed = [item["role"] for item in admin_auth if not item["ok"]]
        sa_failed = []
        if stage == "core-ready" and not admin_failed:
            sa_auth = compact_serviceaccount_auth_results(clone_oc, nodes, work)
            sa_failed = [item["role"] for item in sa_auth if not item["ok"]]
            auth_ready = compact_auth_ready(admin_auth, sa_auth)
        else:
            auth_ready = False
        auth_detail = ",".join(admin_failed + [f"sa:{role}" for role in sa_failed]) or "ok"
        last_auth = auth_detail
        domains = probes["domains"]
        domains_ready = compact_identity_domains_ready(domains, clone_id)
        if not domains_ready:
            compact_apply_clone_ingress_domain(clone_oc, clone_id, work)
            domains = compact_identity_domains(clone_oc)
            domains_ready = compact_identity_domains_ready(domains, clone_id)
        if "console" in post_unhealthy or "ingress" in post_unhealthy:
            _sync_ingress_wildcard(clone_oc, clone_id, work)
        domain_detail = (
            f"dns={domains['base_domain'] or 'missing'} "
            f"ingress={domains['apps_domain'] or 'missing'}"
        )
        last_domains = domain_detail
        etcd_sample = (health["etcd_started"], etcd_pods, bool(health["leader"]), "etcd" in core_unhealthy)
        if etcd_sample != last_etcd_sample:
            _clone_log(
                work,
                f"etcd rollout started={health['etcd_started']} pods={etcd_pods} "
                f"leader={health['leader']} progressing={'etcd' in core_unhealthy}")
            last_etcd_sample = etcd_sample
        install_ready = (
            not install_blockers and revisions_ready and machine_config_ready
            and not api_url_blockers and endpoint_ready
        )
        stable_samples = compact_next_stable_samples(
            stable_samples, stage, auth_ready, domains_ready, install_ready)
        if stable_samples == 0:
            if stage != "core-ready":
                reported_stage = stage
            elif not install_ready:
                reported_stage = "install"
            else:
                reported_stage = "core"
        else:
            reported_stage = "ready"
        _clone_log(
            work,
            f"health stage={reported_stage} stable={stable_samples} "
            f"ready={health['ready']} etcd={health['etcd_started']} leader={health['leader']} "
            f"etcdpods={etcd_pods} ips={'ok' if addresses_ok else 'stale'} "
            f"core={','.join(core_unhealthy) or 'none'} "
            f"install={','.join(install_blockers) or 'none'} "
            f"mco={'ready' if machine_config_ready else 'blocked'} "
            f"api-endpoints={'ready' if endpoint_ready else endpoint_detail} "
            f"api-url={','.join(api_url_blockers) or 'ok'} "
            f"auth={auth_detail} {domain_detail}")
        if stable_samples == 1 and nni_ready and not webhook_confirmed:
            _set_node_identity_webhook(clone_oc, "Fail")
            webhook_confirmed = True
        if stable_samples >= 2 and reported_stage == "ready":
            if "insights" in health["unhealthy_operators"]:
                _clone_log(
                    work,
                    f"Compact clone {clone_id} is up. insights is Degraded because the Red Hat "
                    f"upload token is rejected. Every other install operator is quiet. "
                    f"KUBECONFIG={clone_kc}. Log: {work}/clone.log")
            else:
                _clone_log(
                    work,
                    f"Compact clone {clone_id} is healthy. KUBECONFIG={clone_kc}. "
                    f"Log: {work}/clone.log")
            return health
        if webhook_confirmed and stable_samples == 0:
            _set_node_identity_webhook(clone_oc, "Ignore")
            webhook_confirmed = False
        time.sleep(15 if stable_samples else 10)
    sys.exit(
        f"Clone did not become healthy within 40 minutes: {last} auth={last_auth} "
        f"{last_domains} machine-config={last_mco_detail} api-endpoints={endpoint_detail} "
        f"apiserver-url={','.join(last_api_url_blockers) or 'not-probed'}. "
        f"Log: {work}/clone.log")

def _start_compact_clone(
    source, clone_id, subnet, nodes, macs, identity, work, crypto, etcd_image,
    ingress_cn, memory_kib, vcpus, skip_hash_check=False, pull_secret=None,
):
    """Define the compact guests, restore etcd, and start the heal."""
    plan_path = "/out/summary.txt"
    by_role = {node["role"]: node for node in nodes}
    _clone_log(work, "define and start the clone network and VMs")
    plan = build_compact_boot_plan(
        source, clone_id, subnet, macs, f"{work}/snapshot.db", "/tmp/crypto", ingress_cn, plan_path)
    source_counts = {
        _compact_node_name(node): len(node.get("disks") or [])
        for node in source["nodes"]
    }
    for node in plan["nodes"]:
        count = source_counts.get(node["role"]) or 1
        node["disks"] = [
            compact_role_disk_dest(clone_id, node["role"], index)
            for index in range(count)
        ]
        node["disk"] = node["disks"][0]
        node["hostname"] = node["role"]
    emulator, machine_type = resolve_vm_platform()
    define_compact_libvirt(plan, emulator, machine_type, memory_kib, vcpus)
    env.run(f"virsh net-start {shlex.quote('test-infra-net-' + clone_id)}")
    for node in nodes:
        env.run(f"virsh start {shlex.quote(node['domain'])}")

    _clone_log(work, "wait for SSH and stop kubelet before etcd restore")
    _in_parallel(nodes, lambda node: (
        _wait_ssh(node["ip"], identity),
        _vm(node["ip"], compact_stop_workloads_script(), identity),
        _vm(node["ip"], "sudo systemctl stop chrony-wait.service || true", identity, check=False),
    ))

    _clone_log(work, "reissue etcd certificates for the clone IPs")
    reissue = compact_etcd_reissue_script(nodes, crypto, f"{work}/etcd-new")
    env.write_file(f"{work}/etcd-reissue.sh", reissue)
    env.run(f"chmod 700 {shlex.quote(work + '/etcd-reissue.sh')} && bash {shlex.quote(work + '/etcd-reissue.sh')}")
    env.run(f"chmod 700 {shlex.quote(work + '/etcd-new')} && chmod 600 {shlex.quote(work + '/etcd-new')}/* {shlex.quote(work + '/snapshot.db')}")

    pairs = compact_identity_pairs(source, clone_id, nodes)
    src_kc = f"{work}/source.kubeconfig"
    env.write_file(f"{work}/identity-pairs.json", json.dumps(pairs))
    env.write_file(f"{work}/rewrite-identity.py", compact_identity_script())
    restore_commands = compact_etcd_restore_commands(
        nodes, "/snapshot.db", clone_id, data_root="/restore", skip_hash_check=skip_hash_check)
    def restore_one(item):
        node, restore = item
        _clone_log(work, f"restore etcd and rewrite files on {node['role']}")
        env.run(
            "scp " + " ".join(SSH_OPTS) + f" -i {shlex.quote(identity)} "
            f"{shlex.quote(work + '/snapshot.db')} {shlex.quote(work + '/identity-pairs.json')} "
            f"{shlex.quote(work + '/rewrite-identity.py')} {shlex.quote(work + '/etcd-new')}/etcd-*-{node['role']}.* "
            f"core@{node['ip']}:/var/tmp/")
        quoted = " ".join(shlex.quote(arg) for arg in restore["argv"][1:])
        _vm(node["ip"], " ".join([
            "sudo rm -rf /var/tmp/ct-restore && sudo mkdir -p /var/tmp/ct-restore",
            "&& sudo podman run --rm --network host --privileged",
            "--authfile /var/lib/kubelet/config.json",
            "-v /var/tmp/ct-restore:/restore",
            "-v /var/tmp/snapshot.db:/snapshot.db:ro",
            "--entrypoint etcdutl", shlex.quote(etcd_image),
            quoted,
        ]), identity)
        _vm(node["ip"], textwrap.dedent("""\
            set -euo pipefail
            sudo rm -rf /var/lib/etcd/member
            sudo mv /var/tmp/ct-restore/""" + node["role"] + """/member /var/lib/etcd/member
            sudo restorecon -R /var/lib/etcd/member || true
            sudo mkdir -p /var/tmp/etcd-install
            sudo find /etc/kubernetes/static-pod-resources -name etcd-all-certs -type d | while read -r dir; do
              sudo cp /var/tmp/etcd-peer-""" + node["role"] + """.crt "$dir"/ || true
              sudo cp /var/tmp/etcd-peer-""" + node["role"] + """.key "$dir"/ || true
              sudo cp /var/tmp/etcd-serving-""" + node["role"] + """.crt "$dir"/ || true
              sudo cp /var/tmp/etcd-serving-""" + node["role"] + """.key "$dir"/ || true
              sudo cp /var/tmp/etcd-serving-metrics-""" + node["role"] + """.crt "$dir"/ || true
              sudo cp /var/tmp/etcd-serving-metrics-""" + node["role"] + """.key "$dir"/ || true
            done
            sudo python3 /var/tmp/rewrite-identity.py
            """), identity)

    _in_parallel(list(zip(nodes, restore_commands)), restore_one)

    _clone_log(work, "copy every member certificate onto all three nodes")

    def install_member_certs(node):
        for other in nodes:
            env.run(
                "scp " + " ".join(SSH_OPTS) + f" -i {shlex.quote(identity)} "
                f"{shlex.quote(work + '/etcd-new')}/etcd-*-{other['role']}.crt "
                f"{shlex.quote(work + '/etcd-new')}/etcd-*-{other['role']}.key "
                f"core@{node['ip']}:/var/tmp/")
        _vm(node["ip"], compact_install_etcd_certs_script() + "sudo systemctl start crio\n", identity)
        _vm(node["ip"], compact_release_keepalived_script(), identity, check=False)
        _vm(node["ip"], "sudo systemctl start kubelet", identity)

    _in_parallel(nodes, install_member_certs)

    _clone_log(work, "wait for the clone API")
    api_ip = by_role[QUORUM_ETCD_ROLE]["ip"]
    ready = False
    for _ in range(90):
        probe = env.run(f"curl -sk --max-time 5 https://{api_ip}:6443/readyz || true", check=False)
        if probe.stdout.strip() == "ok":
            ready = True
            break
        time.sleep(10)
    if not ready:
        sys.exit(f"Clone API on {api_ip}:6443 did not become ready. Log: {work}/clone.log")

    return _finish_compact_clone(
        source, clone_id, nodes, identity, work, crypto, etcd_image, ingress_cn,
        plan_path, by_role, api_ip, src_kc, pairs, pull_secret=pull_secret)


RHCOS_ROOT_MOUNT = "/dev/sda4:/"
RHCOS_DEPLOYS = "/ostree/deploy/rhcos/deploy"
RHCOS_ETCD_DB = "/ostree/deploy/rhcos/var/lib/etcd/member/snap/db"
_rhcos_deploy_cache = {}


def parse_booted_ostree_deployment(status):
    """Extract the deployment ID marked booted by `ostree admin status`."""
    booted = [line.split() for line in (status or "").splitlines()
              if line.lstrip().startswith("*")]
    if len(booted) != 1 or len(booted[0]) < 3:
        sys.exit("Could not identify exactly one booted OSTree deployment from source status")
    return booted[0][2]


def choose_rhcos_deploy(names, booted_deployment=None):
    """Select the source's booted deployment, or its sole unambiguous tree."""
    deploys = [name for name in names if name and not name.endswith(".origin")]
    if not deploys:
        sys.exit("No RHCOS deployment on the flavor disk")
    if booted_deployment:
        selected = Path(booted_deployment).name
        if selected.endswith(".origin"):
            selected = selected[:-len(".origin")]
        if selected not in deploys:
            sys.exit(
                "The booted OSTree deployment recorded in flavor metadata "
                "does not exist on the flavor disk")
        return selected
    if len(deploys) == 1:
        return deploys[0]
    sys.exit(
        "Flavor disk has multiple RHCOS deployments and no booted deployment "
        "metadata. Recreate the flavor from a running source so its booted "
        "OSTree deployment is recorded.")


def _guest_run(disk, tool, guest_path, dest=""):
    """Run one guestfish command against an RHCOS disk."""
    command = f"{tool} -a {shlex.quote(disk)} -m {shlex.quote(RHCOS_ROOT_MOUNT)} {shlex.quote(guest_path)}"
    if dest:
        command += f" {shlex.quote(dest)}"
    return env.run(command, check=False)


def _rhcos_deploy(disk, booted_deployment=None):
    """Return the selected RHCOS deployment directory on a flavor disk."""
    cache_key = (disk, booted_deployment)
    cached = _rhcos_deploy_cache.get(cache_key)
    if cached:
        return cached
    listing = _guest_run(disk, "virt-ls", RHCOS_DEPLOYS)
    if listing.returncode != 0:
        sys.exit(f"Could not list the RHCOS deployment on {disk}. {(listing.stderr or '').strip()}")
    deploy = f"{RHCOS_DEPLOYS}/{choose_rhcos_deploy(listing.stdout.split(), booted_deployment)}"
    _rhcos_deploy_cache[cache_key] = deploy
    return deploy


def _guest_cat(disk, path, booted_deployment=None):
    """Read one file from an RHCOS disk."""
    guest_path = _rhcos_deploy(disk, booted_deployment) + path
    r = _guest_run(disk, "virt-cat", guest_path)
    if r.returncode != 0:
        sys.exit(f"Could not read {path} from {disk}. {(r.stderr or '').strip()}")
    return r.stdout


def _guest_mac(disk, booted_deployment=None):
    """Read the NetworkManager MAC from an RHCOS disk."""
    directory = _rhcos_deploy(disk, booted_deployment) + "/etc/NetworkManager/system-connections"
    listing = _guest_run(disk, "virt-ls", directory)
    if listing.returncode != 0:
        sys.exit(f"Could not list NetworkManager connections on {disk}")
    for name in listing.stdout.split():
        mac = parse_nm_mac(_guest_cat(
            disk, f"/etc/NetworkManager/system-connections/{name}", booted_deployment))
        if mac:
            return mac
    sys.exit(f"No mac-address in NetworkManager connections on {disk}")


def _write_etcd_signers(snapshot, crypto):
    """Extract etcd signer material from a snapshot into the crypto directory."""
    script = textwrap.dedent("""\
        import pathlib, re, sys
        snapshot, crypto = sys.argv[1], sys.argv[2]
        data = pathlib.Path(snapshot).read_bytes()

        def pems_for(secret):
            marker = f"/kubernetes.io/secrets/openshift-etcd/{secret}".encode()
            start = data.find(marker)
            if start < 0:
                sys.exit(f"Etcd snapshot is missing {secret}")
            nxt = data.find(b"/kubernetes.io/secrets/", start + len(marker))
            window = data[start:nxt if nxt > 0 else start + 20000]
            return re.findall(
                rb"-----BEGIN [A-Z0-9 ]+-----.*?-----END [A-Z0-9 ]+-----",
                window, flags=re.S)

        for secret, stem in (("etcd-signer", "etcd-signer"), ("etcd-metric-signer", "etcd-metric-signer")):
            found = pems_for(secret)
            key = next((item for item in found if b"PRIVATE KEY" in item), None)
            certs = [item for item in found if b"CERTIFICATE" in item and b"PRIVATE" not in item]
            if not key or not certs:
                sys.exit(f"Etcd snapshot is missing {secret} key or certificate")
            out = pathlib.Path(crypto)
            (out / f"{stem}.key").write_bytes(key if key.endswith(b"\\n") else key + b"\\n")
            (out / f"{stem}.crt").write_bytes(certs[0] if certs[0].endswith(b"\\n") else certs[0] + b"\\n")
            (out / f"{stem}.key").chmod(0o600)
            (out / f"{stem}.crt").chmod(0o644)
        """)
    env.write_file(f"{crypto}/extract-etcd-signers.py", script)
    env.run(f"python3 {shlex.quote(crypto + '/extract-etcd-signers.py')} {shlex.quote(snapshot)} {shlex.quote(crypto)}")
    env.run(f"rm -f {shlex.quote(crypto + '/extract-etcd-signers.py')}")


def run_compact_from_flavor(
    flavor_name, flavor, clone_id, subnet, identity, memory_kib=None, vcpus=None,
    resume=None, pull_secret=None,
):
    """Deploy a compact cluster from a pulled flavor."""
    clone_id = _safe_clone_id(clone_id)
    if flavor.get("topology") != "compact":
        sys.exit(f"Flavor '{flavor_name}' is not a compact flavor")
    groups = compact_flavor_node_disks(flavor.get("disks") or [])
    for key in ("source_primary_subnet", "memory_kib", "vcpus", "etcd_image"):
        if flavor.get(key) in (None, ""):
            sys.exit(f"Flavor '{flavor_name}' is missing {key}")
    booted_deployment = flavor.get("rhcos_deployment")
    source_subnet = int(flavor["source_primary_subnet"])
    if resume in ("recert", "rewrite", "health"):
        saved = (load_state().get("clones") or {}).get(clone_id)
        if not saved or saved.get("subnet_primary") is None:
            sys.exit(f"No reserved subnet is recorded for clone '{clone_id}'.")
        saved_subnet = saved["subnet_primary"]
        if subnet is None:
            subnet = saved_subnet
        elif subnet != saved_subnet:
            sys.exit(f"Clone '{clone_id}' is reserved on subnet {saved_subnet}, not {subnet}.")
    if subnet is not None and subnet == source_subnet:
        sys.exit(f"Refusing to boot onto source subnet {subnet}.")
    work = f"/var/lib/libvirt/images/{clone_id}"
    exists = env.run(f"test -e {shlex.quote(work)} && echo yes || true")
    if resume in ("recert", "rewrite", "health"):
        if "yes" not in exists.stdout:
            sys.exit(f"Nothing to resume at {work}.")
    elif "yes" in exists.stdout:
        sys.exit(f"{work} already exists. Remove that clone before running this one.")
    fdir = flavor_dir(flavor_name)
    node_disks = []
    for _, os_name, spare_name in groups:
        paths = [f"{fdir}/{os_name}"]
        if spare_name:
            paths.append(f"{fdir}/{spare_name}")
        node_disks.append(paths)
    os_disks = [paths[0] for paths in node_disks]
    url_text = _guest_cat(os_disks[0], "/etc/kubernetes/apiserver-url.env", booted_deployment)
    kubeconfig_text = _guest_cat(os_disks[0], "/etc/kubernetes/kubeconfig", booted_deployment)
    bases = compact_dns_bases_from_text(url_text + "\n" + kubeconfig_text)
    if not bases:
        sys.exit("Could not find the source cluster domain on the flavor disk")
    macs = [_guest_mac(path, booted_deployment) for path in os_disks]
    member_ips = compact_etcd_member_ips(
        _guest_cat(os_disks[0], "/etc/kubernetes/manifests/etcd-pod.yaml", booted_deployment))
    source_api_vip, source_ingress_vip = compact_vips_from_nodeip_service(
        _guest_cat(os_disks[0], "/etc/systemd/system/nodeip-configuration.service", booted_deployment))
    source = compact_source_from_layout(
        flavor, macs, bases, node_disks, node_ips=member_ips,
        api_vip=source_api_vip, ingress_vip=source_ingress_vip)
    kubeconfig = _guest_cat(
        os_disks[0],
        "/etc/kubernetes/static-pod-resources/kube-apiserver-certs/secrets/node-kubeconfigs/lb-ext.kubeconfig",
        booted_deployment)
    if resume not in ("recert", "rewrite", "health"):
        requested_subnet = subnet
        subnet = record_compact_clone(clone_id, subnet, flavor_name)
        if requested_subnet is None:
            print(f"Allocated subnet {subnet} for clone {clone_id}", flush=True)
    env.run(f"mkdir -p {shlex.quote(work)} && chmod 755 {shlex.quote(work)}")
    _clone_log(work, f"read identity from flavor {flavor_name}")
    env.write_file(f"{work}/source.kubeconfig", kubeconfig)
    env.run(f"chmod 600 {shlex.quote(work + '/source.kubeconfig')}")
    nodes = compact_node_plan(clone_id, subnet, macs)
    for node in nodes:
        node["hostname"] = node["role"]
        node["disk"] = f"{work}/{node['role']}.qcow2"
    crypto = f"{work}/crypto"
    if resume in ("recert", "rewrite", "health"):
        ingress_cn = env.run(f"cat {shlex.quote(crypto + '/ingress-cn.txt')}").stdout.strip()
        if not ingress_cn:
            sys.exit(f"Existing clone crypto is missing ingress-cn.txt: {crypto}")
        if not identity:
            identity = f"{crypto}/cluster-tool.key"
        env.run(f"test -s {shlex.quote(identity)}")
        pairs = compact_identity_pairs(source, clone_id, nodes)
        by_role = {node["role"]: node for node in nodes}
        api_ip = by_role[QUORUM_ETCD_ROLE]["ip"]
        _clone_log(work, f"resume at {resume}")
        health = _finish_compact_clone(
            source, clone_id, nodes, identity, work, crypto, flavor["etcd_image"], ingress_cn,
            "/out/summary.txt", by_role, api_ip, f"{work}/source.kubeconfig", pairs,
            start_at=None if resume == "recert" else resume,
            pull_secret=pull_secret)
        mark_compact_clone_running(clone_id)
        return health
    flavor_crypto = flavor_crypto_dir(flavor_name)
    env.run(
        f"mkdir -p {shlex.quote(crypto)} && chmod 700 {shlex.quote(crypto)} && "
        f"cp -a {shlex.quote(flavor_crypto)}/. {shlex.quote(crypto)}/")
    ingress_cn = env.run(f"cat {shlex.quote(crypto + '/ingress-cn.txt')}").stdout.strip()
    if not ingress_cn:
        sys.exit("Flavor crypto is missing ingress-cn.txt")
    if not identity:
        identity = f"{crypto}/cluster-tool.key"
    env.run(f"test -s {shlex.quote(identity)}")
    env.run(f"chmod 600 {shlex.quote(identity)}")
    _clone_log(work, "copy the etcd database out of the flavor disk")
    env.run(
        f"mkdir -p {shlex.quote(work + '/snapshot-src')} && "
        f"chmod 700 {shlex.quote(work + '/snapshot-src')}")
    copied = env.run(
        f"guestfish --ro -a {shlex.quote(os_disks[1])} -m {shlex.quote(RHCOS_ROOT_MOUNT)} "
        f"copy-out {shlex.quote(RHCOS_ETCD_DB)} {shlex.quote(work + '/snapshot-src')}",
        check=False)
    if copied.returncode != 0:
        sys.exit(f"Could not copy the etcd database from {os_disks[1]}. {(copied.stderr or '').strip()}")
    env.run(
        f"mv {shlex.quote(work + '/snapshot-src/db')} {shlex.quote(work + '/snapshot.db')} && "
        f"rmdir {shlex.quote(work + '/snapshot-src')} && chmod 600 {shlex.quote(work + '/snapshot.db')}")
    _clone_log(work, "read etcd signer keys from the snapshot")
    _write_etcd_signers(f"{work}/snapshot.db", crypto)
    disk_count = sum(len(paths) for paths in node_disks)
    _clone_log(work, f"copy the {disk_count} flavor disks")
    for command in compact_copy_commands(compact_clone_disks(clone_id, source["nodes"])):
        env.run(command)
    memory_kib = memory_kib or flavor["memory_kib"]
    vcpus = vcpus or flavor["vcpus"]
    health = _start_compact_clone(
        source, clone_id, subnet, nodes, macs, identity, work, crypto,
        flavor["etcd_image"], ingress_cn, memory_kib, vcpus,
        skip_hash_check=True, pull_secret=pull_secret)
    mark_compact_clone_running(clone_id)
    return health


def cmd_compact_boot(args):
    """Boot a compact cluster from a flavor recorded in local state."""
    state = load_state()
    flavor = state["flavors"].get(args.flavor)
    if not flavor:
        sys.exit(f"Flavor '{args.flavor}' not found. Available: {', '.join(state['flavors'])}")
    pull_secret = None
    pull_secret_path = getattr(args, "pull_secret", None)
    if pull_secret_path:
        pull_secret_path = os.path.expanduser(pull_secret_path)
        if not os.path.isfile(pull_secret_path):
            sys.exit(f"Pull secret not found: {pull_secret_path}")
        try:
            pull_secret = Path(pull_secret_path).read_text()
            parsed = json.loads(pull_secret)
        except (OSError, UnicodeDecodeError, json.JSONDecodeError):
            sys.exit(f"Pull secret is not readable JSON: {pull_secret_path}")
        if not isinstance(parsed, dict):
            sys.exit(f"Pull secret must contain a JSON object: {pull_secret_path}")
    run_compact_from_flavor(
        args.flavor, flavor, args.name, getattr(args, "subnet", None), args.identity or "",
        memory_kib=args.memory_kib, vcpus=args.vcpus, resume=args.resume,
        pull_secret=pull_secret)


def run_compact_clone(source, clone_id, subnet, identity, memory_kib=None, vcpus=None, resume=None):
    """Clone a live compact source onto a new subnet and heal it."""
    clone_id = _safe_clone_id(clone_id)
    source_subnet = int(source["nodes"][0]["ip"].split(".")[2])
    if subnet == source_subnet:
        sys.exit(f"Refusing to clone onto source subnet {subnet}.")
    work = f"/var/lib/libvirt/images/{clone_id}"
    exists = env.run(f"test -e {shlex.quote(work)} && echo yes || true")
    if resume in ("recert", "heal", "health"):
        if "yes" not in exists.stdout:
            sys.exit(f"Nothing to resume at {work}.")
    elif "yes" in exists.stdout:
        sys.exit(f"{work} already exists. Remove that clone before running this one.")
    else:
        record_compact_clone(clone_id, subnet, source.get("source", "compact"))
    macs = [node["mac"] for node in source["nodes"]]
    nodes = compact_node_plan(clone_id, subnet, macs)
    by_role = {node["role"]: node for node in nodes}
    for node in nodes:
        node["hostname"] = node["role"]
        node["disk"] = f"{work}/{node['role']}.qcow2"
    disks = compact_clone_disks(clone_id, source["nodes"])
    memory_kib = memory_kib or source["memory_kib"]
    vcpus = vcpus or source["vcpus"]
    crypto = f"{work}/crypto"
    plan_path = "/out/summary.txt"
    ingress_holder = f"{crypto}/ingress-cn.txt"
    if resume in ("recert", "heal", "health"):
        ingress_cn = env.run(f"cat {shlex.quote(ingress_holder)}").stdout.strip()
        src_kc = f"{work}/source.kubeconfig"
        api_ip = by_role[QUORUM_ETCD_ROLE]["ip"]
        image_r = _vm(api_ip,
            "sudo python3 -c \"import yaml; d=yaml.safe_load(open('/etc/kubernetes/manifests/etcd-pod.yaml')); "
            "print(next(c['image'] for c in d['spec']['containers'] if c['name']=='etcd'))\"",
            identity)
        etcd_image = image_r.stdout.strip()
        pairs = compact_identity_pairs(source, clone_id, nodes)
        _clone_log(work, f"resume at {resume}")
        health = _finish_compact_clone(
            source, clone_id, nodes, identity, work, crypto, etcd_image, ingress_cn,
            plan_path, by_role, api_ip, src_kc, pairs,
            start_at={"heal": "rewrite", "health": "health"}.get(resume))
        mark_compact_clone_running(clone_id)
        return health

    env.run(
        f"mkdir -p {shlex.quote(crypto)} && chmod 755 {shlex.quote(work)} && chmod 700 {shlex.quote(crypto)}")
    _clone_log(work, f"clone {clone_id} subnet {subnet} from {source['source']} {source['network']}")

    _clone_log(work, "extract signer keys from the source API")
    src_pin = next(node["ip"] for node in source["nodes"] if node["role"] == QUORUM_ETCD_ROLE)
    src_kc = f"{work}/source.kubeconfig"
    env.run(
        "ssh " + " ".join(SSH_OPTS) + f" -i {shlex.quote(identity)} core@{src_pin} "
        "'sudo cat /etc/kubernetes/static-pod-resources/kube-apiserver-certs/secrets/node-kubeconfigs/lb-ext.kubeconfig' "
        f"> {shlex.quote(src_kc)}")
    env.run(f"chmod 600 {shlex.quote(src_kc)}")
    src_oc = _oc(src_kc, f"https://{src_pin}:6443")
    for secret, namespace, key, dest in (
        ("loadbalancer-serving-signer", "openshift-kube-apiserver-operator", "tls.key", "lb-signer.key"),
        ("localhost-serving-signer", "openshift-kube-apiserver-operator", "tls.key", "localhost-signer.key"),
        ("service-network-serving-signer", "openshift-kube-apiserver-operator", "tls.key", "service-network-signer.key"),
        ("router-ca", "openshift-ingress-operator", "tls.key", "ingress.key"),
        ("etcd-signer", "openshift-etcd", "tls.crt", "etcd-signer.crt"),
        ("etcd-signer", "openshift-etcd", "tls.key", "etcd-signer.key"),
        ("etcd-metric-signer", "openshift-etcd", "tls.crt", "etcd-metric-signer.crt"),
        ("etcd-metric-signer", "openshift-etcd", "tls.key", "etcd-metric-signer.key"),
    ):
        _extract_secret(src_oc, namespace, secret, key, f"{crypto}/{dest}")
    cn = env.run(
        f"{src_oc} get secret/router-ca -n openshift-ingress-operator "
        "-o jsonpath='{.data.tls\\.crt}' | base64 -d | openssl x509 -noout -subject | sed 's/subject=CN *= *//'")
    if not cn.stdout.strip():
        sys.exit("Failed to read the ingress signer CN")
    env.run(f"printf '%s\\n' {shlex.quote(cn.stdout.strip())} > {shlex.quote(ingress_holder)}")
    ingress_cn = cn.stdout.strip()

    _clone_log(work, "save one etcd snapshot from the source quorum")
    image_r = _vm(src_pin,
        "sudo python3 -c \"import yaml; d=yaml.safe_load(open('/etc/kubernetes/manifests/etcd-pod.yaml')); "
        "print(next(c['image'] for c in d['spec']['containers'] if c['name']=='etcd'))\"",
        identity)
    etcd_image = image_r.stdout.strip()
    if not etcd_image:
        sys.exit("Could not read the etcd image from the source")
    _vm(src_pin, "sudo rm -rf /var/tmp/ct-snapshot && sudo mkdir -p /var/tmp/ct-snapshot && sudo chmod 700 /var/tmp/ct-snapshot", identity)
    _vm(src_pin, " ".join([
        "sudo podman run --rm --network host --privileged",
        "--authfile /var/lib/kubelet/config.json",
        "-v /etc/kubernetes/static-pod-resources/etcd-certs:/certs:ro",
        "-v /var/tmp/ct-snapshot:/out",
        "--entrypoint etcdctl", shlex.quote(etcd_image),
        "--endpoints=https://127.0.0.1:2379",
        "--cacert /certs/configmaps/etcd-all-bundles/server-ca-bundle.crt",
        "--cert /certs/secrets/etcd-all-certs/etcd-peer-master-0-1.crt",
        "--key /certs/secrets/etcd-all-certs/etcd-peer-master-0-1.key",
        "snapshot save /out/snapshot.db",
    ]), identity)
    _vm(src_pin, "sudo chown core:core /var/tmp/ct-snapshot/snapshot.db && sudo chmod 600 /var/tmp/ct-snapshot/snapshot.db", identity)
    env.run(
        "scp " + " ".join(SSH_OPTS) + f" -i {shlex.quote(identity)} "
        f"core@{src_pin}:/var/tmp/ct-snapshot/snapshot.db {shlex.quote(work + '/snapshot.db')}")
    env.run(f"chmod 600 {shlex.quote(work + '/snapshot.db')}")
    _vm(src_pin, "sudo rm -rf /var/tmp/ct-snapshot", identity, check=False)

    _clone_log(work, "reflink-copy the three source disks")
    for command in compact_copy_commands(disks):
        env.run(command)

    health = _start_compact_clone(
        source, clone_id, subnet, nodes, macs, identity, work, crypto,
        etcd_image, ingress_cn, memory_kib, vcpus)
    mark_compact_clone_running(clone_id)
    return health



