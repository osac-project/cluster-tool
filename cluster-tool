def _replace_token(text, old, new):
    """Replace one identity token without touching surrounding text."""
    if not old or old == new:
        return text
    if re.fullmatch(r"[0-9.]+", old):
        return re.sub(re.escape(old) + r"(?!\d)", new, text)
    return text.replace(old, new)


def apply_identity(text, pairs):
    """Replace clone identity tokens in a text document."""
    ordered = sorted(pairs, key=lambda pair: len(pair[0]), reverse=True)
    for old, new in ordered:
        text = _replace_token(text, old, new)
    return text


def apply_identity_preserving_pems(text, pairs):
    """Replace identity tokens while leaving PEM blocks unchanged."""
    pems = []

    def hold(match):
        pems.append(match.group(0))
        return f"__CT_PEM_{len(pems) - 1}__"

    protected = re.sub(
        r"[ \t]*-----BEGIN [A-Z0-9 ]+-----.*?-----END [A-Z0-9 ]+-----",
        hold, text, flags=re.S)
    updated = apply_identity(protected, pairs)
    for index, pem in enumerate(pems):
        updated = updated.replace(f"__CT_PEM_{index}__", pem)
    return updated


def compact_identity_pairs(source, clone_id, new_nodes):
    """Build the old-to-new identity replacements for a compact clone."""
    new_domain = f"test-infra-cluster-{clone_id}.redhat.com"
    subnet = int(new_nodes[0]["ip"].split(".")[2])
    pairs = []
    bases = set()
    for item in source.get("dns", []):
        name = item["name"]
        for prefix in ("api-int.", "api.", "apps."):
            if name.startswith(prefix):
                bases.add(name[len(prefix):])
    for base in bases:
        pairs.append((f"api-int.{base}", f"api-int.{new_domain}"))
        pairs.append((f"api.{base}", f"api.{new_domain}"))
        pairs.append((f"apps.{base}", f"apps.{new_domain}"))
        pairs.append((base, new_domain))
    short_names = {base.split(".")[0] for base in bases}
    short_names.add(f"test-infra-cluster-{clone_id}")
    for name in short_names:
        pairs.append((name, f"test-infra-cluster-{clone_id}"))
    api_vips = source.get("api_vips") or [source["api_vip"]]
    ingress_vips = source.get("ingress_vips") or [source["ingress_vip"]]
    for vip in dict.fromkeys(api_vips):
        pairs.append((vip, f"192.168.{subnet}.{COMPACT_API_SUFFIX}"))
    for vip in dict.fromkeys(ingress_vips):
        pairs.append((vip, f"192.168.{subnet}.{COMPACT_INGRESS_SUFFIX}"))
    if source.get("gateway"):
        pairs.append((source["gateway"], f"192.168.{subnet}.1"))
    if source.get("machine_network"):
        pairs.append((source["machine_network"], f"192.168.{subnet}.0/24"))
    old_by_role = {_compact_node_name(node): node for node in source["nodes"]}
    for node in new_nodes:
        old = old_by_role[node["role"]]
        pairs.append((old["ip"], node["ip"]))
    return pairs


def _cn_san(old, new):
    """Build one common-name or SAN replacement pair."""
    sep = "," if old.startswith("system:") else ":"
    return f"{old}{sep}{new}"


def recert_compact_commands(source, clone_id, new_nodes, crypto_dir, ingress_cn, plan_path):
    """Build the single Recert invocation used by a compact heal."""
    identity = compact_identity_pairs(source, clone_id, new_nodes)
    old_by_role = {_compact_node_name(node): node for node in source["nodes"]}
    new_by_role = {node["role"]: node for node in new_nodes}
    san = []
    for role in COMPACT_ROLES:
        old_name = old_by_role[role].get("hostname") or role
        new_name = new_by_role[role].get("hostname") or role
        if old_name != new_name:
            san.append((old_name, new_name))
            san.append((f"system:node:{old_name}", f"system:node:{new_name}"))
    san.extend(identity)
    common = []
    for directory in RECERT_CRYPTO_DIRS:
        common += ["--crypto-dir", directory]
    for directory in RECERT_CRYPTO_DIRS:
        if directory == "/etc/cni":
            continue
        common += ["--cluster-customization-dir", directory]
    for signer, filename in RECERT_USE_KEYS:
        common += ["--use-key", f"{signer}:{crypto_dir}/{filename}"]
    common += ["--use-key", f"{ingress_cn}:{crypto_dir}/ingress.key"]
    common += ["--cluster-rename", f"test-infra-cluster-{clone_id}:redhat.com"]
    for old, new in san:
        common += ["--cn-san-replace", _cn_san(old, new)]
    common += ["--extend-expiration", "--summary-file", plan_path]

    node = new_by_role[COMPACT_ROLES[0]]
    argv = list(common)
    argv += ["--hostname", node.get("hostname") or COMPACT_ROLES[0], "--ip", node["ip"], "--etcd-endpoint", "localhost:2379"]
    return [{
        "name": COMPACT_ROLES[0],
        "disk_only": False,
        "argv": argv,
        "expected_error": "Expected exactly one node",
    }]


