def compact_parse_node_docs(raw):
    """Extract node readiness, addresses, and machine-config annotations from JSON."""
    try:
        items = json.loads(raw).get("items") or []
    except (json.JSONDecodeError, AttributeError, TypeError):
        return []
    rows = []
    for item in items:
        if not isinstance(item, dict):
            continue
        metadata = item.get("metadata") or {}
        status = item.get("status") or {}
        annotations = metadata.get("annotations") or {}
        conditions = status.get("conditions") or []
        ready_condition = next((
            condition for condition in conditions
            if condition.get("type") == "Ready"
        ), {})
        ready = ready_condition.get("status") == "True"
        internal_ip = next((
            address.get("address", "")
            for address in status.get("addresses") or []
            if address.get("type") == "InternalIP"
        ), "")
        rows.append({
            "name": metadata.get("name", ""),
            "ready": ready,
            "ready_status": ready_condition.get("status", "Unknown"),
            "ready_reason": str(ready_condition.get("reason") or "").strip(),
            "ready_message": " ".join(
                str(ready_condition.get("message") or "").split())[:240],
            "ready_transition": str(ready_condition.get("lastTransitionTime") or "").strip(),
            "unschedulable": bool((item.get("spec") or {}).get("unschedulable", False)),
            "ip": internal_ip,
            "current_config": annotations.get("machineconfiguration.openshift.io/currentConfig", ""),
            "desired_config": annotations.get("machineconfiguration.openshift.io/desiredConfig", ""),
            "mcd_state": annotations.get("machineconfiguration.openshift.io/state", ""),
            "mcd_reason": " ".join(
                str(annotations.get("machineconfiguration.openshift.io/reason") or "").split())[:240],
        })
    return rows


