def compact_controllerconfig_infra_matches(raw, clone_domain, api_vip, subnet):
    """Whether the MCO's embedded Infrastructure snapshot matches this clone."""
    try:
        doc = json.loads(raw) if isinstance(raw, str) else raw
    except (json.JSONDecodeError, TypeError):
        return False
    if not isinstance(doc, dict):
        return False
    infra = ((doc.get("spec") or {}).get("infra") or {})
    status = infra.get("status") or {}
    baremetal = ((status.get("platformStatus") or {}).get("baremetal") or {})
    spec_baremetal = (((infra.get("spec") or {}).get("platformSpec") or {})
                      .get("baremetal") or {})
    # clone_domain is the complete cluster domain, for example
    # test-infra-cluster-edge21.redhat.com.
    expected_domain = clone_domain
    network = f"192.168.{subnet}.0/24"
    return (
        status.get("apiServerInternalURI") == f"https://api-int.{expected_domain}:6443"
        and status.get("apiServerURL") == f"https://api.{expected_domain}:6443"
        and baremetal.get("apiServerInternalIP") == api_vip
        and baremetal.get("apiServerInternalIPs") == [api_vip]
        and baremetal.get("machineNetworks") == [network]
        and spec_baremetal.get("apiServerInternalIPs") == [api_vip]
        and spec_baremetal.get("machineNetworks") == [network]
    )


def compact_controllerconfig_dns_matches(raw, expected_dns, clone_domain):
    """Whether the MCO's embedded DNS snapshot matches the clone DNS resource."""
    try:
        doc = json.loads(raw) if isinstance(raw, str) else raw
    except (json.JSONDecodeError, TypeError):
        return False
    if not isinstance(doc, dict) or not isinstance(expected_dns, dict):
        return False
    current = ((doc.get("spec") or {}).get("dns") or {})
    return (
        current.get("apiVersion") == expected_dns.get("apiVersion")
        and current.get("kind") == expected_dns.get("kind") == "DNS"
        and current.get("spec") == expected_dns.get("spec")
        and (current.get("spec") or {}).get("baseDomain") == clone_domain
    )
