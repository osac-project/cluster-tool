def kubelet_sign_script(role, ip, signer_dir):
    """Build the script that signs one kubelet client and server certificate."""
    return textwrap.dedent(f"""\
        set -euo pipefail
        umask 077
        openssl ecparam -name prime256v1 -genkey -out {role}-server.key
        openssl req -new -key {role}-server.key -subj "/O=system:nodes/CN=system:node:{role}" -out {role}-server.csr
        cat > {role}-server.ext << 'CNF'
        basicConstraints=critical,CA:FALSE
        keyUsage=critical,digitalSignature
        extendedKeyUsage=serverAuth
        subjectAltName=DNS:{role},IP:{ip}
        CNF
        openssl x509 -req -in {role}-server.csr -CA {signer_dir}/tls.crt -CAkey {signer_dir}/tls.key -CAcreateserial -out {role}-server.crt -days 29 -extfile {role}-server.ext
        openssl ecparam -name prime256v1 -genkey -out {role}-client.key
        openssl req -new -key {role}-client.key -subj "/O=system:nodes/CN=system:node:{role}" -out {role}-client.csr
        cat > {role}-client.ext << 'CNF'
        basicConstraints=critical,CA:FALSE
        keyUsage=critical,digitalSignature
        extendedKeyUsage=clientAuth
        CNF
        openssl x509 -req -in {role}-client.csr -CA {signer_dir}/tls.crt -CAkey {signer_dir}/tls.key -CAcreateserial -out {role}-client.crt -days 29 -extfile {role}-client.ext
        """)


def compact_heal_plan(source, clone_id, new_nodes, crypto_dir, ingress_cn, plan_path, signer_dir):
    """Assemble the compact heal steps for Recert, certificates, and rewrites."""
    by_role = {node["role"]: node for node in new_nodes}
    if QUORUM_ETCD_ROLE not in by_role or RECERT_ROLE not in by_role:
        sys.exit("compact heal needs master-0-0 and master-0-1")
    return {
        "recert_once": recert_compact_commands(
            source, clone_id, new_nodes, crypto_dir, ingress_cn, plan_path)[0],
        "etcd_cert_copy": {
            "from_role": QUORUM_ETCD_ROLE,
            "to_role": RECERT_ROLE,
            "from_ip": by_role[QUORUM_ETCD_ROLE]["ip"],
            "to_ip": by_role[RECERT_ROLE]["ip"],
            "paths": list(ETCD_CERT_RELPATHS),
        },
        "client_trust_copy": {
            "from_role": QUORUM_ETCD_ROLE,
            "to_role": RECERT_ROLE,
            "paths": list(CLIENT_TRUST_RELPATHS),
        },
        "kubelet_sign": [
            {
                "role": node["role"],
                "ip": node["ip"],
                "cn": f"system:node:{node['role']}",
                "script": kubelet_sign_script(node["role"], node["ip"], signer_dir),
            }
            for node in new_nodes
        ],
        "rewrite_files": list(HEAL_NODE_FILES),
        "api_objects": [list(item) for item in HEAL_API_OBJECTS],
        "replacements": compact_identity_pairs(source, clone_id, new_nodes),
        "base_domain": f"test-infra-cluster-{clone_id}.redhat.com",
        "ingress_domain": compact_apps_domain(clone_id),
        "chrony_wait_stop": list(CHRONY_WAIT_STOP),
    }


def compact_apps_domain(clone_id):
    """Ingress spec.domain for a compact clone."""
    return f"apps.test-infra-cluster-{clone_id}.redhat.com"


def compact_ingress_wildcard_host(clone_id):
    """Default router certificate name for a compact clone."""
    return "*." + compact_apps_domain(clone_id)


def compact_ingresscontroller_status_patch(clone_id):
    """Status domain the ingress operator uses when it mints the wildcard."""
    return {"status": {"domain": compact_apps_domain(clone_id)}}


def compact_identity_domain_patches(clone_id):
    """DNS baseDomain and ingress spec.domain for the clone, not the source."""
    domain = f"test-infra-cluster-{clone_id}.redhat.com"
    return {
        "dns": {"spec": {"baseDomain": domain}},
        "ingress": {"spec": {"domain": compact_apps_domain(clone_id)}},
    }


def compact_identity_domains(oc):
    """Read DNS baseDomain and ingress spec.domain from the clone API."""
    probes = _call_together({
        "dns": lambda: env.run(
            f"{oc} get dns.config.openshift.io cluster -o jsonpath='{{.spec.baseDomain}}'",
            check=False),
        "ingress": lambda: env.run(
            f"{oc} get ingresses.config.openshift.io cluster -o jsonpath='{{.spec.domain}}'",
            check=False),
    })
    return {
        "base_domain": (probes["dns"].stdout or "").strip(),
        "apps_domain": (probes["ingress"].stdout or "").strip(),
    }


def compact_identity_domains_ready(observed, clone_id):
    """True when DNS and ingress names match the clone."""
    return (
        observed.get("base_domain") == f"test-infra-cluster-{clone_id}.redhat.com"
        and observed.get("apps_domain") == compact_apps_domain(clone_id)
    )


def _ingress_domain_schema(doc):
    """Yield the Ingress spec.domain OpenAPI nodes from a CRD document."""
    for version in doc.get("spec", {}).get("versions") or []:
        domain = (
            ((version.get("schema") or {}).get("openAPIV3Schema") or {})
            .get("properties", {})
            .get("spec", {})
            .get("properties", {})
            .get("domain")
        )
        if isinstance(domain, dict):
            yield domain


def compact_strip_ingress_domain_lock(raw):
    """Remove the CEL rule that makes ingress spec.domain immutable."""
    doc = json.loads(raw)
    for domain in _ingress_domain_schema(doc):
        domain.pop("x-kubernetes-validations", None)
    return json.dumps(doc)


def compact_apply_clone_ingress_domain(oc, clone_id, work):
    """Set ingress spec.domain to the clone apps domain.

    OpenShift rejects oc patch because spec.domain is immutable on the CRD.
    Lift that CEL rule, patch the object, then put the original CRD back.
    """
    wanted = compact_apps_domain(clone_id)
    if compact_identity_domains(oc).get("apps_domain") == wanted:
        return True
    crd = env.run(
        f"{oc} get crd ingresses.config.openshift.io -o json",
        check=False)
    if crd.returncode != 0 or not (crd.stdout or "").strip():
        return False
    unlocked = f"{work}/ingresses.config.crd.unlocked.json"
    original = f"{work}/ingresses.config.crd.original.json"
    env.write_file(original, crd.stdout)
    env.write_file(unlocked, compact_strip_ingress_domain_lock(crd.stdout))
    body = compact_identity_domain_patches(clone_id)["ingress"]
    ok = False
    for _ in range(5):
        env.run(f"{oc} replace -f {shlex.quote(unlocked)}", check=False)
        patched = env.run(
            f"{oc} patch ingresses.config.openshift.io cluster --type=merge "
            f"-p {shlex.quote(json.dumps(body))}",
            check=False)
        if patched.returncode == 0:
            ok = True
            break
        time.sleep(2)
    env.run(f"{oc} replace -f {shlex.quote(original)}", check=False)
    return ok or compact_identity_domains(oc).get("apps_domain") == wanted


def _router_cert_subject(oc):
    """Read the default router certificate subject."""
    raw = env.run(
        f"{oc} get secret router-certs-default -n openshift-ingress "
        "-o jsonpath='{.data.tls\\.crt}'",
        check=False)
    if raw.returncode != 0 or not (raw.stdout or "").strip():
        return ""
    subject = env.run(
        "printf '%s' " + shlex.quote((raw.stdout or "").strip()) + " | base64 -d | openssl x509 -noout -subject",
        check=False)
    return (subject.stdout or "").strip()


def _sync_ingress_wildcard(oc, clone_id, work):
    """Point the default router at the clone apps domain and reissue its wildcard.

    IngressController status.domain stays on the source name after spec.domain
    changes, and the router keeps serving that source wildcard.
    """
    host = compact_ingress_wildcard_host(clone_id)
    patch = compact_ingresscontroller_status_patch(clone_id)
    env.run(
        f"{oc} patch ingresscontroller default -n openshift-ingress-operator "
        f"--subresource=status --type=merge -p {shlex.quote(json.dumps(patch))}",
        check=False)
    subject = _router_cert_subject(oc)
    if host in subject:
        return True
    out = f"{work}/router-wildcard"
    env.run(f"mkdir -p {shlex.quote(out)} && chmod 700 {shlex.quote(out)}")
    extracted = env.run(
        f"{oc} extract secret/router-ca -n openshift-ingress-operator "
        f"--to={shlex.quote(out)} --confirm",
        check=False)
    if extracted.returncode != 0:
        _clone_log(work, "router CA is not available yet")
        return False
    env.write_file(f"{out}/san.cnf", textwrap.dedent(f"""\
        basicConstraints=CA:FALSE
        keyUsage=digitalSignature,keyEncipherment
        extendedKeyUsage=serverAuth
        subjectAltName=DNS:{host}
        """))
    signed = env.run(textwrap.dedent(f"""\
        set -euo pipefail
        cd {shlex.quote(out)}
        openssl req -new -newkey rsa:2048 -nodes -keyout leaf.key \\
            -subj {shlex.quote('/CN=' + host)} -out leaf.csr >/dev/null 2>&1
        openssl x509 -req -in leaf.csr -CA tls.crt -CAkey tls.key -CAcreateserial \\
            -out leaf.crt -days 720 -extfile san.cnf >/dev/null 2>&1
        cat leaf.crt tls.crt > full.crt
        openssl verify -CAfile tls.crt leaf.crt >/dev/null
        python3 - << 'PY'
        import base64, json, os, pathlib
        patch = {{"data": {{
            "tls.crt": base64.b64encode(pathlib.Path("full.crt").read_bytes()).decode(),
            "tls.key": base64.b64encode(pathlib.Path("leaf.key").read_bytes()).decode(),
        }}}}
        pathlib.Path("patch.json").write_text(json.dumps(patch))
        os.chmod("patch.json", 0o600)
        PY
        """), check=False)
    if signed.returncode != 0:
        _clone_log(work, "could not sign the clone ingress wildcard")
        env.run(f"rm -rf {shlex.quote(out)}", check=False)
        return False
    patched = env.run(
        f"{oc} patch secret router-certs-default -n openshift-ingress --type=merge "
        f"--patch-file {shlex.quote(out + '/patch.json')}",
        check=False)
    env.run(f"rm -rf {shlex.quote(out)}", check=False)
    if patched.returncode != 0:
        _clone_log(work, "could not install the clone ingress wildcard")
        return False
    _clone_log(work, "installed the clone ingress wildcard")
    return host in _router_cert_subject(oc) or patched.returncode == 0


def format_compact_heal(heal):
    """Describe the heal by role and step count, without addresses or Recert arguments."""
    recert = heal["recert_once"]
    copy = heal["etcd_cert_copy"]
    lines = [
        "Compact heal. Recert runs once. A second Recert run is not part of this plan.",
        f"1. Recert on {recert['name']} only. Continue when stderr contains: {recert['expected_error']}",
        (
            f"2. Copy quorum etcd certificates from {copy['from_role']} to {copy['to_role']}. "
            "Do not copy the Recert etcd CA the other way."
        ),
    ]
    lines.append(f"   {len(copy['paths'])} certificate paths")
    trust = heal["client_trust_copy"]
    lines.append(
        f"3. Copy the quorum client CA, aggregator client certificate, and service-account "
        f"signing keys from {trust['from_role']} to {trust['to_role']}, then start kubelet on "
        f"{trust['to_role']} (Recert stopped it). Do not copy Recert's keys the other way."
    )
    lines.append("4. Sign kubelet client and server certificates with the live CSR signer:")
    for item in heal["kubelet_sign"]:
        lines.append(f"   {item['role']}")
    lines.append(f"5. Rewrite {len(heal['rewrite_files'])} files on every master.")
    lines.append(
        f"6. Rewrite {len(heal['api_objects'])} API objects, plus infrastructure cluster "
        "spec and status, install-config, and the apiserver config."
    )
    lines.append(
        "7. Set DNS spec.baseDomain and ingress spec.domain to the clone "
        f"({heal['base_domain']}, {heal['ingress_domain']})."
    )
    lines.append("8. If chrony-wait blocks kubelet after a reboot: " + shlex.join(heal["chrony_wait_stop"]))
    lines.append(
        "9. Pass when three nodes are Ready, etcd has a leader, every ClusterOperator is green, "
        "every API server accepts the admin certificate and a service-account token, "
        "and ingress spec.domain is the clone apps domain."
    )
    return "\n".join(lines)


def cmd_compact_heal(args):
    """Print a compact heal plan, or refuse to apply it on the source subnet."""
    source = discover_compact_source(args.source, network=args.network)
    source_subnet = int(source["nodes"][0]["ip"].split(".")[2])
    if args.apply and args.subnet == source_subnet:
        sys.exit(
            f"Refusing to heal subnet {source_subnet}. That is the source cluster. "
            "Apply the heal only on a clone subnet after etcd restore."
        )
    macs = [generate_mac() for _ in COMPACT_ROLES]
    nodes = compact_node_plan(args.clone_id, args.subnet, macs)
    heal = compact_heal_plan(
        source, args.clone_id, nodes,
        crypto_dir=f"/tmp/cluster-tool-{args.clone_id}/crypto",
        ingress_cn=args.ingress_cn,
        plan_path=f"/tmp/cluster-tool-{args.clone_id}/recert-plan",
        signer_dir=f"/tmp/cluster-tool-{args.clone_id}/csr-signer",
    )
    print(format_compact_heal(heal))
    if not args.apply:
        print("\nDry run. No Recert, no certificates, and no files were changed.")
        return
    sys.exit("Run 'cluster-tool compact-clone' to create the VMs and apply this heal.")


def _safe_clone_id(clone_id):
    """Accept a lowercase DNS label of at most 31 characters."""
    if not re.fullmatch(r"[a-z0-9](?:[a-z0-9-]{0,29}[a-z0-9])?", clone_id or ""):
        sys.exit("clone id must be lowercase letters, numbers, and inner dashes")
    return clone_id


def compact_reserved_subnets(state):
    """Return subnets already claimed by a flavor or a clone."""
    reserved = set()
    for flavor in state.get("flavors", {}).values():
        for key in ("source_primary_subnet", "source_secondary_subnet"):
            if flavor.get(key) is not None:
                reserved.add(flavor[key])
    for clone in state.get("clones", {}).values():
        for key in ("subnet_primary", "subnet_secondary"):
            if clone.get(key) is not None:
                reserved.add(clone[key])
    return reserved


def require_compact_subnet(state, subnet):
    """Reject a subnet outside 1-254 or already reserved."""
    if isinstance(subnet, bool) or not isinstance(subnet, int) or not 1 <= subnet <= 254:
        sys.exit("subnet must be an integer from 1 to 254")
    if subnet in compact_reserved_subnets(state):
        sys.exit(f"subnet {subnet} is already reserved by a flavor or clone")
    return subnet


def compact_libvirt_conflicts(clone_id):
    """Return compact domain or network names already defined in libvirt."""
    domains = {f"test-infra-cluster-{clone_id}-{role}" for role in COMPACT_ROLES}
    networks = {f"test-infra-net-{clone_id}"}
    domain_list = env.run("virsh list --all --name", check=False)
    if domain_list.returncode != 0:
        sys.exit("Could not check libvirt domains before reserving the compact clone")
    network_list = env.run("virsh net-list --all --name", check=False)
    if network_list.returncode != 0:
        sys.exit("Could not check libvirt networks before reserving the compact clone")
    found = domains.intersection(line.strip() for line in domain_list.stdout.splitlines())
    found.update(networks.intersection(line.strip() for line in network_list.stdout.splitlines()))
    return sorted(found)


def require_compact_libvirt_names_free(clone_id):
    """Fail before disk work if any compact libvirt name is already in use."""
    conflicts = compact_libvirt_conflicts(clone_id)
    if conflicts:
        sys.exit(
            "Compact clone libvirt names are already in use: "
            + ", ".join(conflicts)
            + ". Choose a different clone ID; no resources were changed.")


def record_compact_clone(clone_id, subnet, flavor):
    """Reserve a compact clone in state before its disks are copied."""
    with locked_state() as state:
        if clone_id in state["clones"]:
            sys.exit(f"Clone '{clone_id}' already exists.")
        require_compact_libvirt_names_free(clone_id)
        if subnet is None:
            subnet = allocate_subnet(state)
        require_compact_subnet(state, subnet)
        state["clones"][clone_id] = {
            "flavor": flavor,
            "topology": "compact",
            "subnet_primary": subnet,
            "subnet_secondary": subnet,
            "status": "booting",
            "created_at": datetime.now(timezone.utc).isoformat(),
        }
    return subnet


def mark_compact_clone_running(clone_id):
    """Record that the compact clone passed its install-readiness gate."""
    with locked_state() as state:
        clone = state.get("clones", {}).get(clone_id)
        if clone is None:
            sys.exit(f"Compact clone '{clone_id}' disappeared from state before readiness was recorded.")
        clone["status"] = "running"


def compact_bridge_name(clone_id):
    """Return a unique bridge name that stays within the 15-character limit."""
    return "br-" + hashlib.sha256(clone_id.encode()).hexdigest()[:8]


def compact_role_disk_dest(clone_id, role, index):
    """Return the clone path for one disk of a compact master."""
    if index == 0:
        suffix = ""
    elif index == 1:
        suffix = "-spare"
    else:
        suffix = f"-disk{index}"
    return f"/var/lib/libvirt/images/{clone_id}/{role}{suffix}.qcow2"


def compact_flavor_node_disks(disk_names):
    """Pair flavor disk files with the three masters.

    A three-disk flavor is one OS disk per master, in list order.
    A six-disk flavor pairs disk-N.qcow2 with disk-N-spare.qcow2.
    Returns (role, os name, spare name or None).
    """
    names = list(disk_names or [])
    if len(names) == len(COMPACT_ROLES):
        return [(role, name, None) for role, name in zip(COMPACT_ROLES, names)]
    wanted = []
    for index, role in enumerate(COMPACT_ROLES):
        wanted.append((role, f"disk-{index}.qcow2", f"disk-{index}-spare.qcow2"))
    expected = [name for _, os_name, spare_name in wanted for name in (os_name, spare_name)]
    if sorted(names) != sorted(expected):
        sys.exit(
            "A compact flavor needs 3 disks, or these 6: " + ", ".join(expected))
    return wanted


def compact_clone_disks(clone_id, source_nodes):
    """Pair each source disk with its compact clone destination."""
    _safe_clone_id(clone_id)
    by_role = {_compact_node_name(node): node for node in source_nodes}
    disks = []
    for role in COMPACT_ROLES:
        sources = by_role[role]["disks"]
        if not sources:
            sys.exit(f"Source node {role} has no disks")
        for index, src in enumerate(sources):
            path = src["path"] if isinstance(src, dict) else src
            disks.append({
                "role": role,
                "source": path,
                "dest": compact_role_disk_dest(clone_id, role, index),
            })
    return disks


def compact_copy_commands(disks):
    """Build the commands that copy compact disks into the work directory."""
    dest_dir = os.path.dirname(disks[0]["dest"])
    commands = [f"mkdir -p {shlex.quote(dest_dir)}"]
    for disk in disks:
        dest = shlex.quote(disk["dest"])
        commands.append(f"cp --reflink=always {shlex.quote(disk['source'])} {dest}")
        commands.append(f"chown qemu:qemu {dest}")
        commands.append(f"restorecon {dest} || true")
    return commands


def compact_dns_bases_from_text(text):
    """Extract cluster DNS base domains from guest text."""
    bases = set(re.findall(r"test-infra-cluster-[A-Za-z0-9-]+\.redhat\.com", text or ""))
    host = re.search(r"KUBERNETES_SERVICE_HOST=['\"]?([^'\"\s]+)", text or "")
    if host:
        name = host.group(1)
        for prefix in ("api-int.", "api."):
            if name.startswith(prefix):
                bases.add(name[len(prefix):])
    return sorted(bases, key=len, reverse=True)


def parse_nm_mac(text):
    """Read a MAC address from NetworkManager keyfile text."""
    match = re.search(r"(?im)^mac-address=([0-9a-f:]{17})\s*$", text or "")
    if not match:
        return ""
    return match.group(1).lower()


def extract_k8s_secret_pems(data, secret_name):
    """Extract PEM blocks for one secret from an etcd database dump."""
    marker = f"/kubernetes.io/secrets/openshift-etcd/{secret_name}".encode()
    start = data.find(marker)
    if start < 0:
        return []
    nxt = data.find(b"/kubernetes.io/secrets/", start + len(marker))
    window = data[start:nxt if nxt > 0 else start + 20000]
    return re.findall(
        rb"-----BEGIN [A-Z0-9 ]+-----.*?-----END [A-Z0-9 ]+-----",
        window, flags=re.S)


def compact_etcd_member_ips(manifest):
    """Read the three etcd member addresses from a static pod manifest."""
    found = {}
    for name, ip in re.findall(
            r'"name"\s*:\s*"NODE_(master_0_[012])_IP"\s*,\s*"value"\s*:\s*"(\d+\.\d+\.\d+\.\d+)"',
            manifest or ""):
        found[name.replace("_", "-")] = ip
    if set(found) != set(COMPACT_ROLES):
        sys.exit("Could not read the three etcd member IPs from the flavor disk")
    return found


def compact_vips_from_nodeip_service(unit):
    """Read the source API and ingress VIPs from the guest node-IP service."""
    # The systemd unit uses shell line continuations, while newer variants may
    # pass these as explicit flags. Normalize continuations before inspecting it.
    unit = re.sub(r"\\[ \t]*\n", " ", unit or "")
    found = {}
    for key, option in (("api_vip", "--api-vips"), ("ingress_vip", "--ingress-vips")):
        matches = re.findall(
            rf"(?<!\S){re.escape(option)}(?:=|\s+)(?:\"([^\"]+)\"|'([^']+)'|([^\s]+))",
            unit,
        )
        values = [next(value for value in match if value) for match in matches]
        if len(values) == 1:
            found[key] = values[0]
        elif values:
            sys.exit(f"Could not read one {option} address from the flavor nodeip-configuration.service")

    if not found:
        # Current RHCOS units invoke `node-ip set` with API and ingress VIPs as
        # its two positional addresses after the flags.
        command = re.search(r"\bnode-ip\s+set\b(.*?);", unit, flags=re.S)
        if not command:
            sys.exit("Could not find the node-ip set command in the flavor nodeip-configuration.service")
        addresses = re.findall(
            r"(?<![A-Za-z0-9_.])(?:\d{1,3}\.){3}\d{1,3}(?![A-Za-z0-9_.])",
            command.group(1),
        )
        if len(addresses) != 2:
            sys.exit(
                "Could not read the API and ingress VIPs from the flavor nodeip-configuration.service"
            )
        found = dict(zip(("api_vip", "ingress_vip"), addresses))

    for key, value in found.items():
        try:
            address = ipaddress.ip_address(value)
        except ValueError:
            sys.exit(f"Invalid {key.replace('_', ' ')} in the flavor nodeip-configuration.service: {value}")
        if address.version != 4:
            sys.exit(f"Expected an IPv4 {key.replace('_', ' ')} in the flavor nodeip-configuration.service")
        found[key] = str(address)
    if set(found) != {"api_vip", "ingress_vip"}:
        sys.exit("Could not read both VIP addresses from the flavor nodeip-configuration.service")
    return found["api_vip"], found["ingress_vip"]


def compact_source_from_layout(flavor, macs, dns_bases, disk_paths, node_ips=None,
                               api_vip=None, ingress_vip=None):
    """Build a compact source record from flavor metadata and disk paths."""
    if len(macs) != len(COMPACT_ROLES) or len(disk_paths) != len(COMPACT_ROLES):
        sys.exit("A compact flavor needs three masters and three MAC addresses")
    subnet = int(flavor["source_primary_subnet"])
    api = api_vip or f"192.168.{subnet}.{COMPACT_API_SUFFIX}"
    ingress = ingress_vip or f"192.168.{subnet}.{COMPACT_INGRESS_SUFFIX}"
    # Some source clusters assign the API and ingress VIPs at addresses that
    # differ from the compact network's standard .5/.10 DNS addresses. Rewrite
    # both the configured VIPs and those standard addresses in guest files.
    api_vips = list(dict.fromkeys((api, f"192.168.{subnet}.{COMPACT_API_SUFFIX}")))
    ingress_vips = list(dict.fromkeys((ingress, f"192.168.{subnet}.{COMPACT_INGRESS_SUFFIX}")))
    nodes = []
    for role, suffix, mac, paths in zip(COMPACT_ROLES, COMPACT_NODE_SUFFIXES, macs, disk_paths):
        if isinstance(paths, str):
            paths = [paths]
        else:
            paths = list(paths)
        if not paths:
            sys.exit(f"Source node {role} has no disks")
        ip = (node_ips or {}).get(role) or f"192.168.{subnet}.{suffix}"
        nodes.append({
            "role": role,
            "hostname": role,
            "mac": mac.lower(),
            "ip": ip,
            "disks": [{"path": path} for path in paths],
        })
    dns = []
    for base in dns_bases:
        dns.append({"name": f"api-int.{base}", "ip": api})
        dns.append({"name": f"api.{base}", "ip": api})
        dns.append({"name": f"apps.{base}", "ip": ingress})
    return {
        "topology": "compact",
        "source": flavor.get("source_cluster") or "flavor",
        "network": "flavor",
        "gateway": f"192.168.{subnet}.1",
        "machine_network": f"192.168.{subnet}.0/24",
        "api_vip": api,
        "ingress_vip": ingress,
        "api_vips": api_vips,
        "ingress_vips": ingress_vips,
        "memory_kib": flavor["memory_kib"],
        "vcpus": flavor["vcpus"],
        "etcd_image": flavor["etcd_image"],
        "nodes": nodes,
        "dns": dns,
    }


def compact_etcd_reissue_script(nodes, signer_dir, out_dir):
    """Build the script that reissues etcd certificates for clone addresses."""
    lines = [
        "set -euo pipefail",
        f"mkdir -p {shlex.quote(out_dir)}",
        "san_for() {",
        "  ip=\"$1\"",
        "  cat << EOF",
        "basicConstraints=critical,CA:FALSE",
        "keyUsage=critical,digitalSignature,keyEncipherment",
        "extendedKeyUsage=clientAuth,serverAuth",
        "subjectAltName=DNS:etcd.kube-system.svc,DNS:etcd.kube-system.svc.cluster.local,DNS:etcd.openshift-etcd.svc,DNS:etcd.openshift-etcd.svc.cluster.local,DNS:localhost,DNS:127.0.0.1,DNS:${ip},IP:127.0.0.1,IP:${ip}",
        "authorityKeyIdentifier=keyid",
        "EOF",
        "}",
    ]
    for node in nodes:
        role = node["role"]
        ip = node["ip"]
        for kind, signer in (
            ("peer", "etcd-signer"),
            ("serving", "etcd-signer"),
            ("serving-metrics", "etcd-metric-signer"),
        ):
            stem = f"{out_dir}/etcd-{kind}-{role}"
            lines.append(f"openssl genrsa -out {shlex.quote(stem + '.key')} 2048")
            lines.append(
                f"openssl req -new -key {shlex.quote(stem + '.key')} -subj /CN=127.0.0.1 "
                f"-out {shlex.quote(stem + '.csr')}")
            lines.append(f"san_for {shlex.quote(ip)} > {shlex.quote(stem + '.ext')}")
            lines.append(
                f"openssl x509 -req -in {shlex.quote(stem + '.csr')} "
                f"-CA {shlex.quote(signer_dir + '/' + signer + '.crt')} "
                f"-CAkey {shlex.quote(signer_dir + '/' + signer + '.key')} -CAcreateserial "
                f"-out {shlex.quote(stem + '.crt')} -days 720 -extfile {shlex.quote(stem + '.ext')}")
    return "\n".join(lines) + "\n"


def compact_etcd_cert_names(nodes):
    """Return the etcd certificate stems reissued for each compact node."""
    names = []
    for node in nodes:
        for kind in ("peer", "serving", "serving-metrics"):
            names.append(f"etcd-{kind}-{node['role']}")
    return names


def _decode_secret_value(value):
    """Decode one Secret data value, or return an empty string when it is not PEM text."""
    try:
        return base64.b64decode(value).decode()
    except (ValueError, UnicodeError):
        return ""


def compact_etcd_secret_delta(secret_raw, pems):
    """Return bundle keys that are absent or still differ from the generated PEMs."""
    current = (json.loads(secret_raw).get("data") or {})
    absent = []
    changed = []
    for key, pem in pems.items():
        if not pem:
            continue
        if key not in current:
            absent.append(key)
            continue
        if _decode_secret_value(current[key]) != pem:
            changed.append(key)
    return {"absent": absent, "changed": changed}


def compact_etcd_force_redeploy_patch(reason):
    """Ask the etcd operator to replace static pods one member at a time."""
    return {"spec": {"forceRedeploymentReason": reason}}


COMPACT_MASTER_LEASE_PREFIX = "/kubernetes.io/masterleases/"
COMPACT_MCO_CONTROLLER_LEASE = (
    "openshift-machine-config-operator", "machine-config-controller")
COMPACT_LEASE_EXPIRY_GRACE_SECONDS = 30


def compact_lease_is_expired(lease_raw, now=None):
    """Whether a Kubernetes Lease is safely past its recorded expiry."""
    try:
        lease = json.loads(lease_raw) if isinstance(lease_raw, str) else lease_raw
        spec = lease.get("spec") or {}
        renew_time = spec.get("renewTime")
        holder = spec.get("holderIdentity")
        duration = spec.get("leaseDurationSeconds")
        if not renew_time or not holder or isinstance(duration, bool):
            return False
        duration = int(duration)
        if duration <= 0:
            return False
        if renew_time.endswith("Z"):
            renew_time = renew_time[:-1] + "+00:00"
        renewed_at = datetime.fromisoformat(renew_time)
        current_time = now if now is not None else datetime.now(timezone.utc)
        if renewed_at.tzinfo is None or current_time.tzinfo is None:
            return False
        expiry = renewed_at + timedelta(
            seconds=duration + COMPACT_LEASE_EXPIRY_GRACE_SECONDS)
        return expiry < current_time
    except (AttributeError, TypeError, ValueError, OverflowError, json.JSONDecodeError):
        return False


def compact_lease_delete_preconditions(lease_raw):
    """Return UID and resourceVersion preconditions for a Kubernetes Lease."""
    try:
        lease = json.loads(lease_raw) if isinstance(lease_raw, str) else lease_raw
        metadata = lease.get("metadata") or {}
        uid = metadata.get("uid")
        resource_version = metadata.get("resourceVersion")
        if not uid or not resource_version:
            return None
        return {"uid": str(uid), "resourceVersion": str(resource_version)}
    except (AttributeError, TypeError, ValueError, json.JSONDecodeError):
        return None


def compact_kubernetes_delete_proxy_script(clone_oc, resource_path, preconditions):
    """Delete one API object through oc proxy with Kubernetes DeleteOptions."""
    if not resource_path.startswith(("/api/v1/", "/apis/coordination.k8s.io/v1/")):
        raise ValueError("Kubernetes delete path must use a supported v1 API")
    if not isinstance(preconditions, dict) or not preconditions.get("uid"):
        raise ValueError("Kubernetes delete requires an observed UID precondition")
    if any(key not in ("uid", "resourceVersion") for key in preconditions):
        raise ValueError("Unsupported Kubernetes delete precondition")
    options = json.dumps({
        "apiVersion": "v1",
        "kind": "DeleteOptions",
        "preconditions": preconditions,
    }, separators=(",", ":"))
    script = textwrap.dedent("""\
        set -euo pipefail
        proxy_log=$(mktemp)
        response=$(mktemp)
        proxy_pid=
        cleanup() {
          if [ -n "$proxy_pid" ]; then
            kill "$proxy_pid" >/dev/null 2>&1 || true
            wait "$proxy_pid" >/dev/null 2>&1 || true
          fi
          rm -f "$proxy_log" "$response"
        }
        trap cleanup EXIT

        __CLONE_OC__ proxy --address=127.0.0.1 --port=0 >"$proxy_log" 2>&1 &
        proxy_pid=$!
        port=
        ready=0
        attempt=0
        while [ "$attempt" -lt 40 ]; do
          attempt=$((attempt + 1))
          port=$(grep -oE '127[.]0[.]0[.]1:[0-9]+' "$proxy_log" | head -n 1 | cut -d: -f2 || true)
          if [ -n "$port" ] && curl --silent --show-error --fail \\
              --connect-timeout 1 --max-time 2 "http://127.0.0.1:$port/version" >/dev/null; then
            ready=1
            break
          fi
          if ! kill -0 "$proxy_pid" 2>/dev/null; then
            break
          fi
          sleep 0.25
        done
        if [ "$ready" -ne 1 ]; then
          echo "oc proxy did not become ready for conditional API deletion"
          cat "$proxy_log"
          exit 1
        fi

        status=$(curl --silent --show-error --output "$response" \\
          --write-out "%{http_code}" --connect-timeout 2 --max-time 10 \\
          --request DELETE --header 'Content-Type: application/json' \\
          --data-binary __DELETE_OPTIONS__ \\
          "http://127.0.0.1:$port__RESOURCE_PATH__" || true)
        printf 'KUBE_DELETE_HTTP_STATUS=%s\\n' "$status"
        cat "$response"
        case "$status" in
          200|202|404) exit 0 ;;
          409) exit 3 ;;
          *) exit 1 ;;
        esac
        """)
    return (script
            .replace("__CLONE_OC__", clone_oc)
            .replace("__DELETE_OPTIONS__", shlex.quote(options))
            .replace("__RESOURCE_PATH__", resource_path))


def _clear_expired_mco_controller_lease(clone_oc, work):
    """Drop only an expired MCO leader Lease restored from the source snapshot."""
    namespace, name = COMPACT_MCO_CONTROLLER_LEASE
    get_command = (
        f"{clone_oc} get lease {shlex.quote(name)} "
        f"-n {shlex.quote(namespace)} -o json")
    max_attempts = 3
    for attempt in range(max_attempts):
        lease = env.run(get_command, check=False)
        if lease.returncode != 0:
            if "not found" in (lease.stderr or "").lower():
                _clone_log(work, "MCO controller lease is already absent")
            else:
                _clone_log(work, "could not read the MCO controller lease; leaving it unchanged")
            return
        if not compact_lease_is_expired(lease.stdout):
            _clone_log(
                work,
                "MCO controller lease is not demonstrably expired; leaving it unchanged")
            return

        preconditions = compact_lease_delete_preconditions(lease.stdout)
        if preconditions is None:
            _clone_log(
                work,
                "MCO controller lease lacks UID/resourceVersion; leaving it unchanged")
            return
        observed_uid = preconditions["uid"]
        observed_version = preconditions["resourceVersion"]
        _clone_log(work, "conditionally removing expired MCO controller lease")
        resource_path = (
            f"/apis/coordination.k8s.io/v1/namespaces/{urllib.parse.quote(namespace, safe='')}"
            f"/leases/{urllib.parse.quote(name, safe='')}"
        )
        delete_script = compact_kubernetes_delete_proxy_script(
            clone_oc, resource_path, preconditions)
        deleted = env.run(delete_script, check=False)

        verified = env.run(get_command, check=False)
        if verified.returncode != 0:
            if "not found" in (verified.stderr or "").lower():
                _clone_log(work, "verified removal of the expired MCO controller lease")
            elif deleted.returncode == 0:
                _clone_log(work, "MCO lease delete returned success; read-back was unavailable")
            else:
                _clone_log(work, "conditional MCO lease delete could not be verified; leaving it unchanged")
            return

        current_preconditions = compact_lease_delete_preconditions(verified.stdout)
        if current_preconditions is None:
            _clone_log(work, "MCO lease read-back lacks UID/resourceVersion; leaving it unchanged")
            return
        if current_preconditions["uid"] != observed_uid:
            _clone_log(work, "MCO controller lease was replaced during cleanup; preserving replacement")
            return
        if not compact_lease_is_expired(verified.stdout):
            _clone_log(work, "MCO controller lease was renewed during cleanup; preserving it")
            return

        current_version = current_preconditions["resourceVersion"]
        if current_version == observed_version:
            if deleted.returncode == 0:
                _clone_log(work, "expired MCO controller lease remains after conditional delete")
            else:
                _clone_log(work, "could not remove expired MCO lease; normal leader election will continue")
            return

        # A conflict can be retried only after re-reading the same Lease and
        # proving it is still expired. A new UID or renewal is preserved above.
        _clone_log(work, "MCO lease changed during conditional delete; re-evaluating expiry")

    _clone_log(work, "expired MCO lease kept changing; leaving it unchanged")


def compact_stale_master_lease_keys(keys_output, node_ips):
    """Return API-server lease keys that do not belong to this compact clone."""
    clone_ips = {ipaddress.ip_address(ip) for ip in node_ips}
    stale = set()
    for line in (keys_output or "").splitlines():
        key = line.strip()
        if not key:
            continue
        if not key.startswith(COMPACT_MASTER_LEASE_PREFIX):
            continue
        value = key[len(COMPACT_MASTER_LEASE_PREFIX):]
        try:
            lease_ip = ipaddress.ip_address(value)
        except ValueError as exc:
            raise ValueError(f"Invalid API-server master lease key: {key}") from exc
        if not isinstance(lease_ip, ipaddress.IPv4Address):
            raise ValueError(f"Invalid API-server master lease key: {key}")
        if lease_ip not in clone_ips:
            stale.add(key)
    return sorted(stale)


def compact_master_lease_etcd_command(etcd_image, nodes, action, key=None):
    """Build an etcdctl command for reading or deleting compact API-server leases."""
    if action not in ("list", "delete"):
        raise ValueError(f"Unsupported master lease action: {action}")
    if action == "delete" and (
            not key or not key.startswith(COMPACT_MASTER_LEASE_PREFIX)):
        raise ValueError("A full API-server master lease key is required for deletion")
    endpoints = ",".join(f"https://{node['ip']}:2379" for node in nodes)
    peer = QUORUM_ETCD_ROLE
    parts = [
        "sudo podman run --rm --network host --privileged",
        "--authfile /var/lib/kubelet/config.json",
        "-v /etc/kubernetes/static-pod-resources/etcd-certs:/certs:ro",
        "--entrypoint etcdctl", shlex.quote(etcd_image),
        f"--endpoints={shlex.quote(endpoints)}",
        "--cacert /certs/configmaps/etcd-all-bundles/server-ca-bundle.crt",
        f"--cert /certs/secrets/etcd-all-certs/etcd-peer-{peer}.crt",
        f"--key /certs/secrets/etcd-all-certs/etcd-peer-{peer}.key",
    ]
    if action == "list":
        parts.append(f"get --prefix --keys-only {COMPACT_MASTER_LEASE_PREFIX}")
    else:
        parts.append("del " + shlex.quote(key))
    return " ".join(parts)


def _clear_compact_stale_master_leases(nodes, identity, etcd_image, work):
    """Remove source-cluster API leases from the clone's restored etcd state."""
    node_ips = [node["ip"] for node in nodes]
    lease_node = next(
        (node for node in nodes if node["role"] == QUORUM_ETCD_ROLE), nodes[0])
    list_command = compact_master_lease_etcd_command(etcd_image, nodes, "list")
    listed = _vm(lease_node["ip"], list_command, identity, check=False)
    if listed.returncode != 0:
        detail = (listed.stderr or listed.stdout or "etcdctl returned a non-zero status").strip()
        sys.exit(
            "Could not inspect API-server master leases in the clone etcd cluster: "
            f"{detail}. Log: {work}/clone.log")
    try:
        stale = compact_stale_master_lease_keys(listed.stdout, node_ips)
    except ValueError as exc:
        sys.exit(f"Could not safely classify clone API-server master leases: {exc}")

    if not stale:
        _clone_log(work, "clone etcd master leases contain only clone API addresses")
        return

    _clone_log(
        work,
        "removing stale source API-server master leases: " + ", ".join(stale))
    for key in stale:
        deleted = _vm(
            lease_node["ip"],
            compact_master_lease_etcd_command(etcd_image, nodes, "delete", key),
            identity, check=False)
        if deleted.returncode != 0:
            detail = (deleted.stderr or deleted.stdout or "etcdctl returned a non-zero status").strip()
            sys.exit(
                f"Could not remove stale API-server master lease {key}: {detail}. "
                f"Log: {work}/clone.log")

    verified = _vm(lease_node["ip"], list_command, identity, check=False)
    if verified.returncode != 0:
        detail = (verified.stderr or verified.stdout or "etcdctl returned a non-zero status").strip()
        sys.exit(
            "Could not verify API-server master lease cleanup in the clone etcd cluster: "
            f"{detail}. Log: {work}/clone.log")
    try:
        remaining = compact_stale_master_lease_keys(verified.stdout, node_ips)
    except ValueError as exc:
        sys.exit(f"Could not verify clone API-server master leases: {exc}")
    if remaining:
        sys.exit(
            "Stale source API-server master leases remain in clone etcd: "
            + ", ".join(remaining)
            + f". Log: {work}/clone.log")
    _clone_log(work, f"verified removal of {len(stale)} stale API-server master lease(s)")


def compact_etcd_secret_patch(secret_raw, pems):
    """Replace PEM keys that already exist in an etcd secret and differ."""
    doc = json.loads(secret_raw)
    current = doc.get("data") or {}
    data = {}
    for key, pem in pems.items():
        if key not in current or not pem:
            continue
        if _decode_secret_value(current[key]) == pem:
            continue
        data[key] = base64.b64encode(pem.encode()).decode()
    return json.dumps({"data": data})


def compact_install_etcd_certs_script():
    """Copy reissued etcd certificates over every on-disk copy, including pod revisions."""
    return textwrap.dedent("""\
        set -euo pipefail
        sudo find /etc/kubernetes/static-pod-resources \\( -name 'etcd-peer-*' -o -name 'etcd-serving-*' \\) | while read -r existing; do
          base=$(basename "$existing")
          if [ -f "/var/tmp/$base" ]; then
            sudo cp "/var/tmp/$base" "$existing"
          fi
        done
        sudo restorecon -R /etc/kubernetes/static-pod-resources || true
        """)


def compact_proxy_command(etcd_image, peer_ips):
    """Build the etcd grpc-proxy command used during the single Recert run."""
    endpoints = ",".join(f"https://{ip}:2379" for ip in peer_ips)
    return " ".join([
        "sudo podman run -d --name etcd-proxy --network host --privileged",
        "--authfile /var/lib/kubelet/config.json",
        "-v /etc/kubernetes/static-pod-resources/etcd-certs:/certs:ro",
        "--entrypoint etcd", shlex.quote(etcd_image),
        "grpc-proxy start",
        "--listen-addr 127.0.0.1:2379",
        "--advertise-client-url 127.0.0.1:2379",
        "--data-dir /tmp/etcd-proxy",
        "--endpoints", endpoints,
        "--cacert /certs/configmaps/etcd-all-bundles/server-ca-bundle.crt",
        "--cert /certs/secrets/etcd-all-certs/etcd-peer-master-0-0.crt",
        "--key /certs/secrets/etcd-all-certs/etcd-peer-master-0-0.key",
    ])


def compact_recert_podman_command(argv):
    """Build the podman command that runs Recert once on master-0-0."""
    quoted = " ".join(shlex.quote(arg) for arg in argv)
    return " ".join([
        "sudo podman run --rm --name recert --pull=missing --network host --privileged",
        "--authfile /var/lib/kubelet/config.json",
        "-v /etc/kubernetes:/etc/kubernetes",
        "-v /var/lib/kubelet:/var/lib/kubelet",
        "-v /etc/machine-config-daemon:/etc/machine-config-daemon",
        "-v /etc/cni:/etc/cni",
        "-v /var/tmp/recert-crypto:/tmp/crypto:ro",
        "-v /var/tmp/recert-out:/out",
        shlex.quote(RECERT_IMAGE),
        quoted,
    ])


def rewrite_machineconfig(raw, pairs):
    """Rewrite a MachineConfig with compact identity replacements."""
    doc = json.loads(raw)
    config = doc.get("spec", {}).get("config", {})
    files = config.get("storage", {}).get("files", [])
    for item in files:
        source = item.get("contents", {}).get("source", "")
        if "," not in source or not source.startswith("data:"):
            continue
        header, payload = source.split(",", 1)
        encoded_base64 = "base64" in header.lower()
        try:
            if encoded_base64:
                payload += "=" * ((4 - len(payload) % 4) % 4)
                body = base64.b64decode(payload).decode()
            else:
                body = urllib.parse.unquote_to_bytes(payload).decode()
        except (UnicodeDecodeError, ValueError):
            continue
        updated = apply_identity_preserving_pems(body, pairs)
        if updated == body:
            continue
        rewritten_payload = (
            base64.b64encode(updated.encode()).decode()
            if encoded_base64 else urllib.parse.quote(updated, safe="")
        )
        item["contents"]["source"] = header + "," + rewritten_payload
    for unit in config.get("systemd", {}).get("units", []):
        if unit.get("contents"):
            unit["contents"] = apply_identity_preserving_pems(unit["contents"], pairs)
        for dropin in unit.get("dropins") or []:
            if dropin.get("contents"):
                dropin["contents"] = apply_identity_preserving_pems(dropin["contents"], pairs)
    return json.dumps(doc)


def compact_ensure_machineconfig_render_change(
    previous_raw, rewritten_raw, clone_domain, existing_render_raw=None,
):
    """Make one stable 00-master change when the current render lacks clone identity."""
    previous = json.loads(previous_raw)
    rewritten = json.loads(rewritten_raw)
    if previous.get("spec") != rewritten.get("spec"):
        return json.dumps(rewritten)

    if compact_machineconfig_has_clone_api_url(existing_render_raw, clone_domain):
        return json.dumps(rewritten)

    path = "/etc/kubernetes/apiserver-url.env"
    body = rendered_machineconfig_files(rewritten).get(path)
    wanted = f"KUBERNETES_SERVICE_HOST='api-int.{clone_domain}'"
    if not body or wanted not in body.splitlines():
        sys.exit(
            "Cannot retrigger the master render: 00-master does not contain the "
            "clone-specific API URL")

    for item in rewritten.get("spec", {}).get("config", {}).get("storage", {}).get("files") or []:
        if item.get("path") != path:
            continue
        source = (item.get("contents") or {}).get("source") or ""
        if not source.startswith("data:") or "," not in source:
            break
        # Use a fixed representation so a retry cannot alternate between
        # equivalent data URLs and generate another rendered MachineConfig.
        canonical_source = "data:," + urllib.parse.quote(body, safe="")
        if source != canonical_source:
            item["contents"]["source"] = canonical_source
        return json.dumps(rewritten)

    sys.exit(
        "Cannot retrigger the master render: 00-master has no data URL for "
        "/etc/kubernetes/apiserver-url.env")


def rewrite_configmap(raw, pairs):
    """Rewrite a ConfigMap with compact identity replacements."""
    doc = json.loads(raw)
    data = doc.get("data") or {}
    for key, value in list(data.items()):
        if isinstance(value, str):
            data[key] = apply_identity_preserving_pems(value, pairs)
    doc["data"] = data
    return json.dumps(doc)


def rewrite_deployment(raw, pairs):
    """Rewrite a Deployment with compact identity replacements and drop its status."""
    doc = json.loads(apply_identity_preserving_pems(raw, pairs))
    doc.pop("status", None)
    return json.dumps(doc)


